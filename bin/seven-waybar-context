#!/usr/bin/env bash

set -Eeuo pipefail

# ============================================================
# SevenOS Waybar Context
# ============================================================
#
# Projection UI du moteur SevenOS Context.
#
# Architecture:
#
#   core/context
#        ↓
#   seven-waybar-context
#        ↓
#   waybar-context.json
#        ↓
#   Waybar
#
# PRINCIPLE:
#
#   core/context = source of truth
#   seven-waybar-context = projection
#   Waybar = presentation
#
# Contract:
#   sevenos.waybar.context.v3
#
# ============================================================

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

CONTEXT_DIR="$ROOT/core/context"
CONTEXT_ENGINE="$CONTEXT_DIR/context.sh"
CONTEXT_API="$CONTEXT_DIR/sevenos-context"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sevenos"
CONTEXT_FILE="$RUNTIME_DIR/waybar-context.json"
TMP_FILE="$CONTEXT_FILE.tmp"

INTERVAL="${SEVENOS_WAYBAR_CONTEXT_INTERVAL:-2}"

mkdir -p "$RUNTIME_DIR"

# ============================================================
# Logging
# ============================================================

log() {
    printf '[seven-waybar-context] %s\n' "$*" >&2
}

die() {
    log "ERROR: $*"
    exit 1
}

# ============================================================
# Dependencies
# ============================================================

command -v jq >/dev/null 2>&1 ||
    die "jq is required"

command -v hyprctl >/dev/null 2>&1 ||
    die "hyprctl is required"

[[ -x "$CONTEXT_ENGINE" ]] ||
    die "Context engine not found: $CONTEXT_ENGINE"

# ============================================================
# Helpers
# ============================================================

now_iso() {
    date -u '+%Y-%m-%dT%H:%M:%SZ'
}

json_valid() {
    jq -e . >/dev/null 2>&1 <<< "$1"
}

# ============================================================
# Core context
# ============================================================

read_core_context() {

    local output

    if output="$("$CONTEXT_ENGINE" status --json 2>/dev/null)"; then

        if json_valid "$output"; then
            printf '%s\n' "$output"
            return 0
        fi

    fi

    if [[ -x "$CONTEXT_API" ]]; then

        if output="$("$CONTEXT_API" status 2>/dev/null)"; then

            if json_valid "$output"; then
                printf '%s\n' "$output"
                return 0
            fi

        fi

    fi

    return 1
}

# ============================================================
# Hyprland context
# ============================================================

read_hyprland_context() {

    local active
    local workspace_id
    local workspace_name
    local class
    local initial_class
    local title
    local address
    local floating
    local fullscreen

    active="$(hyprctl activewindow -j 2>/dev/null || printf '{}')"

    workspace_id="$(
        jq -r '
            if (.workspace.id? // null) != null
            then .workspace.id
            else null
            end
        ' <<< "$active"
    )"

    workspace_name="$(
        jq -r '
            if (.workspace.name? // null) != null
            then .workspace.name
            else ""
            end
        ' <<< "$active"
    )"

    class="$(
        jq -r '.class // ""' <<< "$active"
    )"

    initial_class="$(
        jq -r '.initialClass // ""' <<< "$active"
    )"

    title="$(
        jq -r '.title // ""' <<< "$active"
    )"

    address="$(
        jq -r '.address // ""' <<< "$active"
    )"

    floating="$(
        jq -r '.floating // false' <<< "$active"
    )"

    fullscreen="$(
        jq -r '.fullscreen // 0' <<< "$active"
    )"

    jq -n \
        --argjson workspace_id "$workspace_id" \
        --arg workspace_name "$workspace_name" \
        --arg class "$class" \
        --arg initial_class "$initial_class" \
        --arg title "$title" \
        --arg address "$address" \
        --argjson floating "$floating" \
        --argjson fullscreen "$fullscreen" \
        '{
            workspace: {
                id: $workspace_id,
                name: $workspace_name
            },
            window: {
                class: $class,
                initial_class: $initial_class,
                title: $title,
                address: $address,
                floating: $floating,
                fullscreen: $fullscreen
            }
        }'
}

# ============================================================
# Safe value helpers
# ============================================================

string_or_empty() {
    local value="$1"

    jq -r '
        if . == null then
            ""
        elif type == "string" then
            .
        else
            tostring
        end
    ' <<< "$value"
}

number_or_null() {
    local value="$1"

    jq -c '
        if . == null then
            null
        elif type == "number" then
            .
        elif type == "string" and test("^[0-9]+$") then
            tonumber
        else
            null
        end
    ' <<< "$value"
}

# ============================================================
# Profile projection
# ============================================================

profile_projection() {

    local source="$1"

    jq -c '
        .profile as $profile |

        {
            key:
                if ($profile | type) == "object"
                then ($profile.key // "unknown")
                elif ($profile | type) == "string"
                then $profile
                else "unknown"
                end,

            title:
                if ($profile | type) == "object"
                then ($profile.title // "SevenOS Profile")
                else "SevenOS Profile"
                end,

            role:
                if ($profile | type) == "object"
                then ($profile.role // "")
                else ""
                end,

            state:
                if ($profile | type) == "object"
                then ($profile.state // "OK")
                else "OK"
                end
        }
    ' <<< "$source"
}

# ============================================================
# Application projection
# ============================================================

application_projection() {

    local source="$1"
    local hypr="$2"

    jq -c '
        .application as $application |
        .window as $window |

        {
            key:
                if ($application | type) == "object"
                then ($application.key // $application.label // "desktop")
                elif ($application | type) == "string"
                then $application
                else "desktop"
                end,

            label:
                if ($application | type) == "object"
                then ($application.label // $application.key // "desktop")
                elif ($application | type) == "string"
                then $application
                else "desktop"
                end,

            class:
                if ($application | type) == "object"
                then ($application.class // "")
                else ($window.class // "")
                end,

            initial_class:
                if ($application | type) == "object"
                then ($application.initial_class // "")
                else ($window.initial_class // "")
                end,

            title:
                if ($application | type) == "object"
                then ($application.title // "")
                else ($window.title // "")
                end
        }
    ' \
    <<< "$(
        jq -n \
            --argjson source "$source" \
            --argjson window "$hypr" \
            '$source + {window: $window}'
    )"
}

# ============================================================
# Activity
# ============================================================

activity_projection() {

    local source="$1"

    jq -c '
        .state.activity as $activity |

        {
            key:
                if ($activity | type) == "object"
                then ($activity.key // "unknown")
                elif ($activity | type) == "string"
                then $activity
                else "unknown"
                end,

            label:
                if ($activity | type) == "object"
                then ($activity.label // $activity.key // "unknown")
                elif ($activity | type) == "string"
                then $activity
                else "unknown"
                end
        }
    ' <<< "$source"
}

# ============================================================
# Focus
# ============================================================

focus_projection() {

    local source="$1"

    jq -c '
        .state.focus as $focus |

        {
            key:
                if ($focus | type) == "object"
                then ($focus.key // "normal")
                elif ($focus | type) == "string"
                then $focus
                else "normal"
                end,

            label:
                if ($focus | type) == "object"
                then ($focus.label // $focus.key // "normal")
                elif ($focus | type) == "string"
                then $focus
                else "normal"
                end
        }
    ' <<< "$source"
}

# ============================================================
# Power
# ============================================================

power_projection() {

    local source="$1"

    jq -c '
        {
            state: (
                .state.power_state
                // .power_state
                // "normal"
            ),

            battery: (
                if (.battery | type) == "number"
                then .battery
                elif (.battery | type) == "string"
                     and (.battery | test("^[0-9]+$"))
                then (.battery | tonumber)
                else null
                end
            )
        }
    ' <<< "$source"
}

# ============================================================
# Network
# ============================================================

network_projection() {

    local source="$1"

    jq -c '
        {
            state: (
                .network
                // .state.connectivity
                // "unknown"
            ),

            vpn: (
                .vpn
                // null
            )
        }
    ' <<< "$source"
}

# ============================================================
# Security
# ============================================================

security_projection() {

    local source="$1"

    jq -c '
        {
            state: (
                .security
                // .state.security_state
                // "unknown"
            ),

            attention: (
                .signals.security_attention
                // false
            )
        }
    ' <<< "$source"
}

# ============================================================
# Workspace
# ============================================================

workspace_projection() {

    local source="$1"
    local hypr="$2"

    jq -c '
        {
            id:
                (
                    .workspace
                    // $hypr.workspace.id
                    // null
                ),

            name:
                (
                    $hypr.workspace.name
                    // (
                        if (.workspace | type) == "string"
                        then .workspace
                        else ""
                        end
                    )
                )
        }
    ' \
    --argjson hypr "$hypr" \
    <<< "$source"
}

# ============================================================
# UI policy
# ============================================================

ui_projection() {

    local source="$1"

    jq -c '
        {
            mode: (
                if .state.activity == "development"
                then "developer"
                elif .state.activity == "creative"
                then "creative"
                elif .state.activity == "gaming"
                then "gaming"
                else "desktop"
                end
            ),

            priority: (
                if .signals.focus_mode == true
                then "focus"
                elif .signals.security_attention == true
                then "security"
                elif .signals.power_saving == true
                then "power"
                else "workflow"
                end
            ),

            visibility: {
                network: true,
                battery: true,
                audio: true,
                security: true
            }
        }
    ' <<< "$source"
}

# ============================================================
# Layout policy
# ============================================================

layout_projection() {

    local source="$1"

    jq -c '
        {
            schema: "sevenos.shell-layout-policy.v1",

            density:
                if .signals.focus_mode == true
                then "compact"
                else "compact"
                end,

            priority:
                if .signals.security_attention == true
                then "security"
                elif .signals.focus_mode == true
                then "focus"
                else "workflow"
                end,

            waybar: {
                left: "app-menu",
                center: "context",
                right: "system-compact"
            },

            dock: {
                behavior: "visible"
            },

            panels: {
                motion: "standard"
            }
        }
    ' <<< "$source"
}

# ============================================================
# Full projection
# ============================================================

build_projection() {

    local source="$1"
    local hypr="$2"

    local profile
    local application
    local activity
    local focus
    local power
    local network
    local security
    local workspace
    local layout
    local ui

    profile="$(profile_projection "$source")"
    application="$(application_projection "$source" "$hypr")"
    activity="$(activity_projection "$source")"
    focus="$(focus_projection "$source")"
    power="$(power_projection "$source")"
    network="$(network_projection "$source")"
    security="$(security_projection "$source")"
    workspace="$(workspace_projection "$source" "$hypr")"
    layout="$(layout_projection "$source")"
    ui="$(ui_projection "$source")"

    jq -n \
        --arg generated_at "$(now_iso)" \
        --argjson profile "$profile" \
        --argjson application "$application" \
        --argjson activity "$activity" \
        --argjson focus "$focus" \
        --argjson power "$power" \
        --argjson network "$network" \
        --argjson security "$security" \
        --argjson workspace "$workspace" \
        --argjson layout "$layout" \
        --argjson ui "$ui" \
        --argjson source "$source" \
        '{
            schema: "sevenos.waybar.context.v3",
            generated_at: $generated_at,

            profile: $profile,
            application: $application,
            activity: $activity,
            focus: $focus,

            power: $power,
            network: $network,
            security: $security,
            workspace: $workspace,

            layout: $layout,
            ui: $ui,

            signals: (
                $source.signals // {}
            ),

            source: {
                schema: ($source.schema // "sevenos.context.v1")
            }
        }'
}

# ============================================================
# Atomic write
# ============================================================

write_context() {

    local projection="$1"

    printf '%s\n' "$projection" |
        jq '.' > "$TMP_FILE"

    mv -f "$TMP_FILE" "$CONTEXT_FILE"
}

# ============================================================
# One cycle
# ============================================================

run_once() {

    local source
    local hypr
    local projection

    source="$(read_core_context)" ||
        die "Unable to read SevenOS Context"

    hypr="$(read_hyprland_context)"

    projection="$(build_projection "$source" "$hypr")"

    write_context "$projection"

    printf '%s\n' "$projection"
}

# ============================================================
# Status
# ============================================================

status() {

    if [[ ! -f "$CONTEXT_FILE" ]]; then
        jq -n '
            {
                schema: "sevenos.waybar.context.status.v3",
                state: "WARN",
                instances: 0,
                context_file: "'"$CONTEXT_FILE"'",
                context_fresh: false
            }
        '
        return
    fi

    local age
    local context

    context="$(cat "$CONTEXT_FILE")"

    age="$(
        jq -r '.generated_at' "$CONTEXT_FILE" |
            xargs -I{} date -d "{}" +%s 2>/dev/null |
            awk -v now="$(date +%s)" '{print now - $1}'
    )"

    age="${age:-999999}"

    jq -n \
        --argjson context "$context" \
        --argjson age "$age" \
        '{
            schema: "sevenos.waybar.context.status.v3",
            state: (
                if $age <= 5 then "OK"
                elif $age <= 15 then "WARN"
                else "STALE"
                end
            ),
            instances: 1,
            context_file: "'"$CONTEXT_FILE"'",
            context_fresh: ($age <= 5),
            context_age_seconds: $age,
            context: $context
        }'
}

# ============================================================
# Waybar module
# ============================================================
#
# Waybar reads only the projection written by this process.  It must not call
# core/context itself: that would create a second, potentially inconsistent
# context snapshot for the same frame.

module() {
    if [[ ! -s "$CONTEXT_FILE" ]]; then
        jq -n '{text: "󰒓 Contexte indisponible", tooltip: "SevenOS Context\nLa projection est indisponible.", class: ["context", "unavailable"]}'
        return 0
    fi

    jq -c '
        def value_label($value; $fallback):
            if ($value | type) == "string" and $value != "" then $value else $fallback end;
        def activity_icon:
            {development:"󰨞", creative:"󰏘", writing:"󰈙", media:"󰎆", gaming:"󰊗"}[.] // "󰋜";
        def focus_icon:
            {focused:"󰌨", relaxed:"󰒲", creative:"󰏘"}[.] // "󰍹";

        . as $context |
        ($context.activity.key | value_label(.; "general")) as $activity |
        ($context.focus.key | value_label(.; "normal")) as $focus |
        ($context.application.label | value_label(.; "Bureau")) as $application |
        ($context.profile.title | value_label(.; "SevenOS")) as $profile |
        ($context.workspace.name | value_label(.; "—")) as $workspace |
        ($context.network.state | value_label(.; "unknown")) as $network |
        ($context.security.state | value_label(.; "unknown")) as $security |
        {
            text: "\($activity | activity_icon) \($activity) · \($focus | focus_icon) \($focus)",
            tooltip: (
                "SevenOS Context\n"
                + "───────────────\n"
                + "Profil       : \($profile)\n"
                + "Application  : \($application)\n"
                + "Espace       : \($workspace)\n"
                + "Activité     : \($activity)\n"
                + "Focus        : \($focus)\n"
                + "Réseau       : \($network)\n"
                + "Sécurité     : \($security)"
            ),
            class: ["context", "activity-\($activity)", "focus-\($focus)", "security-\($security)"]
        }
    ' "$CONTEXT_FILE"
}

security_module() {
    if [[ ! -s "$CONTEXT_FILE" ]]; then
        jq -n '{text: "", tooltip: "Sécurité SevenOS indisponible", class: ["security", "hidden"]}'
        return 0
    fi

    jq -c '
        if .signals.security_attention == true then
            {
                text: "󰒃",
                tooltip: "Sécurité SevenOS\nUne information demande votre attention.",
                class: ["security", "attention"]
            }
        else
            {
                text: "",
                tooltip: "Sécurité SevenOS · état normal",
                class: ["security", "hidden"]
            }
        end
    ' "$CONTEXT_FILE"
}

# ============================================================
# Daemon
# ============================================================

run_daemon() {

    local running=true

    cleanup() {
        running=false
    }

    trap cleanup INT TERM EXIT

    log "Starting projection daemon"
    log "Interval: ${INTERVAL}s"
    log "Context: $CONTEXT_FILE"

    while [[ "$running" == "true" ]]; do

        if ! run_once >/dev/null; then
            log "Projection cycle failed"
        fi

        local elapsed=0

        while [[ "$running" == "true" && "$elapsed" -lt "$INTERVAL" ]]; do
            sleep 1 || true
            elapsed=$((elapsed + 1))
        done

    done

    trap - INT TERM EXIT

    log "Projection daemon stopped"
}

# ============================================================
# CLI
# ============================================================

case "${1:-once}" in

    once)
        run_once
        ;;

    daemon)
        run_daemon
        ;;

    status)
        status
        ;;

    doctor)
        # `status` already checks freshness and the projection contract.
        status
        ;;

    module)
        module
        ;;

    security)
        security_module
        ;;

    *)
        cat <<'USAGE'

SevenOS Waybar Context

Usage:
    seven-waybar-context once
    seven-waybar-context daemon
    seven-waybar-context status
    seven-waybar-context doctor
    seven-waybar-context module
    seven-waybar-context security

Environment:
    SEVENOS_WAYBAR_CONTEXT_INTERVAL=2

Contract:
    sevenos.waybar.context.v3

USAGE
        exit 1
        ;;

esac
