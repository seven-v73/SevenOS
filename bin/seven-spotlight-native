def normalize(value: str) -> str:
    normalized = unicodedata.normalize("NFKD", value or "")
    return "".join(char for char in normalized if not unicodedata.combining(char)).casefold()


def read_json(path: Path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return default


def read_profile_ui() -> dict:
    data = read_json(PROFILE_UI_FILE, {})
    if not isinstance(data, dict):
        return {}
    return data


def profile_items(profile_ui: dict) -> list[Item]:
    if not profile_ui:
        return []
    key = str(profile_ui.get("profile") or "equinox")
    title = str(profile_ui.get("title") or key.title())
    home = profile_ui.get("home_screen") if isinstance(profile_ui.get("home_screen"), dict) else {}
    items = [
        Item("profile", f"{title} · Home", f"profile.home.{key}", str(profile_ui.get("center_command") or f"seven profile center {key}"), str(home.get("focus") or profile_ui.get("purpose") or "Open the active mini OS home."), "preferences-system-symbolic"),
        Item("profile", f"{title} · Workspace", f"profile.workspace.{key}", str(profile_ui.get("workspace_command") or f"seven profile open {key}"), str(home.get("library") or "Open the mini OS workspace."), "folder-symbolic"),
        Item("profile", f"{title} · Runtime", f"profile.runtime.{key}", str(profile_ui.get("runtime_command") or f"seven runtime plan {key}"), "Show layers, resources, services and composition for this mini OS.", "utilities-system-monitor-symbolic"),
    ]
    for action in home.get("actions", []) if isinstance(home.get("actions"), list) else []:
        if not isinstance(action, dict):
            continue
        label = str(action.get("label") or "").strip()
        command = str(action.get("command") or "").strip()
        if label and command:
            items.append(Item("profile", f"{title} · {label}", f"profile.action.{key}.{normalize(label)}", command, str(action.get("description") or "Mini OS action"), "system-run-symbolic"))
    return items


def write_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")


def current_theme_mode() -> str:
    try:
        for raw in THEME_CONF.read_text(encoding="utf-8", errors="replace").splitlines():
            if "=" not in raw or raw.strip().startswith("#"):
                continue
            key, value = [part.strip().lower() for part in raw.split("=", 1)]
            if key in {"mode", "theme_mode", "sevenos_theme_mode"} and value in {"dark", "light"}:
                return value
    except OSError:
        pass
    env_mode = os.environ.get("SEVENOS_THEME_MODE", "").strip().lower()
    if env_mode in {"dark", "light"}:
        return env_mode
    return "dark"


def icon_theme_name(mode: str) -> str:
    settings = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "gtk-3.0/settings.ini"
    try:
        for raw in settings.read_text(encoding="utf-8", errors="replace").splitlines():
            if raw.strip().startswith("gtk-icon-theme-name="):
                value = raw.split("=", 1)[1].strip()
                if value:
                    return value
    except OSError:
        pass
    return "Papirus-Dark" if mode == "dark" else "Papirus"


def rows_to_items(rows) -> list[Item]:
    return [Item(*row[:6]) for row in rows if isinstance(row, list) and len(row) >= 6]


def read_cached_catalog(*, max_age: float | None = CACHE_TTL_SECONDS) -> list[Item]:
    cached = read_json(CACHE_FILE, {})
    now = time.time()
    if (
        cached.get("schema") == "sevenos.spotlight.v1"
        and isinstance(cached.get("items"), list)
        and (max_age is None or now - float(cached.get("created_at", 0)) <= max_age)
    ):
        return rows_to_items(cached["items"])
    return []


def load_catalog(*, force: bool = False) -> list[Item]:
    if not force:
        cached_items = read_cached_catalog()
        if cached_items:
            return cached_items
    result = subprocess.run(
        [str(ROOT / "bin/seven-spotlight"), "catalog"],
        text=True,
        capture_output=True,
        cwd=ROOT,
        env={**os.environ, "SEVENOS_ROOT": str(ROOT), "SEVENOS_SPOTLIGHT_NATIVE": "0"},
        check=False,
    )
    items: list[Item] = []
    for raw in result.stdout.splitlines():
        parts = raw.split("\t")
        if len(parts) >= 6:
            items.append(Item(*parts[:6]))
    write_json(CACHE_FILE, {"schema": "sevenos.spotlight.v1", "created_at": time.time(), "items": [[item.kind, item.label, item.key, item.command, item.detail, item.icon] for item in items]})
    return items


def fuzzy_score(query: str, item: Item) -> int:
    if not query:
        return 0
    haystack = item.search_text
    title = normalize(item.clean_title)
    if title == query:
        score = 140
    elif title.startswith(query):
        score = 118
    elif query in haystack:
        score = 82
    else:
        score = 0
        position = 0
        for char in query:
            found = haystack.find(char, position)
            if found == -1:
                return -1
            score += 4 if found == position else 2
            position = found + 1
    if item.kind == "app":
        score += 18
    if item.kind in {"setting", "action", "intent"}:
        score += 14
    if item.kind in {"history", "clipboard", "window"}:
        score += 8
    return score


def filter_items(items: list[Item], query: str, mode: str) -> list[Item]:
    if mode != "all":
        items = [item for item in items if mode_matches(item, mode)]
    if not query.strip():
        return items[:9] if mode != "all" else []
    terms = [normalize(term) for term in query.split() if term.strip()]
    ranked: list[tuple[int, int, Item]] = []
    for item in items:
        if not all(term in item.search_text or fuzzy_score(term, item) >= 0 for term in terms):
            continue
        score = fuzzy_score(normalize(query), item)
        if score >= 0:
            ranked.append((-score, len(item.clean_title), item))
    return [item for _, __, item in sorted(ranked, key=lambda row: (row[0], row[1]))[:9]]


def filter_items_for_contract(items: list[Item], query: str, current_mode: str) -> list[Item]:
    """Stable alias for the public Spotlight command-surface contract."""
    return filter_items(items, query, current_mode)


def mode_matches(item: Item, mode: str) -> bool:
    return {
        "ai": item.kind in {"ai_prompt", "intent"},
        "apps": item.kind == "app",
        "files": item.kind == "file",
        "settings": item.kind == "setting",
        "system": item.kind in {"action", "intent", "mode", "profile"},
        "web": item.kind in {"calc", "convert", "define", "web", "mail", "contacts", "calendar", "quick", "bookmark"},
        "clipboard": item.kind == "clipboard",
        "windows": item.kind == "window",
        "history": item.kind == "history",
    }.get(mode, True)


def dispatch_item(item: Item) -> None:
    if item.kind == "profile":
        subprocess.Popen(
            ["bash", "-lc", item.command],
            cwd=ROOT,
            env={**os.environ, "SEVENOS_ROOT": str(ROOT)},
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return
    subprocess.Popen(
        [str(ROOT / "bin/seven-spotlight"), "dispatch", item.kind, item.key, item.command],
        cwd=ROOT,
        env={**os.environ, "SEVENOS_ROOT": str(ROOT), "SEVENOS_SPOTLIGHT_NATIVE": "0"},
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def dispatch_query(query: str) -> None:
    if not query.strip():
        return
    subprocess.Popen(
        [str(ROOT / "bin/seven-spotlight"), "query", query],
        cwd=ROOT,
        env={**os.environ, "SEVENOS_ROOT": str(ROOT), "SEVENOS_SPOTLIGHT_NATIVE": "0"},
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def ai_prompt_items() -> list[Item]:
    return [
        Item(
            "ai_prompt",
            f"SevenAI · {label}",
            f"ai.prompt.{index}",
            prompt,
            "Demander à SevenAI dans Spotlight.",
            "seven-ai",
        )
        for index, (label, prompt) in enumerate(AI_PROMPTS, 1)
    ]


def ai_contextual_follow_up_items(query: str, payload: dict | None = None) -> list[Item]:
    normalized = normalize(query)
    items: list[Item] = []
    def add(label: str, prompt: str, detail: str, icon: str = "seven-ai") -> None:
        items.append(
            Item(
                "ai_prompt",
                label,
                f"ai.context.{len(items) + 1}",
                prompt,
                detail,
                icon,
            )
        )

    if any(word in normalized for word in ("disque", "stockage", "taille", "espace")):
        add("Voir les plus gros dossiers", "quels dossiers prennent le plus d'espace", "Comprendre ce qui occupe le disque.", "drive-harddisk-symbolic")
        add("Nettoyage sûr", "propose un nettoyage sûr sans supprimer mes fichiers", "Préparer une action non destructive.", "edit-clear-symbolic")
    if any(word in normalized for word in ("wifi", "wi fi", "reseau", "internet")):
        add("Diagnostiquer le Wi-Fi", "diagnostique mon wifi", "Tester réseau, Wi-Fi et services.", "network-wireless-symbolic")
        add("Ouvrir le réseau", "ouvre les paramètres wifi", "Aller au bon panneau système.", "preferences-system-network-symbolic")
    if any(word in normalized for word in ("etat", "machine", "sante", "diagnostic", "doctor")):
        add("Détails santé", "explique les problèmes de ma machine", "Transformer l’état système en explication claire.", "emblem-system-symbolic")
        add("Actions recommandées", "que dois-je faire maintenant pour stabiliser SevenOS", "Prioriser les actions utiles.", "view-list-symbolic")
    if any(word in normalized for word in ("ouvre", "lance", "ferme", "application", "app")):
        add("Afficher les apps", "montre mes applications", "Retrouver une app installée.", "view-grid-symbolic")
        add("Aide lancement", "pourquoi une application ne s'ouvre pas", "Diagnostiquer un lancement d’app.", "system-run-symbolic")
    if any(word in normalized for word in ("theme", "sombre", "clair", "apparence")):
        add("Synchroniser thème", "synchronise le thème partout", "Préparer la correction thème SevenOS.", "preferences-desktop-theme-symbolic")
        add("Ouvrir apparence", "ouvre apparence", "Accéder aux réglages visuels.", "preferences-desktop-wallpaper-symbolic")

    result = payload.get("result") if isinstance(payload, dict) and isinstance(payload.get("result"), dict) else {}
    if result.get("recommendations") and not items:
        add("Expliquer la recommandation", "explique la meilleure recommandation", "Comprendre avant d’agir.", "dialog-information-symbolic")
    return items[:3]


def ai_follow_up_items(plan: dict | None = None, query: str = "", applied: bool = False) -> list[Item]:
    items: list[Item] = []
    if plan and query and not applied and sevenai_execution_label(plan) == "Confirmation":
        items.extend(
            [
                Item(
                    "ai_control",
                    "Appliquer l’action",
                    "ai.followup.apply",
                    f"__apply__:{query}",
                    "Confirmer cette action SevenOS.",
                    "emblem-ok-symbolic",
                ),
                Item(
                    "ai_control",
                    "Annuler",
                    "ai.followup.cancel",
                    "__cancel__",
                    "Garder le système inchangé.",
                    "process-stop-symbolic",
                ),
            ]
        )
    wake_item = ai_model_wake_item()
    if wake_item:
        items.append(wake_item)
    items.extend(ai_proactive_items(limit=3))
    items.extend([
        Item(
            "ai_prompt",
            label,
            f"ai.followup.{index}",
            prompt,
            "Action rapide SevenAI.",
            "seven-ai",
        )
        for index, (label, prompt) in enumerate(AI_FOLLOW_UPS, 1)
    ])
    return items


def ai_recommendation_items(payload: dict, limit: int = 4) -> list[Item]:
    result = payload.get("result") if isinstance(payload.get("result"), dict) else {}
    recommendations = result.get("recommendations") if isinstance(result.get("recommendations"), list) else []
    items: list[Item] = []
    for index, card in enumerate(recommendations[:limit], 1):
        if not isinstance(card, dict):
            continue
        title = str(card.get("title") or "").strip()
        command = str(card.get("command") or "").strip()
        if not title or not command:
            continue
        risk = str(card.get("risk") or "low").strip()
        detail = str(card.get("detail") or "").strip()
        if risk and risk != "low":
            detail = f"{detail} · risque {risk}" if detail else f"Risque {risk}"
        items.append(
            Item(
                "ai_action",
                title,
                f"ai.recommendation.{index}",
                command,
                detail or "Action proposée par SevenAI.",
                "seven-ai",
            )
        )
    return items


def ai_model_wake_item() -> Item | None:
    status = sevenai_model_status()
    state = str(status.get("state") or "")
    wake = str(status.get("wake") or "")
    if state not in {"model-needs-start", "model-needs-download"} or not wake:
        return None
    detail = "Démarrer Ollama et préparer le modèle local SevenAI."
    if state == "model-needs-download":
        detail = "Télécharger le modèle local recommandé et l’activer pour SevenAI."
    return Item(
        "ai_control",
        "Activer le modèle local",
        "ai.followup.wake_model",
        "__wake_model__",
        detail,
        "media-playback-start-symbolic",
    )


def ai_proactive_items(*, limit: int = 3) -> list[Item]:
    try:
        result = subprocess.run(
            [str(ROOT / "bin/seven"), "ai", "proactive", "--json"],
            text=True,
            capture_output=True,
            cwd=ROOT,
            env={**os.environ, "SEVENOS_ROOT": str(ROOT)},
            timeout=4,
            check=False,
        )
        data = json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else {}
    except Exception:
        data = {}
    cards = data.get("cards") if isinstance(data.get("cards"), list) else []
    items: list[Item] = []
    for index, card in enumerate(cards[:limit], 1):
        if not isinstance(card, dict):
            continue
        title = str(card.get("title") or card.get("key") or "Suggestion SevenAI").strip()
        command = str(card.get("command") or "").strip()
        detail = str(card.get("detail") or "Suggestion locale SevenAI.").strip()
        if not command:
            continue
        title_map = {
            "Search local context": "Rechercher dans le contexte local",
            "Use learned habits": "Voir les habitudes apprises",
            "Equinox daily context": "Contexte quotidien Equinox",
            "Continue reading": "Continuer la lecture",
            "Browse visual assets": "Explorer les visuels",
        }
        title = title_map.get(title, title)
        items.append(
            Item(
                "action",
                title,
                f"ai.proactive.{index}",
                command,
                detail,
                "seven-ai",
            )
        )
    return items


def sevenai_model_status() -> dict:
    try:
        result = subprocess.run(
            [str(ROOT / "bin/seven"), "ai", "models", "--json"],
            text=True,
            capture_output=True,
            cwd=ROOT,
            env={**os.environ, "SEVENOS_ROOT": str(ROOT)},
            timeout=3,
            check=False,
        )
        data = json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else {}
    except Exception:
        data = {}
    return data if isinstance(data, dict) else {}


def sevenai_model_setup_payload() -> dict:
    result = subprocess.run(
        [str(ROOT / "bin/seven"), "ai", "model-setup", "--apply", "--json"],
        text=True,
        capture_output=True,
        cwd=ROOT,
        env={**os.environ, "SEVENOS_ROOT": str(ROOT)},
        timeout=float(os.environ.get("SEVENOS_SPOTLIGHT_MODEL_SETUP_TIMEOUT", "1900")),
        check=False,
    )
    raw = result.stdout.strip() or result.stderr.strip()
    try:
        payload = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        payload = {"summary": raw}
    if not isinstance(payload, dict):
        payload = {"summary": str(payload)}
    payload["_returncode"] = result.returncode
    return payload


def sevenai_model_setup_text(payload: dict) -> str:
    state = str(payload.get("state") or "unknown")
    model = str(payload.get("model") or "modèle local")
    runtime = payload.get("runtime") if isinstance(payload.get("runtime"), dict) else {}
    ollama = runtime.get("ollama") if isinstance(runtime.get("ollama"), dict) else {}
    if state == "ready":
        lines = ["SevenAI", f"Le modèle local {model} est prêt.", "SevenAI peut maintenant répondre avec le provider local Ollama, tout en gardant les actions système sous contrat SevenOS."]
    elif state == "missing-ollama":
        lines = ["SevenAI", "Ollama n’est pas installé sur cette machine.", "Installe Ollama ou garde le provider SevenAI local déterministe."]
    else:
        lines = ["SevenAI", f"Préparation du modèle local : {state}.", "Le mode sûr SevenAI reste actif même si le modèle profond n’est pas encore disponible."]
    if ollama:
        running = "actif" if ollama.get("running") else "arrêté"
        available = "modèle disponible" if ollama.get("available") else "modèle non disponible"
        lines.append(f"Ollama : {running} · {available}")
    if payload.get("_returncode", 0):
        lines.append(f"Code retour : {payload.get('_returncode')}")
    return "\n\n".join(lines)


def sevenai_status_text(query: str, *, apply: bool = False) -> str:
    if apply:
        return "J’applique l’action confirmée avec les garde-fous SevenOS."
    normalized = normalize(query)
    if any(word in normalized for word in ("disque", "stockage", "taille", "espace")):
        return "Je lis l’état du stockage local et je prépare une réponse claire."
    if any(word in normalized for word in ("wifi", "wi fi", "reseau", "internet")):
        return "Je vérifie le réseau et les actions sûres disponibles."
    if any(word in normalized for word in ("etat", "machine", "sante", "diagnostic", "doctor")):
        return "Je rassemble l’état système, la santé SevenOS et les points d’attention."
    if any(word in normalized for word in ("ouvre", "lance", "ferme", "application", "app")):
        return "Je cherche l’application et je prépare l’action sans toucher au système."
    if any(word in normalized for word in ("theme", "sombre", "clair", "apparence")):
        return "Je vérifie le thème actif et les réglages visuels SevenOS."
    return "J’analyse localement et je garde les actions système en aperçu."


def sevenai_pretty_text(text: str) -> str:
    lines = []
    for raw_line in text.strip().splitlines():
        line = raw_line.rstrip()
        if line.startswith("Contrat :") or line.startswith("Journal SevenAI :"):
            lines.append(line.replace(" · ", "\n  "))
            continue
        if " · seven " in line:
            head, command = line.split(" · seven ", 1)
            lines.append(f"{head}\n  seven {command}")
            continue
        lines.append(line)
    return "\n".join(lines).strip()


def sevenai_payload(query: str, *, apply: bool = False) -> dict:
    command = [str(ROOT / "bin/seven"), "ai", query, "--json"]
    if apply:
        command.append("--apply")
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        cwd=ROOT,
        env={**os.environ, "SEVENOS_ROOT": str(ROOT)},
        timeout=14,
        check=False,
    )
    raw = result.stdout.strip() or result.stderr.strip()
    try:
        payload = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        payload = {"result": {"summary": raw}}
    if not isinstance(payload, dict):
        payload = {"result": {"summary": str(payload)}}
    payload["_returncode"] = result.returncode
    return payload


def sevenai_operation_payload(query: str) -> dict:
    result = subprocess.run(
        [str(ROOT / "bin/seven"), "ai", "operate", query, "--json"],
        text=True,
        capture_output=True,
        cwd=ROOT,
        env={**os.environ, "SEVENOS_ROOT": str(ROOT)},
        timeout=8,
        check=False,
    )
    raw = result.stdout.strip() or result.stderr.strip()
    try:
        payload = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    payload["_returncode"] = result.returncode
    return payload


def sevenai_execution_label(plan: dict) -> str:
    summary = plan.get("summary") if isinstance(plan.get("summary"), dict) else {}
    confirmation = (plan.get("contract") or {}).get("confirm") if isinstance(plan.get("contract"), dict) else {}
    safety = str((plan.get("intent") or {}).get("safety") or confirmation.get("safety") or "SAFE").upper()
    if safety in {"BLOCKED", "DANGEROUS"}:
        return "Bloqué"
    if summary.get("requires_confirmation") or confirmation.get("needs_apply"):
        return "Confirmation"
    if summary.get("requires_apply"):
        return "Aperçu"
    return "Automatique"


def sevenai_summary(payload: dict) -> tuple[str, str, str]:
    intent = payload.get("intent") if isinstance(payload.get("intent"), dict) else {}
    action = payload.get("action") if isinstance(payload.get("action"), dict) else {}
    result = payload.get("result") if isinstance(payload.get("result"), dict) else {}
    title = str(intent.get("intent") or action.get("type") or "SevenAI")
    summary = str(
        result.get("summary")
        or result.get("message")
        or payload.get("message")
        or payload.get("error")
        or "Réponse prête."
    )
    command = str(action.get("command") or result.get("command") or "")
    detail = f"{title} · {command}" if command else title
    if payload.get("_returncode", 0):
        detail = f"{detail} · exit={payload.get('_returncode')}"
    return title, summary, detail


def sevenai_display_text(payload: dict, plan: dict) -> str:
    _title, summary, detail = sevenai_summary(payload)
    result = payload.get("result") if isinstance(payload.get("result"), dict) else {}
    plan_summary = plan.get("summary") if isinstance(plan.get("summary"), dict) else {}
    command = str(plan_summary.get("command") or "")
    mode = sevenai_execution_label(plan) if plan else "Aperçu"
    safety = str(((plan.get("intent") or {}).get("safety") if isinstance(plan.get("intent"), dict) else "") or "SAFE").upper()
    chat = result.get("chat") if isinstance(result.get("chat"), dict) else {}
    chat_answer = str(chat.get("answer") or "").strip()
    chat_title = str(chat.get("title") or "").strip()
    chat_bullets = chat.get("bullets") if isinstance(chat.get("bullets"), list) else []
    if chat_answer:
        lines = [chat_answer]
        rendered_chat = [str(item).strip() for item in chat_bullets if str(item).strip()]
        if rendered_chat:
            lines.append("À retenir :\n" + "\n".join(f"- {item}" for item in rendered_chat[:5]))
    else:
        lines = [summary.strip() or "Réponse prête."]
    selected_agent = result.get("selected_agent") if isinstance(result.get("selected_agent"), dict) else {}
    permission_summary = result.get("permission_summary") if isinstance(result.get("permission_summary"), dict) else {}
    if selected_agent:
        agent_name = str(selected_agent.get("name") or selected_agent.get("id") or "Agent SevenAI").strip()
        risk = str(selected_agent.get("risk") or "low").strip()
        profile = str(selected_agent.get("profile") or "").strip()
        agent_bits = [agent_name]
        if profile:
            agent_bits.append(f"Mini OS {profile}")
        if risk:
            risk_label = {"low": "faible", "medium": "moyen", "high": "élevé"}.get(risk, risk)
            agent_bits.append(f"risque {risk_label}")
        lines.append("Agent : " + " · ".join(agent_bits))
    if permission_summary:
        allowed = permission_summary.get("allowed") if isinstance(permission_summary.get("allowed"), list) else []
        confirm = permission_summary.get("confirm") if isinstance(permission_summary.get("confirm"), list) else []
        denied = permission_summary.get("denied") if isinstance(permission_summary.get("denied"), list) else []
        rendered_permissions = []
        if allowed:
            rendered_permissions.append("Lecture autorisée : " + ", ".join(str(item) for item in allowed[:4]))
        if confirm:
            rendered_permissions.append("Confirmation : " + ", ".join(str(item) for item in confirm[:4]))
        if denied:
            rendered_permissions.append("Interdit : " + ", ".join(str(item) for item in denied[:4]))
        if rendered_permissions:
            lines.append("Sécurité :\n" + "\n".join(f"- {item}" for item in rendered_permissions))
    agents = result.get("agents") if isinstance(result.get("agents"), list) else []
    if agents:
        rendered_agents = []
        for item in agents[:7]:
            if not isinstance(item, dict):
                continue
            name = str(item.get("name") or item.get("id") or "Agent").strip()
            state = str(item.get("state") or "unknown").strip()
            risk = str(item.get("risk") or "low").strip()
            risk_label = {"low": "faible", "medium": "moyen", "high": "élevé"}.get(risk, risk)
            rendered_agents.append(f"- {name} · {state} · risque {risk_label}")
        if rendered_agents:
            lines.append("Agents :\n" + "\n".join(rendered_agents))
    recommendations = result.get("recommendations") if isinstance(result.get("recommendations"), list) else []
    if recommendations:
        rendered = []
        for item in recommendations[:3]:
            if not isinstance(item, dict):
                continue
            title = str(item.get("title") or "").strip()
            command_text = str(item.get("command") or "").strip()
            if title and command_text:
                rendered.append(f"- {title} · {command_text}")
            elif title:
                rendered.append(f"- {title}")
        if rendered:
            lines.append("Actions utiles :\n" + "\n".join(rendered))
    local_results = result.get("results") if isinstance(result.get("results"), list) else []
    if local_results:
        rendered_results = []
        for item in local_results[:4]:
            if not isinstance(item, dict):
                continue
            name = str(item.get("name") or item.get("title") or "").strip()
            source = str(item.get("source") or item.get("ext") or "").strip()
            if name:
                rendered_results.append(f"- {name}" + (f" · {source}" if source else ""))
        if rendered_results:
            lines.append("Trouvé localement :\n" + "\n".join(rendered_results))
    priorities = result.get("priorities") if isinstance(result.get("priorities"), list) else []
    if priorities:
        rendered_priorities = []
        for item in priorities[:4]:
            if not isinstance(item, dict):
                continue
            priority = str(item.get("priority") or "").strip()
            title = str(item.get("title") or "").strip()
            if title:
                rendered_priorities.append(f"- {priority.upper()} · {title}" if priority else f"- {title}")
        if rendered_priorities:
            lines.append("Priorités maintenant :\n" + "\n".join(rendered_priorities))
    conversation = payload.get("conversation") if isinstance(payload.get("conversation"), dict) else {}
    if conversation.get("used"):
        previous = conversation.get("previous") if isinstance(conversation.get("previous"), dict) else {}
        previous_input = str(previous.get("input") or "").strip()
        lines.append(f"Suite de : {previous_input}" if previous_input else "Suite de la conversation locale.")
    contract = f"Contrat : {mode} · {safety}"
    if command:
        contract = f"{contract} · {command}"
    lines.append(contract)
    ledger = payload.get("ledger") if isinstance(payload.get("ledger"), dict) else {}
    if ledger.get("recorded"):
        risk = str(ledger.get("risk") or "low")
        action = str(ledger.get("action") or "action")
        lines.append(f"Journal SevenAI : enregistré · risque {risk} · {action}")
    if payload.get("_returncode", 0):
        lines.append(detail)
    return "\n\n".join(lines)


def shutil_which(command: str) -> str | None:
    for folder in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(folder) / command
        if candidate.exists() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def close_existing_spotlight() -> bool:
    if not shutil_which("hyprctl"):
        return False
    try:
        result = subprocess.run(
            ["hyprctl", "clients", "-j"],
            capture_output=True,
            text=True,
            check=False,
        )
        clients = json.loads(result.stdout or "[]")
    except (OSError, json.JSONDecodeError):
        return False
    for client in clients:
        if client.get("class") != "SevenSpotlightNative":
            continue
        address = str(client.get("address", "")).strip()
        if not address:
            continue
        subprocess.run(["hyprctl", "dispatch", "closewindow", f"address:{address}"], check=False)
        return True
    return False


def acquire_spotlight_lock() -> bool:
    global LOCK_HANDLE
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    LOCK_HANDLE = LOCK_FILE.open("w", encoding="utf-8")
    try:
        fcntl.flock(LOCK_HANDLE.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return False
    LOCK_HANDLE.seek(0)
    LOCK_HANDLE.truncate()
    LOCK_HANDLE.write(f"{os.getpid()}\n")
    LOCK_HANDLE.flush()
    return True


def probe() -> int:
    ensure_gi_python()
    try:
        import gi

        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk  # noqa: F401
    except Exception as exc:
        print(f"MISS: {exc}", file=sys.stderr)
        return 1
    print("OK")
    return 0


def profile_css(profile: dict, mode: str) -> str:
    accent = profile.get("accent") or "#8B7CFF"
    secondary = profile.get("secondary") or "#6EA8FF"
    glow = "0.18" if mode == "light" else "0.30"
    surface = "0.10" if mode == "light" else "0.16"
    return f"""
    .spotlight-root {{
      border-color: alpha({accent}, 0.28);
      box-shadow:
        0 24px 72px rgba(0,0,0,{'0.16' if mode == 'light' else '0.42'}),
        0 0 42px alpha({accent}, {glow});
    }}
    .spotlight-search {{
      border-color: alpha({accent}, 0.24);
      background:
        radial-gradient(ellipse at 10% -20%, alpha({accent}, {surface}), transparent 58%),
        alpha(#FFFFFF, {'0.82' if mode == 'light' else '0.10'});
    }}
    .category-button.active,
    .result-row.selected,
    .result-row:hover {{
      border-color: alpha({accent}, 0.34);
      background: alpha({accent}, {'0.15' if mode == 'light' else '0.18'});
    }}
    .ai-card,
    .ai-question,
    .ai-answer {{
      border-color: alpha({secondary}, 0.24);
      background: alpha({secondary}, {'0.10' if mode == 'light' else '0.14'});
    }}
    """


