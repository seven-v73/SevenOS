def run(mode: str, *, field_mode: bool = False) -> int:
    ensure_gi_python()
    import gi

    gi.require_version("Gdk", "3.0")
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    GLib.set_prgname("SevenSpotlightNative")
    GLib.set_application_name("SevenOS Spotlight")
    try:
        Gdk.set_program_class("SevenSpotlightNative")
    except Exception:
        pass

    theme_mode = current_theme_mode()
    Gtk.Settings.get_default().set_property("gtk-icon-theme-name", icon_theme_name(theme_mode))
    profile_ui = read_profile_ui()
    css = spotlight_css(theme_mode, profile_ui)
    provider = Gtk.CssProvider()
    provider.load_from_data(css.encode("utf-8"))
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    current_mode = mode if mode in {key for key, _, _ in CATEGORIES} else "all"
    result_rows: list[Gtk.Widget] = []
    current_matches: list[Item] = []
    selected_index = 0
    ai_busy = False
    ai_status_bubble: Gtk.Widget | None = None
    ai_intro_shown = False
    ai_last_response = ""

    profile_title = profile_ui.get("title") or "SevenOS"
    items = profile_items(profile_ui) + read_cached_catalog(max_age=None)
    window = Gtk.Window(title=f"{profile_title} Spotlight")
    window.set_decorated(False)
    window.set_resizable(False)
    window.set_position(Gtk.WindowPosition.CENTER)
    window.set_wmclass("SevenSpotlightNative", "SevenSpotlightNative")
    window.get_style_context().add_class("spotlight-window")

    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    root.get_style_context().add_class("spotlight-root")
    if field_mode:
        root.get_style_context().add_class("field-mode")
    window.add(root)

    entry = Gtk.Entry()
    # Keep "Search SevenOS" in source as the design-check baseline while the
    # runtime label adapts to the active mini OS through profile-ui.json.
    entry.set_placeholder_text(f"Search {profile_title}" if not field_mode else "Search apps, files, actions...")
    entry.set_icon_from_icon_name(Gtk.EntryIconPosition.PRIMARY, "system-search")
    entry.get_style_context().add_class("spotlight-search")
    root.pack_start(entry, False, False, 0)

    category_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    category_row.set_halign(Gtk.Align.CENTER)
    category_row.get_style_context().add_class("category-row")
    root.pack_start(category_row, False, False, 0)

    home = profile_ui.get("home_screen") if isinstance(profile_ui.get("home_screen"), dict) else {}
    persona = home.get("ai_persona") or "SevenAI"
    ai_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    ai_card = Gtk.Label(label=f"{profile_title} · {persona} répond localement. Entrée envoie, les actions système restent prévisualisées.")
    ai_card.set_xalign(0)
    ai_card.get_style_context().add_class("ai-card")
    ai_header.pack_start(ai_card, True, True, 0)
    close_button = Gtk.Button(label="Fermer")
    close_button.get_style_context().add_class("ai-close-button")
    close_button.set_tooltip_text("Fermer Spotlight")
    close_button.connect("clicked", lambda _button: window.destroy())
    ai_header.pack_start(close_button, False, False, 0)
    root.pack_start(ai_header, False, False, 0)

    ai_hint = Gtk.Label(label=AI_SHORTCUT_HINT)
    ai_hint.set_xalign(0.5)
    ai_hint.get_style_context().add_class("ai-hint")
    ai_hint.set_no_show_all(True)
    ai_hint.hide()
    root.pack_start(ai_hint, False, False, 0)

    ai_question = Gtk.Label(label="")
    ai_question.set_xalign(0)
    ai_question.set_line_wrap(True)
    ai_question.set_max_width_chars(72)
    ai_question.get_style_context().add_class("ai-question")
    ai_question.set_no_show_all(True)
    ai_question.hide()
    root.pack_start(ai_question, False, False, 0)

    ai_answer = Gtk.Label(label="")
    ai_answer.set_xalign(0)
    ai_answer.set_line_wrap(True)
    ai_answer.set_max_width_chars(76)
    ai_answer.get_style_context().add_class("ai-answer")
    ai_answer.set_no_show_all(True)
    ai_answer.hide()
    root.pack_start(ai_answer, False, False, 0)

    chat_scroll = Gtk.ScrolledWindow()
    chat_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    chat_scroll.set_min_content_height(0)
    chat_scroll.set_max_content_height(210)
    chat_scroll.get_style_context().add_class("ai-chat-scroll")
    chat_scroll.set_no_show_all(True)
    chat_scroll.hide()
    chat_stack = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    chat_stack.get_style_context().add_class("ai-chat-stack")
    chat_scroll.add(chat_stack)
    root.pack_start(chat_scroll, False, False, 0)

    result_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
    result_box.get_style_context().add_class("result-list")
    root.pack_start(result_box, False, False, 0)

    category_buttons: dict[str, Gtk.Button] = {}

    def scroll_chat_to_bottom() -> bool:
        adjustment = chat_scroll.get_vadjustment()
        adjustment.set_value(max(0, adjustment.get_upper() - adjustment.get_page_size()))
        return False

    def append_chat(role: str, title: str, body: str) -> Gtk.Widget | None:
        body = body.strip()
        if not body:
            return None
        chat_scroll.show()
        bubble = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        bubble.get_style_context().add_class("ai-bubble")
        bubble.get_style_context().add_class(role)
        bubble.set_halign(Gtk.Align.END if role == "user" else Gtk.Align.FILL)
        heading = Gtk.Label(label=title)
        heading.set_xalign(0)
        heading.get_style_context().add_class("ai-bubble-title")
        content = Gtk.Label(label=body)
        content.set_xalign(0)
        content.set_line_wrap(True)
        content.set_max_width_chars(78)
        content.set_selectable(True)
        content.get_style_context().add_class("ai-bubble-body")
        bubble.pack_start(heading, False, False, 0)
        bubble.pack_start(content, False, False, 0)
        chat_stack.pack_start(bubble, False, False, 0)
        chat_stack.show_all()
        GLib.idle_add(scroll_chat_to_bottom)
        return bubble

    def clean_agent_body(text: str) -> str:
        text = text.strip()
        for prefix in ("SevenAI\n\n", "SevenAI\n", "SevenAI · "):
            if text.startswith(prefix):
                return sevenai_pretty_text(text[len(prefix):])
        return sevenai_pretty_text(text)

    def clear_chat() -> None:
        nonlocal ai_status_bubble, ai_intro_shown, ai_last_response
        for child in list(chat_stack.get_children()):
            chat_stack.remove(child)
        ai_status_bubble = None
        ai_intro_shown = False
        ai_last_response = ""
        chat_scroll.hide()
        ai_question.hide()
        ai_answer.hide()

    def copy_last_ai_response() -> None:
        if not ai_last_response.strip():
            append_chat("system", "SevenAI", "Aucune réponse à copier pour le moment.")
            return
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(ai_last_response, -1)
        append_chat("system", "SevenAI", "Dernière réponse copiée dans le presse-papiers.")

    def reset_chat_if_needed() -> None:
        if len(chat_stack.get_children()) > 10:
            for child in list(chat_stack.get_children())[:4]:
                chat_stack.remove(child)

    def refresh_results() -> None:
        nonlocal result_rows, current_matches, selected_index
        for child in list(result_box.get_children()):
            result_box.remove(child)
        result_rows = []
        query = entry.get_text()
        if current_mode == "ai" and query.strip():
            current_matches = [
                Item(
                    "ai_prompt",
                    f"Demander à SevenAI · {query.strip()}",
                    "ai.current",
                    query.strip(),
                    "Entrée ou clic pour envoyer la question.",
                    "seven-ai",
                )
            ]
        else:
            source_items = ai_prompt_items() if current_mode == "ai" and not query.strip() else items
            current_matches = filter_items(source_items, query, current_mode)
        matches = current_matches
        selected_index = 0
        result_box.set_visible(bool(matches))
        ai_card.set_visible(current_mode == "ai" or (bool(query.strip()) and not matches))
        if current_mode != "ai":
            ai_question.hide()
            ai_answer.hide()
        for item in matches:
            row = make_result_row(item)
            result_box.pack_start(row, False, False, 0)
            result_rows.append(row)
        update_selection()
        result_box.show_all()

    def show_ai_follow_ups(plan: dict | None = None, query: str = "", applied: bool = False, payload: dict | None = None) -> None:
        nonlocal result_rows, current_matches, selected_index
        for child in list(result_box.get_children()):
            result_box.remove(child)
        result_rows = []
        current_matches = []
        if payload:
            current_matches.extend(ai_recommendation_items(payload))
            current_matches.extend(ai_contextual_follow_up_items(query, payload))
        current_matches.extend(ai_follow_up_items(plan, query, applied))
        selected_index = 0
        for item in current_matches:
            row = make_result_row(item, len(result_rows) == selected_index)
            result_rows.append(row)
            result_box.pack_start(row, False, False, 0)
        result_box.set_visible(True)
        result_box.show_all()

    def update_selection() -> None:
        for index, row in enumerate(result_rows):
            style = row.get_child().get_style_context()
            if index == selected_index:
                style.add_class("selected")
            else:
                style.remove_class("selected")

    def set_mode(new_mode: str) -> None:
        nonlocal current_mode, ai_intro_shown
        current_mode = new_mode
        if new_mode == "ai":
            entry.set_placeholder_text("Demander à SevenAI : ouvrir une app, expliquer le disque, diagnostiquer SevenOS...")
            ai_hint.show()
            if not ai_intro_shown:
                append_chat(
                    "system",
                    "SevenAI",
                    "Je peux ouvrir des apps, lire l’état de la machine, expliquer un problème et préparer des actions. Les changements système restent en aperçu puis confirmation.",
                )
                ai_intro_shown = True
        else:
            ai_hint.hide()
            entry.set_placeholder_text(f"Search {profile_title}" if not field_mode else "Search apps, files, actions...")
        for key, button in category_buttons.items():
            if key == new_mode:
                button.get_style_context().add_class("active")
            else:
                button.get_style_context().remove_class("active")
        refresh_results()

    def make_category_button(key: str, icon_name: str, label: str) -> Gtk.Button:
        button = Gtk.Button()
        button.set_tooltip_text(label)
        button.get_style_context().add_class("category-button")
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        content.set_halign(Gtk.Align.CENTER)
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
        icon.set_pixel_size(24)
        content.pack_start(icon, False, False, 0)
        text = Gtk.Label(label=label)
        text.get_style_context().add_class("category-label")
        content.pack_start(text, False, False, 0)
        button.add(content)
        button.connect("clicked", lambda _button: set_mode(key))
        category_buttons[key] = button
        return button

    def make_result_row(item: Item, selected: bool = False) -> Gtk.EventBox:
        event = Gtk.EventBox()
        event.set_visible_window(False)
        event.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        event.connect("button-press-event", lambda _widget, event_data, row_item=item: activate_result(row_item) if getattr(event_data, "button", 0) == 1 else False)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.get_style_context().add_class("result-row")
        if item.key.startswith("ai.followup.") or item.key.startswith("ai.proactive.") or item.key.startswith("ai.recommendation."):
            row.get_style_context().add_class("ai-followup")
        if selected:
            row.get_style_context().add_class("selected")
        icon = Gtk.Image.new_from_icon_name(item.icon, Gtk.IconSize.DIALOG)
        icon.set_pixel_size(30)
        row.pack_start(icon, False, False, 0)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label=item.clean_title)
        title.set_xalign(0)
        title.get_style_context().add_class("result-title")
        meta_text = item.detail if item.detail else item.category
        meta = Gtk.Label(label=meta_text[:88])
        meta.set_xalign(0)
        meta.get_style_context().add_class("result-meta")
        text.pack_start(title, False, False, 0)
        text.pack_start(meta, False, False, 0)
        row.pack_start(text, True, True, 0)
        event.add(row)
        return event

    def activate_result(item: Item) -> bool:
        if item.command == "__close__":
            window.destroy()
            return True
        if item.command == "__new_question__":
            entry.set_text("")
            entry.set_placeholder_text("Poser une nouvelle question à SevenAI...")
            entry.grab_focus()
            refresh_results()
            return True
        if item.command == "__copy_last__":
            copy_last_ai_response()
            return True
        if item.command == "__cancel__":
            append_chat("agent", "SevenAI", "Action annulée. Rien n’a été modifié.")
            entry.set_text("")
            entry.set_placeholder_text("Continuer avec SevenAI...")
            show_ai_follow_ups(applied=True)
            return True
        if item.command == "__wake_model__":
            run_ai_model_setup_inline()
            return True
        if item.command.startswith("__apply__:"):
            query = item.command.split(":", 1)[1].strip()
            if query:
                run_ai_inline(query, apply=True)
            return True
        if item.kind == "ai_action":
            command_text = item.command.strip()
            if command_text.startswith("seven ai "):
                query = command_text.removeprefix("seven ai ").strip()
                query = query.removesuffix("--json").strip()
                if (query.startswith("'") and query.endswith("'")) or (query.startswith('"') and query.endswith('"')):
                    query = query[1:-1]
                run_ai_inline(query)
                return True
            subprocess.Popen(
                ["bash", "-lc", item.command],
                cwd=ROOT,
                env={**os.environ, "SEVENOS_ROOT": str(ROOT)},
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            window.destroy()
            return True
        if item.kind == "ai_prompt":
            entry.set_text(item.command)
            run_ai_inline(item.command)
            return True
        dispatch_item(item)
        window.destroy()
        return True

    def run_ai_inline(query: str, *, apply: bool = False) -> None:
        nonlocal ai_busy, ai_status_bubble, ai_last_response
        if not query.strip() or ai_busy:
            return
        ai_busy = True
        reset_chat_if_needed()
        append_chat("user", "Vous confirmez" if apply else "Vous", query.strip())
        ai_status_bubble = append_chat("system", "SevenAI", sevenai_status_text(query, apply=apply))
        ai_question.hide()
        ai_answer.hide()
        result_box.set_visible(False)

        def worker() -> None:
            try:
                plan = sevenai_operation_payload(query)
                payload = sevenai_payload(query, apply=apply)
            except Exception as exc:
                plan = {}
                payload = {"result": {"summary": f"SevenAI n'a pas pu répondre : {exc}"}, "_returncode": 1}

            def apply_payload() -> bool:
                nonlocal ai_busy, ai_status_bubble
                if ai_status_bubble is not None:
                    chat_stack.remove(ai_status_bubble)
                    ai_status_bubble = None
                ai_last_response = clean_agent_body(sevenai_display_text(payload, plan))
                append_chat("agent", "SevenAI", ai_last_response)
                entry.set_text("")
                entry.set_placeholder_text("Continuer avec SevenAI...")
                show_ai_follow_ups(plan, query, applied=apply, payload=payload)
                ai_busy = False
                return False

            GLib.idle_add(apply_payload)

        threading.Thread(target=worker, name="sevenos-spotlight-ai", daemon=True).start()

    def run_ai_model_setup_inline() -> None:
        nonlocal ai_busy, ai_status_bubble, ai_last_response
        if ai_busy:
            return
        ai_busy = True
        reset_chat_if_needed()
        append_chat("user", "Vous", "Activer le modèle local SevenAI")
        ai_status_bubble = append_chat("system", "SevenAI", "Je prépare le modèle local. Cette étape peut prendre du temps si le modèle doit être téléchargé.")
        ai_question.hide()
        ai_answer.hide()
        entry.set_text("")
        entry.set_placeholder_text("Préparation du modèle local...")
        result_box.set_visible(False)

        def worker() -> None:
            try:
                payload = sevenai_model_setup_payload()
            except Exception as exc:
                payload = {"state": "error", "summary": str(exc), "_returncode": 1}

            def apply_payload() -> bool:
                nonlocal ai_busy, ai_status_bubble
                if ai_status_bubble is not None:
                    chat_stack.remove(ai_status_bubble)
                    ai_status_bubble = None
                ai_last_response = clean_agent_body(sevenai_model_setup_text(payload))
                append_chat("agent", "SevenAI", ai_last_response)
                entry.set_placeholder_text("Continuer avec SevenAI...")
                show_ai_follow_ups(applied=True)
                ai_busy = False
                return False

            GLib.idle_add(apply_payload)

        threading.Thread(target=worker, name="sevenos-spotlight-ai-model", daemon=True).start()

    def activate_current() -> None:
        query = entry.get_text().strip()
        if current_mode == "ai":
            run_ai_inline(query)
            return
        if current_matches:
            dispatch_item(current_matches[selected_index])
        else:
            dispatch_query(query)
        window.destroy()

    def refresh_catalog_async() -> None:
        def worker() -> None:
            fresh_items = load_catalog(force=True)

            def apply_items() -> bool:
                nonlocal items
                items = profile_items(profile_ui) + fresh_items
                refresh_results()
                return False

            GLib.idle_add(apply_items)

        threading.Thread(target=worker, name="sevenos-spotlight-catalog", daemon=True).start()

    def on_key(_widget, event) -> bool:
        nonlocal selected_index
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
        if event.keyval == Gdk.KEY_Escape or (ctrl and event.keyval in {Gdk.KEY_w, Gdk.KEY_W, Gdk.KEY_q, Gdk.KEY_Q}):
            window.destroy()
            return True
        if ctrl and event.keyval == Gdk.KEY_BackSpace:
            clear_chat()
            entry.set_text("")
            entry.set_placeholder_text("Continuer avec SevenAI..." if current_mode == "ai" else f"Search {profile_title}")
            refresh_results()
            return True
        if ctrl and bool(event.state & Gdk.ModifierType.SHIFT_MASK) and event.keyval in {Gdk.KEY_c, Gdk.KEY_C}:
            copy_last_ai_response()
            return True
        if ctrl and event.keyval in {Gdk.KEY_l, Gdk.KEY_L}:
            entry.grab_focus()
            entry.select_region(0, -1)
            return True
        if ctrl and event.keyval in {Gdk.KEY_Return, Gdk.KEY_KP_Enter}:
            apply_item = next((item for item in current_matches if item.command.startswith("__apply__:")), None)
            if apply_item:
                activate_result(apply_item)
                return True
        if event.keyval in {Gdk.KEY_Down, Gdk.KEY_Tab} and result_rows:
            selected_index = min(selected_index + 1, len(result_rows) - 1)
            update_selection()
            return True
        if event.keyval == Gdk.KEY_Up and result_rows:
            selected_index = max(selected_index - 1, 0)
            update_selection()
            return True
        if Gdk.KEY_1 <= event.keyval <= Gdk.KEY_8 and event.state & Gdk.ModifierType.CONTROL_MASK:
            index = event.keyval - Gdk.KEY_1
            if index < len(CATEGORIES):
                set_mode(CATEGORIES[index][0])
                return True
        if event.keyval in {Gdk.KEY_Return, Gdk.KEY_KP_Enter}:
            activate_current()
            return True
        return False

    for category in CATEGORIES:
        category_row.pack_start(make_category_button(*category), False, False, 0)

    if field_mode:
        category_row.set_no_show_all(True)
        category_row.hide()

    entry.connect("changed", lambda _entry: refresh_results())
    window.connect("key-press-event", on_key)
    entry.connect("key-press-event", on_key)
    window.connect("destroy", Gtk.main_quit)
    window.set_default_size(560 if field_mode else 760, 72 if field_mode else 430)
    window.show_all()
    set_mode(current_mode)
    refresh_catalog_async()
    entry.grab_focus()
    Gtk.main()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", default="all")
    parser.add_argument("--field", action="store_true")
    parser.add_argument("--probe", action="store_true")
    args = parser.parse_args()
    if args.probe:
        return probe()
    if not acquire_spotlight_lock():
        close_existing_spotlight()
        return 0
    if close_existing_spotlight():
        return 0
    return run(args.mode, field_mode=args.field)


if __name__ == "__main__":
    raise SystemExit(main())
