#!/usr/bin/env python3
import json
import os
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk


def resolve_root() -> Path:
    env_root = os.environ.get("SEVENOS_ROOT")
    if env_root and Path(env_root, "install.sh").is_file():
        return Path(env_root).resolve()
    script_dir = Path(__file__).resolve().parent
    candidate = script_dir.parent
    if Path(candidate, "install.sh").is_file():
        return candidate
    for path in (Path("/opt/SevenOS"), Path.home() / "Code/OS/SevenOS", Path.home() / "SevenOS"):
        if Path(path, "install.sh").is_file():
            return path
    raise SystemExit("SevenOS root not found")


ROOT = resolve_root()


def run_json(args: list[str], fallback: dict) -> dict:
    env = os.environ.copy()
    env["SEVENOS_ROOT"] = str(ROOT)
    result = subprocess.run(args, cwd=str(ROOT), env=env, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=False)
    if result.returncode != 0:
        return fallback
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return fallback


def launch(command: str) -> None:
    subprocess.Popen(["bash", "-lc", command], cwd=str(ROOT), start_new_session=True)


class ForgeCenter:
    def __init__(self, project: str = ".") -> None:
        self.project = project
        self.payload = self.load()
        self.window = Gtk.Window(title="Forge Project Center")
        self.window.set_default_size(1080, 720)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.connect("destroy", Gtk.main_quit)
        self.apply_css()

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        outer.get_style_context().add_class("forge-root")
        self.window.add(outer)

        header = self.header()
        outer.pack_start(header, False, False, 0)

        body = Gtk.Grid()
        body.set_column_spacing(16)
        body.set_row_spacing(16)
        body.set_column_homogeneous(False)
        outer.pack_start(body, True, True, 0)

        body.attach(self.project_card(), 0, 0, 1, 1)
        body.attach(self.readiness_card(), 1, 0, 1, 1)
        body.attach(self.services_card(), 2, 0, 1, 2)
        body.attach(self.commands_card(), 0, 1, 1, 1)
        body.attach(self.ports_card(), 1, 1, 1, 1)
        body.attach(self.extensions_card(), 0, 2, 1, 1)
        body.attach(self.ai_card(), 1, 2, 2, 1)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        footer.get_style_context().add_class("footer")
        outer.pack_start(footer, False, False, 0)
        footer.pack_start(self.small_text("Forge keeps dev tools, services and project memory inside the development mini OS."), True, True, 0)
        refresh = self.button("Refresh", lambda *_: self.refresh())
        footer.pack_end(refresh, False, False, 0)

    def load(self) -> dict:
        return run_json([str(ROOT / "bin/seven-forge"), "project", self.project, "--json"], {"state": "unknown"})

    def refresh(self) -> None:
        self.window.destroy()
        ForgeCenter(self.project).run()

    def apply_css(self) -> None:
        css = b"""
        window { background: #080b14; color: #eef3ff; }
        .forge-root { padding: 24px; background: radial-gradient(circle at top left, alpha(#6ea8ff, .18), transparent 36%), #090d18; }
        .title { font-size: 28px; font-weight: 500; }
        .subtitle { color: #aab6cf; font-size: 12px; }
        .card { background: alpha(#121a2b, .92); border: 1px solid alpha(#7aa2ff, .22); border-radius: 14px; padding: 16px; }
        .card-title { font-size: 15px; font-weight: 500; }
        .metric { font-size: 24px; font-weight: 500; }
        .muted { color: #9aa7c0; }
        .pill { background: alpha(#7c5cff, .18); border: 1px solid alpha(#9b87ff, .38); border-radius: 999px; padding: 6px 10px; }
        button { background: alpha(#19243a, .96); color: #eef3ff; border: 1px solid alpha(#8ca8ff, .26); border-radius: 999px; padding: 8px 14px; }
        button:hover { background: alpha(#293a60, .98); border-color: alpha(#9b87ff, .62); }
        .danger { color: #ffc0c0; }
        .ok { color: #a7f3d0; }
        .footer { padding-top: 4px; }
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def header(self) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        profile = self.payload.get("profile", {})
        project = self.payload.get("project", {})
        title = Gtk.Label(label="Forge Project Center", xalign=0)
        title.get_style_context().add_class("title")
        subtitle = Gtk.Label(label=f"{project.get('name', 'Project')} · {project.get('stack', 'unknown')} · profile {profile.get('active', 'unknown')}", xalign=0)
        subtitle.get_style_context().add_class("subtitle")
        left.pack_start(title, False, False, 0)
        left.pack_start(subtitle, False, False, 0)
        box.pack_start(left, True, True, 0)
        box.pack_end(self.button("Open Code", lambda *_: launch(f"code {json.dumps(project.get('path', self.project))}")), False, False, 0)
        box.pack_end(self.button("Remember", lambda *_: launch(f"seven forge remember {json.dumps(project.get('path', self.project))}")), False, False, 0)
        return box

    def card(self, title: str) -> tuple[Gtk.Box, Gtk.Box]:
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        outer.get_style_context().add_class("card")
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("card-title")
        outer.pack_start(label, False, False, 0)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        outer.pack_start(inner, True, True, 0)
        return outer, inner

    def project_card(self) -> Gtk.Widget:
        outer, box = self.card("Project")
        project = self.payload.get("project", {})
        box.pack_start(self.metric(project.get("name", "Unknown")), False, False, 0)
        box.pack_start(self.small_text(project.get("path", "")), False, False, 0)
        git = project.get("git", {})
        git_line = f"Git {git.get('state', 'unknown')} · {git.get('branch', 'unknown')} · {git.get('changed', 0)} changed"
        box.pack_start(self.pill(git_line, "danger" if git.get("state") == "dirty" else "ok"), False, False, 0)
        tools = ", ".join(project.get("tools", [])[:8]) or "No tool detected yet"
        box.pack_start(self.small_text(f"Tools: {tools}"), False, False, 0)
        return outer

    def readiness_card(self) -> Gtk.Widget:
        outer, box = self.card("Readiness")
        readiness = self.payload.get("readiness", {})
        score = readiness.get("score", 0)
        state = readiness.get("state", "unknown")
        box.pack_start(self.metric(f"{score}%"), False, False, 0)
        box.pack_start(self.pill(state, "ok" if state == "ready" else "danger"), False, False, 0)
        issues = readiness.get("issues", [])
        if not issues:
            box.pack_start(self.small_text("Project looks ready for a calm Forge workflow."), False, False, 0)
        for item in issues[:3]:
            box.pack_start(self.small_text(f"{item.get('title')}: {item.get('detail')}"), False, False, 0)
        actions = readiness.get("actions", [])
        if actions:
            first = actions[0]
            box.pack_start(self.button(first.get("title", "Open action"), lambda *_: launch(first.get("command", ""))), False, False, 0)
        box.pack_start(self.button("Full check", lambda *_: launch(f"seven forge readiness {json.dumps(self.project)}")), False, False, 0)
        return outer

    def services_card(self) -> Gtk.Widget:
        outer, box = self.card("Services")
        for item in self.payload.get("services", {}).get("items", []):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            title = Gtk.Label(label=f"{item.get('title')} · {item.get('active')}", xalign=0)
            title.get_style_context().add_class("ok" if item.get("active") == "active" else "muted")
            row.pack_start(title, True, True, 0)
            row.pack_end(self.button("Logs", lambda _b, cmd=item["commands"]["logs"]: launch(cmd)), False, False, 0)
            row.pack_end(self.button("Start", lambda _b, cmd=item["commands"]["start"]: launch(cmd)), False, False, 0)
            box.pack_start(row, False, False, 0)
        return outer

    def commands_card(self) -> Gtk.Widget:
        outer, box = self.card("Commands")
        commands = self.payload.get("project", {}).get("commands", {})
        tasks = self.payload.get("project", {}).get("tasks", [])
        if not commands:
            box.pack_start(self.small_text("No natural command detected yet."), False, False, 0)
        for key, value in list(commands.items())[:6]:
            command = value[0] if isinstance(value, list) and value else value if isinstance(value, str) else ""
            if not command:
                continue
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.pack_start(Gtk.Label(label=key, xalign=0), False, False, 0)
            row.pack_start(self.small_text(command), True, True, 0)
            row.pack_end(self.button("Run", lambda _b, cmd=command: launch(cmd)), False, False, 0)
            box.pack_start(row, False, False, 0)
        if tasks:
            box.pack_start(self.small_text(f"{len(tasks)} task(s) detected from project files."), False, False, 0)
        return outer

    def ports_card(self) -> Gtk.Widget:
        outer, box = self.card("Local Ports")
        ports = self.payload.get("ports", {}).get("items", [])
        for item in ports[:8]:
            box.pack_start(self.small_text(f":{item.get('port')} · {item.get('process') or item.get('local')}"), False, False, 0)
        if not ports:
            box.pack_start(self.small_text("No local listener detected."), False, False, 0)
        return outer

    def extensions_card(self) -> Gtk.Widget:
        outer, box = self.card("Editor Setup")
        ext = self.payload.get("extensions", {})
        box.pack_start(self.metric(f"{ext.get('count', 0)} extensions"), False, False, 0)
        box.pack_start(self.small_text("Captured as a manifest, not duplicated as heavy folders."), False, False, 0)
        box.pack_start(self.button("Import config", lambda *_: launch("seven forge config import --apply")), False, False, 0)
        if ext.get("install_command"):
            box.pack_start(self.button("Install extensions", lambda *_: launch(ext["install_command"])), False, False, 0)
        return outer

    def ai_card(self) -> Gtk.Widget:
        outer, box = self.card("SevenAI for Forge")
        for item in self.payload.get("ai", {}).get("commands", [])[:4]:
            box.pack_start(self.button(item.get("title", "Ask SevenAI"), lambda _b, cmd=item.get("command", "seven ai forge"): launch(cmd)), False, False, 0)
        return outer

    def metric(self, text: str) -> Gtk.Label:
        label = Gtk.Label(label=str(text), xalign=0)
        label.get_style_context().add_class("metric")
        return label

    def small_text(self, text: str) -> Gtk.Label:
        label = Gtk.Label(label=str(text), xalign=0)
        label.set_line_wrap(True)
        label.get_style_context().add_class("muted")
        return label

    def pill(self, text: str, style: str = "") -> Gtk.Label:
        label = Gtk.Label(label=str(text), xalign=0)
        label.get_style_context().add_class("pill")
        if style:
            label.get_style_context().add_class(style)
        return label

    def button(self, label: str, callback) -> Gtk.Button:
        button = Gtk.Button(label=label)
        button.connect("clicked", callback)
        return button

    def run(self) -> None:
        self.window.show_all()
        Gtk.main()


def main(argv: list[str]) -> int:
    if "--probe" in argv:
        project = "." if len(argv) == 1 else next((item for item in argv if item != "--probe"), ".")
        payload = run_json([str(ROOT / "bin/seven-forge"), "project", project, "--json"], {"state": "unknown"})
        ports = payload.get("ports") if isinstance(payload.get("ports"), dict) else {}
        extensions = payload.get("extensions") if isinstance(payload.get("extensions"), dict) else {}
        services = payload.get("services") if isinstance(payload.get("services"), dict) else {}
        readiness = payload.get("readiness") if isinstance(payload.get("readiness"), dict) else {}
        print(json.dumps({
            "schema": "sevenos.forge.native.probe.v1",
            "ready": payload.get("schema") == "sevenos.forge.center.v1",
            "state": payload.get("state", "unknown"),
            "readiness": readiness.get("state", "unknown"),
            "readiness_score": readiness.get("score", 0),
            "root": str(ROOT),
            "project": (payload.get("project") or {}).get("name", "unknown"),
            "services": services.get("total", 0),
            "ports": ports.get("count", 0),
            "extensions": extensions.get("count", 0),
        }, indent=2))
        return 0
    project = argv[0] if argv else "."
    ForgeCenter(project).run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
