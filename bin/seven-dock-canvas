def effective_pinned(config: dict[str, object], profile: str) -> list[str]:
    profile_pins = config.get("profile_pins", {})
    if isinstance(profile_pins, dict) and isinstance(profile_pins.get(profile), list):
        base = [str(item) for item in profile_pins.get(profile, [])]
    else:
        base = list(PROFILE_PINNED.get(profile, PROFILE_PINNED["equinox"]))
    for item in config.get("pinned", []):
        item = str(item)
        if item not in base:
            base.append(item)
    return list(dict.fromkeys(base))


def make_tiles(config: dict[str, object], profile: str, grouped: dict[str, list[dict[str, object]]]) -> list[dict[str, object]]:
    items = catalog()
    ids = [item for item in effective_pinned(config, profile) if item in items]
    for live_id in grouped:
        if live_id in items and live_id not in ids:
            ids.append(live_id)
    ids += ["|"]
    ids += [item for item in config.get("folders", []) if item in items]
    ids += ["|"]
    if bool(config.get("edit_mode", False)) and "add" in items:
        ids.append("add")
    for item in ("trash", "settings"):
        if item in items and item not in ids:
            ids.append(item)
    tiles: list[dict[str, object]] = []
    for tile_id in ids:
        if tile_id == "|":
            tiles.append({"id": "|", "separator": True})
            continue
        tile = dict(items[tile_id])
        windows = grouped.get(tile_id, [])
        tile["windows"] = windows
        tile["window_count"] = len(windows)
        tile["active"] = any(int(client.get("focusHistoryID", 9999) or 9999) == 0 for client in windows)
        tile["badge_count"] = trash_count() if tile_id == "trash" else 0
        tiles.append(tile)
    return tiles


def write_state(
    pid: int,
    profile: str,
    width: int,
    height: int,
    layer_shell: bool,
    reserve_space: bool,
    fullscreen_behavior: str,
    fullscreen_soft_hide: bool,
    fullscreen_dim: bool,
    edit_mode: bool,
) -> None:
    try:
        RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
        STATE_PATH.write_text(json.dumps({
            "schema": "sevenos.dock.runtime.v1",
            "kind": "canvas",
            "pid": pid,
            "profile": profile,
            "policy": "visible-on-all-workspaces-until-profile-change",
            "layer_shell": layer_shell,
            "reserve_space": reserve_space,
            "fullscreen_behavior": fullscreen_behavior,
            "fullscreen_soft_hide": fullscreen_soft_hide,
            "fullscreen_dim": fullscreen_dim,
            "edit_mode": edit_mode,
            "width": width,
            "height": height,
            "exclusive_zone": height + DOCK_MARGIN + 8 if reserve_space else 0,
        }, indent=2), encoding="utf-8")
    except OSError:
        pass


def clear_state() -> None:
    try:
        STATE_PATH.unlink()
    except OSError:
        pass


def probe() -> int:
    ensure_gi_python()
    try:
        import cairo  # noqa: F401
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import Gtk  # noqa: F401
    except Exception as exc:
        print(f"MISS: {exc}", file=sys.stderr)
        return 1
    print("OK")
    return 0


def rounded_rect(cr, x: float, y: float, w: float, h: float, r: float) -> None:
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def prism_tile_path(cr, x: float, y: float, w: float, h: float, cut: float | None = None) -> None:
    cut = min(cut if cut is not None else w * 0.18, w * 0.28, h * 0.28)
    cr.new_path()
    cr.move_to(x + cut, y)
    cr.line_to(x + w - cut, y)
    cr.line_to(x + w, y + cut)
    cr.line_to(x + w, y + h - cut)
    cr.line_to(x + w - cut, y + h)
    cr.line_to(x + cut, y + h)
    cr.line_to(x, y + h - cut)
    cr.line_to(x, y + cut)
    cr.close_path()


def mix(color: tuple[float, float, float], amount: float) -> tuple[float, float, float]:
    return tuple(min(1.0, c + (1.0 - c) * amount) for c in color)


def darken(color: tuple[float, float, float], amount: float) -> tuple[float, float, float]:
    return tuple(max(0.0, c * (1.0 - amount)) for c in color)


def ease_out_cubic(value: float) -> float:
    value = max(0.0, min(1.0, value))
    return 1.0 - pow(1.0 - value, 3)


class CanvasDock:
    def __init__(self):
        ensure_gi_python()
        import gi

        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import Gdk, GdkPixbuf, GLib, Gtk

        self.Gdk = Gdk
        self.GdkPixbuf = GdkPixbuf
        self.GLib = GLib
        self.Gtk = Gtk
        self.config = load_config()
        self.profile = active_profile_key()
        self.clients = hyprland_clients()
        self.focused_fullscreen = focused_fullscreen_client(self.clients)
        self.grouped = clients_by_tile(self.clients)
        self.tiles = make_tiles(self.config, self.profile, self.grouped)
        self.pointer_x: float | None = None
        self.scales = [0.0 for _ in self.tiles]
        self.targets = [0.0 for _ in self.tiles]
        self.velocities = [0.0 for _ in self.tiles]
        self.rects: list[tuple[float, float, float, float]] = []
        self.visual_rects: list[tuple[float, float, float, float]] = []
        self.hover_index: int | None = None
        self.hover_started = 0.0
        self.hide_at: float | None = None
        self.press_index: int | None = None
        self.press_xy: tuple[float, float] | None = None
        self.dragging = False
        self.bounces: dict[int, float] = {}
        self.preview = None
        self.hover_label = None
        self.tip_key: str | None = None
        self.icon_cache: dict[tuple[str, int], object] = {}
        self.theme = Gtk.IconTheme.get_default()
        self.mon_w, self.mon_h = monitor_bounds()
        self.width = self.compute_width()
        self.height = DOCK_HEIGHT
        self.layer_shell = False
        self.edit_mode = bool(self.config.get("edit_mode", False))
        self.fullscreen_behavior = str(self.config.get("fullscreen_behavior", "smart-hide") or "smart-hide")
        self.fullscreen_soft_hide = bool(self.focused_fullscreen) and self.fullscreen_behavior == "smart-hide"
        self.fullscreen_dim = bool(self.focused_fullscreen) and self.fullscreen_behavior == "dim"
        self.autohide = bool(self.config.get("autohide", False)) or self.fullscreen_soft_hide
        self.reserve_space = bool(self.config.get("reserve_space", True)) and not self.autohide
        self.hide_delay = clamp_float(self.config.get("autohide_delay", HIDE_DELAY), 0.5, 8.0)
        self.effect = normalize_effect(self.config.get("effect") or ("magnetic" if self.config.get("magnification", True) else "none"))
        self.effect_strength = {"magnetic": 1.0, "gentle": 0.72, "none": 0.0}.get(self.effect, 1.0)
        self.magnification_enabled = self.effect != "none" and bool(self.config.get("magnification", True))
        self.layer_shell_api = None
        self.revealed = not self.autohide
        self.reveal_target = 1.0 if self.revealed else 0.0
        self.reveal_progress = self.reveal_target

        GLib.set_prgname("SevenDockCanvas")
        GLib.set_application_name("Seven Dock")
        try:
            Gdk.set_program_class("SevenDockCanvas")
        except Exception:
            pass

        self.window = Gtk.Window(title="Seven Dock")
        self.window.set_decorated(False)
        self.window.set_resizable(False)
        self.window.set_default_size(self.width, self.height)
        self.window.set_size_request(self.width, self.height)
        self.window.set_app_paintable(True)
        self.window.set_accept_focus(False)
        self.window.set_focus_on_map(False)
        self.window.set_keep_above(True)
        self.window.set_skip_taskbar_hint(True)
        self.window.set_skip_pager_hint(True)
        self.window.set_wmclass("SevenDockCanvas", "SevenDockCanvas")
        try:
            visual = self.window.get_screen().get_rgba_visual()
            if visual is not None:
                self.window.set_visual(visual)
        except Exception:
            pass
        self.install_css()

        self.area = Gtk.DrawingArea()
        self.area.set_size_request(self.width, self.height)
        self.area.add_events(
            Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
            | Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.SCROLL_MASK
            | Gdk.EventMask.ENTER_NOTIFY_MASK
        )
        self.area.connect("draw", self.on_draw)
        self.area.connect("motion-notify-event", self.on_motion)
        self.area.connect("enter-notify-event", self.on_enter)
        self.area.connect("leave-notify-event", self.on_leave)
        self.area.connect("button-press-event", self.on_button_press)
        self.area.connect("button-release-event", self.on_button_release)
        self.area.connect("scroll-event", self.on_scroll)
        self.window.add(self.area)
        self.place_window()
        self.window.connect("destroy", lambda *_: (clear_state(), Gtk.main_quit()))
        GLib.timeout_add(FRAME_MS, self.animate)
        GLib.timeout_add_seconds(2, self.refresh_clients)

    def compute_width(self) -> int:
        tile_count = sum(1 for tile in self.tiles if not tile.get("separator"))
        sep_count = sum(1 for tile in self.tiles if tile.get("separator"))
        natural = PADDING_X * 2 + tile_count * BASE_TILE + max(0, tile_count - 1) * GAP + sep_count * SEP
        return int(min(max(300, natural), self.mon_w - DOCK_MARGIN * 2))

    def place_window(self) -> None:
        try:
            import gi as _gi

            _gi.require_version("GtkLayerShell", "0.1")
            from gi.repository import GtkLayerShell

            self.layer_shell_api = GtkLayerShell
            GtkLayerShell.init_for_window(self.window)
            if hasattr(GtkLayerShell, "set_namespace"):
                GtkLayerShell.set_namespace(self.window, "sevenos-dock")
            layer = GtkLayerShell.Layer.TOP if self.reserve_space else GtkLayerShell.Layer.OVERLAY
            GtkLayerShell.set_layer(self.window, layer)
            GtkLayerShell.set_anchor(self.window, GtkLayerShell.Edge.BOTTOM, True)
            GtkLayerShell.set_anchor(self.window, GtkLayerShell.Edge.LEFT, False)
            GtkLayerShell.set_anchor(self.window, GtkLayerShell.Edge.RIGHT, False)
            GtkLayerShell.set_margin(self.window, GtkLayerShell.Edge.BOTTOM, DOCK_MARGIN)
            GtkLayerShell.set_exclusive_zone(self.window, DOCK_HEIGHT + DOCK_MARGIN + 8 if self.reserve_space else 0)
            GtkLayerShell.set_keyboard_interactivity(self.window, False)
            self.layer_shell = True
        except Exception:
            self.window.move(max(0, int((self.mon_w - self.width) / 2)), max(0, self.mon_h - self.height - DOCK_MARGIN))

    def run(self) -> int:
        self.window.show_all()
        if self.autohide:
            self.set_revealed(False, immediate=True)
        elif self.fullscreen_dim:
            self.window.set_opacity(0.42)
        write_state(
            os.getpid(),
            self.profile,
            self.width,
            self.height,
            self.layer_shell,
            self.reserve_space,
            self.fullscreen_behavior,
            self.fullscreen_soft_hide,
            self.fullscreen_dim,
            self.edit_mode,
        )
        self.Gtk.main()
        return 0

    def set_revealed(self, revealed: bool, immediate: bool = False) -> None:
        self.revealed = revealed
        self.reveal_target = 1.0 if revealed else 0.0
        if immediate:
            self.reveal_progress = self.reveal_target
            self.apply_reveal()

    def apply_reveal(self) -> None:
        if self.layer_shell_api is not None:
            try:
                hidden_margin = -(DOCK_HEIGHT - HIDDEN_PEEK)
                margin = int(hidden_margin + (DOCK_MARGIN - hidden_margin) * ease_out_cubic(self.reveal_progress))
                self.layer_shell_api.set_margin(self.window, self.layer_shell_api.Edge.BOTTOM, margin)
            except Exception:
                pass
        base_opacity = 0.42 if self.fullscreen_dim and not self.autohide else 0.68
        self.window.set_opacity(base_opacity + (1.0 - base_opacity) * ease_out_cubic(self.reveal_progress))

    def refresh_clients(self) -> bool:
        self.clients = hyprland_clients()
        self.focused_fullscreen = focused_fullscreen_client(self.clients)
        self.fullscreen_dim = bool(self.focused_fullscreen) and self.fullscreen_behavior == "dim"
        if not self.autohide:
            self.window.set_opacity(0.42 if self.fullscreen_dim else 1.0)
        self.grouped = clients_by_tile(self.clients)
        old_ids = [tile.get("id") for tile in self.tiles]
        self.tiles = make_tiles(self.config, self.profile, self.grouped)
        if [tile.get("id") for tile in self.tiles] != old_ids:
            self.scales = [0.0 for _ in self.tiles]
            self.targets = [0.0 for _ in self.tiles]
            self.velocities = [0.0 for _ in self.tiles]
            self.visual_rects = []
        self.area.queue_draw()
        return True

    def install_css(self) -> None:
        provider = self.Gtk.CssProvider()
        provider.load_from_data(
            b"""
            window.dock-canvas-tip {
              background: rgba(17, 19, 29, 0.92);
              color: rgba(247, 250, 255, 0.96);
              border: 1px solid rgba(135, 150, 255, 0.28);
              border-radius: 18px;
            }
            window.dock-canvas-tip label {
              color: rgba(247, 250, 255, 0.96);
              font-size: 12px;
              font-weight: 500;
            }
            .dock-canvas-title {
              font-size: 13px;
              font-weight: 500;
              color: rgba(255, 255, 255, 0.98);
            }
            .dock-canvas-meta {
              font-size: 11px;
              color: rgba(204, 214, 236, 0.78);
            }
            .dock-canvas-preview {
              min-width: 220px;
            }
            .dock-canvas-action-row {
              margin-top: 2px;
            }
            .dock-canvas-secondary {
              color: rgba(221, 228, 245, 0.90);
            }
            .dock-canvas-danger {
              color: rgba(255, 210, 216, 0.98);
              border-color: rgba(255, 120, 136, 0.26);
            }
            window.dock-canvas-tip button {
              background: rgba(255, 255, 255, 0.075);
              border: 1px solid rgba(255, 255, 255, 0.10);
              border-radius: 11px;
              color: rgba(247, 250, 255, 0.96);
              padding: 8px 11px;
            }
            window.dock-canvas-tip button:hover {
              background: rgba(105, 135, 255, 0.32);
              border-color: rgba(150, 170, 255, 0.42);
            }
            """
        )
        self.Gtk.StyleContext.add_provider_for_screen(
            self.Gdk.Screen.get_default(),
            provider,
            self.Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    def draw_icon(self, cr, tile: dict[str, object], x: float, y: float, size: int) -> None:
        if self.draw_seven_glyph(cr, str(tile.get("id", "")), x, y, size):
            return
        key = (str(tile.get("icon", "")), size)
        pixbuf = self.icon_cache.get(key)
        if pixbuf is None:
            try:
                pixbuf = self.theme.load_icon(str(tile.get("icon", "")), size, 0)
            except Exception:
                pixbuf = None
            self.icon_cache[key] = pixbuf
        if pixbuf is not None:
            self.Gdk.cairo_set_source_pixbuf(cr, pixbuf, x, y)
            cr.paint()

    def draw_seven_glyph(self, cr, tile_id: str, x: float, y: float, size: int) -> bool:
        glyphs = {"files", "apps", "browser", "terminal", "spotlight", "hub", "downloads", "home", "trash", "settings", "add"}
        if tile_id not in glyphs:
            return False
        cx = x + size / 2
        cy = y + size / 2
        s = size
        cr.save()
        cr.set_line_width(max(1.8, s * 0.075))
        cr.set_line_cap(1)
        cr.set_line_join(1)
        cr.set_source_rgba(0.96, 0.98, 1.0, 0.94)
        if tile_id in {"files", "downloads"}:
            rounded_rect(cr, x + s * 0.12, y + s * 0.28, s * 0.76, s * 0.50, s * 0.10)
            cr.stroke()
            cr.move_to(x + s * 0.18, y + s * 0.30)
            cr.line_to(x + s * 0.34, y + s * 0.18)
            cr.line_to(x + s * 0.50, y + s * 0.30)
            cr.stroke()
            if tile_id == "downloads":
                cr.move_to(cx, y + s * 0.34)
                cr.line_to(cx, y + s * 0.62)
                cr.move_to(cx - s * 0.12, y + s * 0.51)
                cr.line_to(cx, y + s * 0.64)
                cr.line_to(cx + s * 0.12, y + s * 0.51)
                cr.stroke()
        elif tile_id == "apps":
            for row in range(3):
                for col in range(3):
                    cr.arc(x + s * (0.26 + col * 0.24), y + s * (0.26 + row * 0.24), s * 0.045, 0, math.tau)
                    cr.fill()
        elif tile_id == "browser":
            cr.arc(cx, cy, s * 0.34, 0, math.tau)
            cr.stroke()
            cr.move_to(cx - s * 0.14, cy + s * 0.14)
            cr.line_to(cx + s * 0.18, cy - s * 0.18)
            cr.stroke()
            cr.arc(cx + s * 0.18, cy - s * 0.18, s * 0.045, 0, math.tau)
            cr.fill()
        elif tile_id == "terminal":
            rounded_rect(cr, x + s * 0.14, y + s * 0.22, s * 0.72, s * 0.56, s * 0.11)
            cr.stroke()
            cr.move_to(x + s * 0.28, cy - s * 0.07)
            cr.line_to(x + s * 0.40, cy)
            cr.line_to(x + s * 0.28, cy + s * 0.07)
            cr.stroke()
            cr.move_to(x + s * 0.48, cy + s * 0.08)
            cr.line_to(x + s * 0.66, cy + s * 0.08)
            cr.stroke()
        elif tile_id == "spotlight":
            cr.arc(cx - s * 0.05, cy - s * 0.05, s * 0.22, 0, math.tau)
            cr.stroke()
            cr.move_to(cx + s * 0.12, cy + s * 0.12)
            cr.line_to(cx + s * 0.28, cy + s * 0.28)
            cr.stroke()
        elif tile_id == "hub":
            for angle in (math.pi / 6, math.pi * 5 / 6, math.pi * 3 / 2):
                cr.move_to(cx, cy)
                cr.line_to(cx + math.cos(angle) * s * 0.28, cy + math.sin(angle) * s * 0.28)
            cr.stroke()
            for angle in (math.pi / 6, math.pi * 5 / 6, math.pi * 3 / 2):
                cr.arc(cx + math.cos(angle) * s * 0.30, cy + math.sin(angle) * s * 0.30, s * 0.065, 0, math.tau)
                cr.fill()
            cr.arc(cx, cy, s * 0.075, 0, math.tau)
            cr.fill()
        elif tile_id == "home":
            cr.move_to(x + s * 0.18, cy)
            cr.line_to(cx, y + s * 0.22)
            cr.line_to(x + s * 0.82, cy)
            cr.stroke()
            rounded_rect(cr, x + s * 0.28, cy - s * 0.02, s * 0.44, s * 0.34, s * 0.06)
            cr.stroke()
        elif tile_id == "trash":
            cr.move_to(x + s * 0.28, y + s * 0.30)
            cr.line_to(x + s * 0.72, y + s * 0.30)
            cr.stroke()
            rounded_rect(cr, x + s * 0.32, y + s * 0.36, s * 0.36, s * 0.40, s * 0.06)
            cr.stroke()
            cr.move_to(x + s * 0.40, y + s * 0.46)
            cr.line_to(x + s * 0.40, y + s * 0.66)
            cr.move_to(x + s * 0.60, y + s * 0.46)
            cr.line_to(x + s * 0.60, y + s * 0.66)
            cr.stroke()
        elif tile_id == "settings":
            cr.arc(cx, cy, s * 0.21, 0, math.tau)
            cr.stroke()
            for idx in range(8):
                angle = idx * math.tau / 8
                cr.move_to(cx + math.cos(angle) * s * 0.29, cy + math.sin(angle) * s * 0.29)
                cr.line_to(cx + math.cos(angle) * s * 0.37, cy + math.sin(angle) * s * 0.37)
            cr.stroke()
            cr.arc(cx, cy, s * 0.055, 0, math.tau)
            cr.fill()
        elif tile_id == "add":
            cr.move_to(cx - s * 0.22, cy)
            cr.line_to(cx + s * 0.22, cy)
            cr.move_to(cx, cy - s * 0.22)
            cr.line_to(cx, cy + s * 0.22)
            cr.stroke()
        cr.restore()
        return True

    def on_draw(self, _area, cr) -> bool:
        dark = current_theme_mode() != "light"
        shell_y = 9
        shell_h = self.height - 16
        rounded_rect(cr, 5, shell_y + 5, self.width - 10, shell_h - 1, 24)
        cr.set_source_rgba(0.0, 0.0, 0.0, 0.20 if dark else 0.10)
        cr.fill()
        rounded_rect(cr, 1.5, shell_y + 0.5, self.width - 3, shell_h - 1, 24)
        if dark:
            gradient = self.cairo_linear(cr, 0, shell_y, 0, shell_y + shell_h, [(0, (0.23, 0.25, 0.34, 0.72)), (0.48, (0.13, 0.14, 0.20, 0.68)), (1, (0.05, 0.06, 0.09, 0.72))])
            cr.set_source(gradient)
        else:
            gradient = self.cairo_linear(cr, 0, shell_y, 0, shell_y + shell_h, [(0, (0.96, 0.98, 1.00, 0.86)), (0.52, (0.84, 0.90, 0.98, 0.76)), (1, (0.74, 0.82, 0.94, 0.70))])
            cr.set_source(gradient)
        cr.fill_preserve()
        cr.set_source_rgba(*(0.95, 0.97, 1.0, 0.24) if dark else (0.12, 0.15, 0.22, 0.10))
        cr.set_line_width(1)
        cr.stroke()
        if self.autohide and self.reveal_progress < 0.32:
            handle_w = 74
            handle_h = 4
            rounded_rect(cr, self.width / 2 - handle_w / 2, 4, handle_w, handle_h, 2)
            cr.set_source_rgba(*(0.85, 0.90, 1.0, 0.44) if dark else (0.15, 0.18, 0.26, 0.34))
            cr.fill()
        if self.edit_mode:
            rounded_rect(cr, self.width / 2 - 64, shell_y - 3, 128, 18, 9)
            cr.set_source_rgba(0.42, 0.52, 1.0, 0.24 if dark else 0.18)
            cr.fill_preserve()
            cr.set_source_rgba(0.72, 0.78, 1.0, 0.38)
            cr.set_line_width(1)
            cr.stroke()
            cr.set_source_rgba(*(0.95, 0.97, 1.0, 0.78) if dark else (0.12, 0.15, 0.22, 0.72))
            cr.select_font_face("Sans")
            cr.set_font_size(9)
            label = tr("Modifier le Dock", "Edit Dock")
            ext = cr.text_extents(label)
            cr.move_to(self.width / 2 - ext.width / 2 - ext.x_bearing, shell_y + 9 - ext.height / 2 - ext.y_bearing)
            cr.show_text(label)

        self.rects = []
        self.visual_rects = []
        x = PADDING_X
        center_y = self.height / 2 + 1
        for index, tile in enumerate(self.tiles):
            if tile.get("separator"):
                cr.set_source_rgba(*(0.95, 0.97, 1.0, 0.16) if dark else (0.12, 0.15, 0.22, 0.14))
                cr.rectangle(x + SEP / 2, center_y - 17, 1, 34)
                cr.fill()
                self.rects.append((x, 0, SEP, self.height))
                self.visual_rects.append((x, 0, SEP, self.height))
                x += SEP
                continue
            scale = self.scales[index]
            lifted = ease_out_cubic(scale)
            bounce = self.bounce_offset(index)
            hover_pulse = 0.0
            if self.hover_index == index:
                hover_pulse = 0.5 + 0.5 * math.sin(time.monotonic() * 4.6)
            tile_size = BASE_TILE + (MAX_TILE - BASE_TILE) * lifted
            icon_size = int(BASE_ICON + (MAX_ICON - BASE_ICON) * lifted)
            tile_x = x - (tile_size - BASE_TILE) / 2
            tile_y = center_y - tile_size / 2 - 6 * lifted - bounce
            icon_x = tile_x + (tile_size - icon_size) / 2
            icon_y = tile_y + (tile_size - icon_size) / 2
            color = tile.get("style", (0.4, 0.5, 0.7))
            c1 = mix(color, 0.42 if not dark else 0.18)
            c2 = darken(color, 0.16)

            prism_tile_path(cr, tile_x + 5, tile_y + tile_size - 3, tile_size - 10, 8, 2.6)
            cr.set_source_rgba(0.0, 0.0, 0.0, 0.22 + 0.14 * lifted)
            cr.fill()

            if tile.get("active") or lifted > 0.10:
                halo_pad = 3.0 + 3.0 * lifted
                prism_tile_path(cr, tile_x - halo_pad, tile_y - halo_pad, tile_size + halo_pad * 2, tile_size + halo_pad * 2, 10 + 4 * lifted)
                cr.set_source_rgba(*(*mix(color, 0.12), 0.24 + 0.24 * lifted + 0.07 * hover_pulse))
                cr.fill()
                prism_tile_path(cr, tile_x - halo_pad + 2.2, tile_y - halo_pad + 2.2, tile_size + (halo_pad - 2.2) * 2, tile_size + (halo_pad - 2.2) * 2, 8 + 3 * lifted)
                cr.set_source_rgba(1.0, 1.0, 1.0, 0.05 + 0.08 * lifted)
                cr.fill()
            if tile.get("active"):
                rounded_rect(cr, tile_x + 7, shell_y + shell_h - 9, tile_size - 14, 3.2, 1.6)
                cr.set_source_rgba(*(*mix(color, 0.28), 0.84))
                cr.fill()
            prism_tile_path(cr, tile_x, tile_y, tile_size, tile_size, 8 + 4 * lifted)
            cr.set_source(self.cairo_linear(cr, tile_x, tile_y, tile_x, tile_y + tile_size, [
                (0, (*mix(color, 0.46 if dark else 0.62), 0.92 if dark else 0.94)),
                (0.48, (*mix(color, 0.08 if dark else 0.28), 0.78 if dark else 0.84)),
                (1, (*darken(color, 0.36 if dark else 0.16), 0.86 if dark else 0.90)),
            ]))
            cr.fill_preserve()
            cr.set_source_rgba(*(0.94, 0.97, 1.0, 0.34 + 0.24 * lifted) if dark else (0.10, 0.14, 0.20, 0.20 + 0.16 * lifted))
            cr.set_line_width(1.0 + 0.35 * lifted)
            cr.stroke()
            cr.save()
            prism_tile_path(cr, tile_x, tile_y, tile_size, tile_size, 8 + 4 * lifted)
            cr.clip()
            cr.move_to(tile_x + tile_size * 0.16, tile_y)
            cr.line_to(tile_x + tile_size * 0.52, tile_y + tile_size * 0.46)
            cr.line_to(tile_x, tile_y + tile_size * 0.78)
            cr.close_path()
            cr.set_source_rgba(1, 1, 1, (0.12 + 0.07 * lifted) if dark else (0.20 + 0.08 * lifted))
            cr.fill()
            cr.move_to(tile_x + tile_size, tile_y + tile_size * 0.22)
            cr.line_to(tile_x + tile_size * 0.58, tile_y + tile_size * 0.58)
            cr.line_to(tile_x + tile_size, tile_y + tile_size)
            cr.close_path()
            cr.set_source_rgba(0, 0, 0, 0.10 if dark else 0.06)
            cr.fill()
            cr.move_to(tile_x + tile_size * 0.18, tile_y + tile_size * 0.18)
            cr.line_to(tile_x + tile_size * 0.82, tile_y + tile_size * 0.82)
            cr.set_source_rgba(1, 1, 1, 0.12 + 0.10 * lifted)
            cr.set_line_width(1)
            cr.stroke()
            cr.restore()
            rounded_rect(cr, tile_x + tile_size * 0.28, tile_y + tile_size - 4.4, tile_size * 0.44, 2.4, 1.2)
            cr.set_source_rgba(*(*mix(color, 0.22 if dark else 0.36), 0.64 if tile.get("active") else 0.34 + 0.20 * lifted))
            cr.fill()
            self.draw_icon(cr, tile, icon_x, icon_y, icon_size)
            if self.edit_mode and self.customizable_tile(tile):
                self.draw_edit_handle(cr, tile_x + 6, tile_y + 6, dark)
            if tile.get("window_count"):
                self.draw_running_indicator(cr, tile_x + tile_size / 2, shell_y + shell_h - 9, int(tile.get("window_count", 1) or 1), dark)
            if int(tile.get("window_count", 0) or 0) > 1:
                self.draw_badge(cr, tile_x + tile_size - 9, tile_y + 5, str(min(99, int(tile["window_count"]))), "window")
            elif int(tile.get("badge_count", 0) or 0) > 0:
                self.draw_badge(cr, tile_x + tile_size - 9, tile_y + 5, str(min(99, int(tile["badge_count"]))), str(tile.get("id") or "status"))
            self.rects.append((x, 0, BASE_TILE, self.height))
            self.visual_rects.append((tile_x, tile_y, tile_size, tile_size))
            x += BASE_TILE + GAP
        return False

    def draw_running_indicator(self, cr, cx: float, cy: float, count: int, dark: bool) -> None:
        count = max(1, min(3, count))
        start = cx - ((count - 1) * 6) / 2
        for idx in range(count):
            cr.set_source_rgba(*(0.95, 0.97, 1.0, 0.88) if dark else (0.12, 0.15, 0.22, 0.72))
            cr.arc(start + idx * 6, cy, 2.2, 0, math.tau)
            cr.fill()

    def draw_edit_handle(self, cr, cx: float, cy: float, dark: bool) -> None:
        cr.set_source_rgba(*(0.12, 0.14, 0.22, 0.70) if dark else (1.0, 1.0, 1.0, 0.78))
        cr.arc(cx, cy, 5.2, 0, math.tau)
        cr.fill_preserve()
        cr.set_source_rgba(0.55, 0.64, 1.0, 0.85)
        cr.set_line_width(1)
        cr.stroke()
        cr.set_source_rgba(0.55, 0.64, 1.0, 0.92)
        cr.arc(cx, cy, 1.55, 0, math.tau)
        cr.fill()

    def draw_badge(self, cr, cx: float, cy: float, text: str, kind: str = "status") -> None:
        radius = 8.5
        colors = {
            "window": (0.36, 0.50, 1.0),
            "trash": (0.56, 0.60, 0.68),
            "hub": (0.38, 0.64, 1.0),
            "status": (0.32, 0.52, 0.96),
        }
        color = colors.get(kind, colors["status"])
        cr.set_source_rgba(0.02, 0.03, 0.06, 0.34)
        cr.arc(cx + 0.8, cy + 1.2, radius + 1.5, 0, math.tau)
        cr.fill()
        cr.set_source_rgba(*color, 0.96)
        cr.arc(cx, cy, radius, 0, math.tau)
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.32)
        cr.set_line_width(1)
        cr.stroke()
        cr.set_source_rgba(1, 1, 1, 0.96)
        cr.select_font_face("Sans")
        cr.set_font_size(9)
        ext = cr.text_extents(text)
        cr.move_to(cx - ext.width / 2 - ext.x_bearing, cy - ext.height / 2 - ext.y_bearing)
        cr.show_text(text)

    @staticmethod
    def cairo_linear(cr, x0, y0, x1, y1, stops):
        import cairo

        gradient = cairo.LinearGradient(x0, y0, x1, y1)
        for offset, color in stops:
            gradient.add_color_stop_rgba(offset, *color)
        return gradient

    def tile_at(self, x: float, y: float) -> int | None:
        for index, (rx, ry, rw, rh) in enumerate(self.rects):
            if rx <= x <= rx + rw and ry <= y <= ry + rh and not self.tiles[index].get("separator"):
                return index
        return None

    def update_targets(self, x_root: float) -> None:
        if not self.magnification_enabled:
            self.targets = [0.0 for _ in self.tiles]
            return
        for index, tile in enumerate(self.tiles):
            if tile.get("separator"):
                self.targets[index] = 0.0
                continue
            rx, _ry, rw, _rh = self.rects[index]
            wx, _wy = self.widget_origin(self.area)
            center = wx + rx + rw / 2
            distance = abs(x_root - center)
            scale = math.exp(-((distance * distance) / (2 * SIGMA * SIGMA)))
            self.targets[index] = 0.0 if scale < 0.14 else scale * self.effect_strength

    def animate(self) -> bool:
        moving = False
        now = time.monotonic()
        if abs(self.reveal_progress - self.reveal_target) > 0.002:
            self.reveal_progress += (self.reveal_target - self.reveal_progress) * REVEAL_SPEED
            if abs(self.reveal_progress - self.reveal_target) < 0.01:
                self.reveal_progress = self.reveal_target
            self.apply_reveal()
            moving = True
        if self.hide_at is not None and now >= self.hide_at:
            self.hide_at = None
            if self.autohide:
                self.set_revealed(False)
                self.close_preview()
                self.close_label()
                moving = True
        for index, started in list(self.bounces.items()):
            if now - started >= BOUNCE_DURATION:
                self.bounces.pop(index, None)
                moving = True
        for index, target in enumerate(self.targets):
            current = self.scales[index]
            velocity = (self.velocities[index] + (target - current) * SPRING_PULL) * SPRING_DAMPING
            next_scale = current + velocity
            if abs(next_scale - target) < 0.006 and abs(velocity) < 0.006:
                next_scale = target
                velocity = 0.0
            if abs(next_scale - current) > 0.001:
                moving = True
            self.scales[index] = next_scale
            self.velocities[index] = velocity
        if moving or self.bounces or self.hover_index is not None:
            self.area.queue_draw()
        return True

    def bounce_offset(self, index: int) -> float:
        started = self.bounces.get(index)
        if started is None:
            return 0.0
        progress = max(0.0, min(1.0, (time.monotonic() - started) / BOUNCE_DURATION))
        return max(0.0, math.sin(progress * math.tau * 1.6) * (1.0 - progress) * 9.0)

    def on_enter(self, *_args) -> bool:
        self.hide_at = None
        if self.autohide:
            self.set_revealed(True)
        return False

    def on_motion(self, _area, event) -> bool:
        self.update_targets(float(event.x_root))
        index = self.tile_at(float(event.x), float(event.y))
        if index != self.hover_index:
            self.hover_index = index
            self.hover_started = time.monotonic()
            self.close_preview()
            self.close_label()
        if self.autohide and not self.revealed:
            self.set_revealed(True)
        self.hide_at = None
        if self.press_index is not None and self.press_xy is not None:
            dx = float(event.x) - self.press_xy[0]
            dy = float(event.y) - self.press_xy[1]
            if abs(dx) + abs(dy) > DRAG_THRESHOLD:
                self.dragging = True
                self.close_preview()
                self.close_label()
                return True
        if index is not None:
            if time.monotonic() - self.hover_started < PREVIEW_DELAY:
                return False
            tile = self.tiles[index]
            windows = tile.get("windows", [])
            if windows:
                self.show_preview(tile, windows)
            else:
                self.show_label(tile)
        return False

    def on_leave(self, *_args) -> bool:
        self.targets = [0.0 for _ in self.tiles]
        self.hover_index = None
        self.press_index = None
        self.press_xy = None
        self.dragging = False
        if self.autohide:
            self.hide_at = time.monotonic() + self.hide_delay
        return False

    def on_button_press(self, _area, event) -> bool:
        index = self.tile_at(float(event.x), float(event.y))
        if index is None:
            return False
        tile = self.tiles[index]
        if int(getattr(event, "button", 0) or 0) == 1:
            self.press_index = index
            self.press_xy = (float(event.x), float(event.y))
            self.dragging = False
            return True
        if int(getattr(event, "button", 0) or 0) == 2:
            self.bounces[index] = time.monotonic()
            run_action([str(part) for part in tile.get("command", [])])
            return True
        if int(getattr(event, "button", 0) or 0) == 3:
            self.hover_index = index
            self.show_context_menu(tile, tile.get("windows", []))
            return True
        return False

    def on_button_release(self, _area, event) -> bool:
        index = self.tile_at(float(event.x), float(event.y))
        source_index = self.press_index
        self.press_index = None
        self.press_xy = None
        if int(getattr(event, "button", 0) or 0) != 1 or source_index is None:
            self.dragging = False
            return False
        if self.dragging:
            self.dragging = False
            if index is not None and index != source_index:
                self.move_tile(source_index, index)
            return True
        self.dragging = False
        if index is None:
            return False
        self.activate_tile(index)
        return True

    def activate_tile(self, index: int) -> None:
        tile = self.tiles[index]
        self.bounces[index] = time.monotonic()
        self.area.queue_draw()
        if tile.get("kind") == "folder":
            self.show_folder_stack(tile)
            return
        windows = tile.get("windows", [])
        if windows:
            windows = sorted(windows, key=lambda item: int(item.get("focusHistoryID", 9999) or 9999))
            focus_client(windows[0])
            return
        run_action([str(part) for part in tile.get("command", [])])

    def on_scroll(self, _area, event) -> bool:
        index = self.tile_at(float(event.x), float(event.y))
        if index is None:
            return False
        windows = self.tiles[index].get("windows", [])
        if not windows:
            return False
        windows = sorted(windows, key=lambda item: int(item.get("focusHistoryID", 9999) or 9999))
        direction = getattr(event, "direction", None)
        step = -1 if direction == self.Gdk.ScrollDirection.UP else 1
        target = windows[step % len(windows)]
        focus_client(target)
        return True

    def move_tile(self, source_index: int, target_index: int) -> None:
        if source_index >= len(self.tiles) or target_index >= len(self.tiles):
            return
        source = self.tiles[source_index]
        target = self.tiles[target_index]
        if source.get("separator") or target.get("separator"):
            return
        source_id = str(source.get("id"))
        target_id = str(target.get("id"))
        config = load_config()
        if source.get("kind") == "folder" and target.get("kind") == "folder":
            folders = [str(item) for item in config.get("folders", DEFAULT_CONFIG["folders"])]
            self.move_id(folders, source_id, target_id)
            config["folders"] = folders
        else:
            current = [
                str(tile.get("id"))
                for tile in self.tiles
                if not tile.get("separator") and tile.get("kind") != "folder" and str(tile.get("id")) not in {"settings", "trash"}
            ]
            self.move_id(current, source_id, target_id)
            profile_pins = config.get("profile_pins", {})
            if not isinstance(profile_pins, dict):
                profile_pins = {}
            profile_pins[self.profile] = current
            config["profile_pins"] = profile_pins
        save_config(config)
        self.config = load_config()
        self.refresh_clients()

    @staticmethod
    def move_id(items: list[str], source_id: str, target_id: str) -> None:
        if source_id not in items or target_id not in items:
            return
        item = items.pop(items.index(source_id))
        items.insert(items.index(target_id), item)

    def tip_box(self, spacing: int = 8):
        box = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=spacing)
        box.get_style_context().add_class("dock-canvas-preview")
        return box

    def tip_label(self, text: str, css_class: str = "dock-canvas-title"):
        label = self.Gtk.Label(label=text)
        label.set_xalign(0)
        label.set_line_wrap(True)
        label.set_max_width_chars(46)
        label.get_style_context().add_class(css_class)
        return label

    def tip_button(self, label: str, callback, css_class: str | None = None):
        button = self.Gtk.Button(label=label)
        button.set_relief(self.Gtk.ReliefStyle.NONE)
        button.get_child().set_xalign(0)
        button.get_style_context().add_class("dock-canvas-action-row")
        if css_class:
            button.get_style_context().add_class(css_class)
        button.connect("clicked", callback)
        return button

    def tile_meta(self, tile: dict[str, object], windows: list[dict[str, object]] | None = None) -> str:
        windows = windows or []
        if windows:
            count = len(windows)
            return tr(f"{count} fenêtre ouverte", f"{count} open window") if count == 1 else tr(f"{count} fenêtres ouvertes", f"{count} open windows")
        if tile.get("kind") == "folder":
            return tr("Pile de dossier", "Folder stack")
        if tile.get("id") == "trash":
            count = int(tile.get("badge_count", 0) or 0)
            return tr(f"{count} élément dans la corbeille", f"{count} item in Trash") if count == 1 else tr(f"{count} éléments dans la corbeille", f"{count} items in Trash")
        if tile.get("kind") == "system":
            return tr("Surface système SevenOS", "SevenOS system surface")
        return tr("Application prête", "Application ready")

    def customizable_tile(self, tile: dict[str, object]) -> bool:
        tile_id = str(tile.get("id") or "")
        return bool(tile_id) and not tile.get("separator") and tile.get("kind") != "folder" and tile_id not in {"settings", "trash", "add"}

    def tile_is_saved(self, tile: dict[str, object]) -> bool:
        tile_id = str(tile.get("id") or "")
        config = load_config()
        return tile_id in effective_pinned(config, self.profile)

    def profile_tile_ids_from_view(self) -> list[str]:
        ids: list[str] = []
        for tile in self.tiles:
            tile_id = str(tile.get("id") or "")
            if self.customizable_tile(tile) and tile_id not in ids:
                ids.append(tile_id)
        return ids

    def set_tile_saved(self, tile: dict[str, object], saved: bool) -> None:
        tile_id = str(tile.get("id") or "")
        if not tile_id:
            return
        config = load_config()
        profile_ids = self.profile_tile_ids_from_view()
        global_ids = [str(item) for item in config.get("pinned", [])]
        if saved:
            if tile_id not in profile_ids:
                profile_ids.append(tile_id)
        else:
            profile_ids = [item for item in profile_ids if item != tile_id]
            global_ids = [item for item in global_ids if item != tile_id]
        profile_pins = config.get("profile_pins", {})
        if not isinstance(profile_pins, dict):
            profile_pins = {}
        profile_pins[self.profile] = profile_ids
        config["profile_pins"] = profile_pins
        config["pinned"] = global_ids
        config["dock_layout_version"] = 2
        save_config(config)
        self.config = load_config()
        self.close_preview()
        self.close_label()
        self.refresh_clients()

    def dock_quick_controls(self):
        config = load_config()
        autohide = bool(config.get("autohide", self.autohide))
        effect = normalize_effect(config.get("effect") or self.effect)
        rows: list[tuple[str, list[str]]] = []
        edit_mode = bool(config.get("edit_mode", self.edit_mode))
        if edit_mode:
            rows.append((tr("Terminer la modification", "Done Editing"), ["seven-dock", "edit", "off"]))
        else:
            rows.append((tr("Modifier le Dock", "Edit Dock"), ["seven-dock", "edit", "on"]))
        if autohide:
            rows.append((tr("Toujours visible", "Keep Dock Visible"), ["seven-dock", "autohide", "off"]))
        else:
            rows.append((tr("Masquer automatiquement", "Auto-hide Dock"), ["seven-dock", "autohide", "on"]))
        if effect == "none":
            rows.append((tr("Activer l’effet doux", "Enable Gentle Effect"), ["seven-dock", "effect", "gentle"]))
        elif effect == "gentle":
            rows.append((tr("Essayer l’effet magnétique", "Try Magnetic Effect"), ["seven-dock", "effect", "magnetic"]))
        else:
            rows.append((tr("Calmer l’effet", "Calm Dock Effect"), ["seven-dock", "effect", "gentle"]))
        rows.append((tr("Relancer le Dock", "Restart Dock"), ["seven-dock", "restart"]))
        rows.append((tr("Réglages du Dock", "Dock Settings"), ["seven-settings", "dock"]))
        return rows

    def show_label(self, tile: dict[str, object]) -> None:
        key = f"label:{tile.get('id')}"
        if self.tip_key == key and self.hover_label is not None:
            return
        self.close_preview()
        self.close_label()
        self.tip_key = key
        box = self.tip_box(spacing=4)
        box.pack_start(self.tip_label(str(tile.get("title", "App"))), False, False, 0)
        box.pack_start(self.tip_label(self.tile_meta(tile), "dock-canvas-meta"), False, False, 0)
        self.hover_label = self.tooltip_window(box, self.hover_anchor())

    def show_preview(self, tile: dict[str, object], windows: list[dict[str, object]], force: bool = False) -> None:
        key = f"preview:{tile.get('id')}:{len(windows)}"
        if self.tip_key == key and self.preview is not None:
            return
        self.close_label()
        if not windows and not force:
            return
        self.close_preview()
        self.tip_key = key
        box = self.tip_box(spacing=7)
        box.pack_start(self.tip_label(str(tile.get("title", "App"))), False, False, 0)
        box.pack_start(self.tip_label(self.tile_meta(tile, windows), "dock-canvas-meta"), False, False, 0)
        if not windows:
            row = self.tip_label(tr("Aucune fenêtre ouverte", "No open windows"), "dock-canvas-meta")
            box.pack_start(row, False, False, 0)
        for client in sorted(windows, key=lambda item: int(item.get("focusHistoryID", 9999) or 9999))[:6]:
            label = str(client.get("title") or client.get("class") or tile.get("title", "Window"))
            if len(label) > 46:
                label = label[:43].rstrip() + "..."
            row = self.tip_button(label, lambda _row, selected=client: (focus_client(selected), self.close_preview()))
            box.pack_start(row, False, False, 0)
        self.preview = self.tooltip_window(box, self.hover_anchor())

    def show_context_menu(self, tile: dict[str, object], windows: list[dict[str, object]]) -> None:
        self.close_label()
        self.close_preview()
        self.tip_key = f"context:{tile.get('id')}:{len(windows)}"
        box = self.tip_box(spacing=8)
        box.pack_start(self.tip_label(str(tile.get("title", "App"))), False, False, 0)
        box.pack_start(self.tip_label(self.tile_meta(tile, windows), "dock-canvas-meta"), False, False, 0)

        open_button = self.tip_button(tr("Ouvrir", "Open"), lambda _button: (run_action([str(part) for part in tile.get("command", [])]), self.close_preview()))
        box.pack_start(open_button, False, False, 0)

        if windows:
            focus_button = self.tip_button(tr("Revenir à la dernière fenêtre", "Focus Last Window"), lambda _button: (focus_client(sorted(windows, key=lambda item: int(item.get("focusHistoryID", 9999) or 9999))[0]), self.close_preview()))
            box.pack_start(focus_button, False, False, 0)

            for client in sorted(windows, key=lambda item: int(item.get("focusHistoryID", 9999) or 9999))[:5]:
                label = str(client.get("title") or client.get("class") or tile.get("title", "Window"))
                if len(label) > 42:
                    label = label[:39].rstrip() + "..."
                row = self.tip_button(f"• {label}", lambda _row, selected=client: (focus_client(selected), self.close_preview()))
                box.pack_start(row, False, False, 0)

            close_button = self.tip_button(tr("Fermer les fenêtres", "Close Windows"), lambda _button: (self.close_tile_windows(windows), self.close_preview()), "dock-canvas-danger")
            box.pack_start(close_button, False, False, 0)

        if self.customizable_tile(tile):
            if self.tile_is_saved(tile):
                pin_label = tr("Retirer du Dock", "Remove from Dock")
                pin_callback = lambda _button, selected=tile: self.set_tile_saved(selected, False)
            else:
                pin_label = tr("Garder dans le Dock", "Keep in Dock")
                pin_callback = lambda _button, selected=tile: self.set_tile_saved(selected, True)
            box.pack_start(self.tip_button(pin_label, pin_callback, "dock-canvas-secondary"), False, False, 0)

        box.pack_start(self.tip_label(tr("Contrôles du Dock", "Dock Controls"), "dock-canvas-meta"), False, False, 0)
        for label, command in self.dock_quick_controls():
            box.pack_start(
                self.tip_button(label, lambda _button, selected=command: (run_action(selected), self.close_preview()), "dock-canvas-secondary"),
                False,
                False,
                0,
            )

        self.preview = self.tooltip_window(box, self.hover_anchor())

    def show_folder_stack(self, tile: dict[str, object]) -> None:
        command = [str(part) for part in tile.get("command", [])]
        folder = Path(command[1]).expanduser() if len(command) > 1 else Path.home()
        key = f"folder:{folder}"
        if self.tip_key == key and self.preview is not None:
            return
        self.close_label()
        self.close_preview()
        self.tip_key = key
        box = self.tip_box(spacing=8)
        box.pack_start(self.tip_label(str(tile.get("title", folder.name or "Folder"))), False, False, 0)
        box.pack_start(self.tip_label(str(folder), "dock-canvas-meta"), False, False, 0)

        open_button = self.tip_button(tr("Ouvrir dans Fichiers", "Open in Files"), lambda _button: (run_action(["xdg-open", str(folder)]), self.close_preview()))
        box.pack_start(open_button, False, False, 0)

        try:
            entries = sorted(folder.iterdir(), key=lambda item: (not item.is_dir(), item.name.casefold()))[:7]
        except OSError:
            entries = []
        for entry in entries:
            label = f"{'▸' if entry.is_dir() else '•'} {entry.name}"
            if len(label) > 42:
                label = label[:39].rstrip() + "..."
            row = self.tip_button(label, lambda _row, selected=entry: (run_action(["xdg-open", str(selected)]), self.close_preview()))
            box.pack_start(row, False, False, 0)
        if not entries:
            empty = self.tip_label(tr("Dossier vide", "Empty folder"), "dock-canvas-meta")
            box.pack_start(empty, False, False, 0)

        self.preview = self.tooltip_window(box, self.hover_anchor())

    def close_tile_windows(self, windows: list[dict[str, object]]) -> None:
        for client in windows:
            close_client(client)

    def hover_anchor(self) -> tuple[int, int] | None:
        if self.hover_index is None or self.hover_index >= len(self.visual_rects):
            return None
        vx, vy, vw, _vh = self.visual_rects[self.hover_index]
        wx, wy = self.widget_origin(self.area)
        return int(wx + vx + vw / 2), int(wy + vy)

    def tooltip_window(self, content, anchor: tuple[int, int] | None = None):
        win = self.Gtk.Window(title="Seven Dock Tip")
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_accept_focus(False)
        win.set_focus_on_map(False)
        win.set_keep_above(True)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_type_hint(self.Gdk.WindowTypeHint.TOOLTIP)
        win.get_style_context().add_class("dock-canvas-tip")
        if isinstance(content, str):
            label = self.Gtk.Label(label=content)
            label.set_margin_top(6)
            label.set_margin_bottom(6)
            label.set_margin_start(12)
            label.set_margin_end(12)
            win.add(label)
        else:
            content.set_margin_top(8)
            content.set_margin_bottom(8)
            content.set_margin_start(10)
            content.set_margin_end(10)
            win.add(content)
        win.show_all()
        wx, wy = self.widget_origin(self.area)
        width = max(96, win.get_allocated_width() or 96)
        height = max(30, win.get_allocated_height() or 30)
        if anchor is None:
            anchor = (int(wx + self.width / 2), int(wy))
        px = int(anchor[0] - width / 2)
        py = int(anchor[1] - height - 12)
        win.move(max(8, px), max(8, py))
        return win

    def close_preview(self) -> None:
        if self.preview is not None:
            try:
                self.preview.destroy()
            except Exception:
                pass
            self.preview = None
            self.tip_key = None

    def close_label(self) -> None:
        if self.hover_label is not None:
            try:
                self.hover_label.destroy()
            except Exception:
                pass
            self.hover_label = None
            self.tip_key = None

    @staticmethod
    def widget_origin(widget) -> tuple[int, int]:
        try:
            origin = widget.get_window().get_origin()
            if len(origin) == 3:
                return int(origin[1]), int(origin[2])
            return int(origin[0]), int(origin[1])
        except Exception:
            return 0, 0


def limits(json_output: bool) -> int:
    config = load_config()
    profile = active_profile_key()
    clients = hyprland_clients()
    grouped = clients_by_tile(clients)
    fullscreen = focused_fullscreen_client(clients)
    tiles = make_tiles(config, profile, grouped)
    mon_w, mon_h = monitor_bounds()
    tile_count = sum(1 for tile in tiles if not tile.get("separator"))
    sep_count = sum(1 for tile in tiles if tile.get("separator"))
    width = min(max(300, PADDING_X * 2 + tile_count * BASE_TILE + max(0, tile_count - 1) * GAP + sep_count * SEP), mon_w - DOCK_MARGIN * 2)
    fullscreen_behavior = str(config.get("fullscreen_behavior", "smart-hide") or "smart-hide")
    fullscreen_soft_hide = bool(fullscreen) and fullscreen_behavior == "smart-hide"
    autohide = bool(config.get("autohide", False)) or fullscreen_soft_hide
    reserve_space = bool(config.get("reserve_space", True)) and not autohide
    effect = normalize_effect(config.get("effect") or ("magnetic" if config.get("magnification", True) else "none"))
    hide_delay = clamp_float(config.get("autohide_delay", HIDE_DELAY), 0.5, 8.0)
    payload = {
        "schema": "sevenos.dock.limits.v1",
        "renderer": "canvas",
        "monitor": {"width": mon_w, "height": mon_h},
        "dock": {
            "width": width,
            "height": DOCK_HEIGHT,
            "margin": DOCK_MARGIN,
            "reserve_space": reserve_space,
            "exclusive_zone": DOCK_HEIGHT + DOCK_MARGIN + 8 if reserve_space else 0,
            "layout": "reserved-system-surface" if reserve_space else "floating-autohide-overlay",
            "effect": effect,
            "autohide": autohide,
            "autohide_delay": hide_delay,
            "edit_mode": bool(config.get("edit_mode", False)),
            "fullscreen_behavior": fullscreen_behavior,
            "fullscreen_soft_hide": fullscreen_soft_hide,
            "hidden_margin": -(DOCK_HEIGHT - HIDDEN_PEEK) if autohide else DOCK_MARGIN,
            "hidden_peek": HIDDEN_PEEK,
        },
        "tiles": {"total": tile_count, "separators": sep_count, "profile_pins": PROFILE_PINNED.get(profile, PROFILE_PINNED["equinox"])},
        "live": {
            "hyprland_clients": len(clients),
            "focused_fullscreen": bool(fullscreen),
            "features": [
                "canvas-draw",
                "smooth-neighbor-magnification",
                "magnetic-focus",
                "icon-lift",
                "launch-bounce",
                "centered-icons",
                "active-halo",
                "multi-window-dots",
                "anchored-window-preview",
                "scroll-window-cycle",
                "middle-click-new-instance",
                "drag-reorder",
                "folder-stacks",
                "autohide-fade",
                "smooth-slide-reveal",
                "edge-handle",
                "spring-motion",
                "delayed-hide",
                "settings-dock-controls",
                "hover-intent-preview",
                "direct-native-spotlight",
                "reserved-space-default",
                "active-window-avoidance",
                "right-click-pin-unpin",
                "native-dock-settings-entry",
                "structured-context-cards",
                "context-autohide-toggle",
                "context-effect-control",
                "context-dock-restart",
                "edit-mode-surface",
                "edit-mode-add-tile",
                "typed-badges",
                "fullscreen-smart-hide",
            ],
        },
    }
    if json_output:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        print(f"SevenOS Canvas Dock: {width}x{DOCK_HEIGHT}")
    return 0


def main() -> int:
    if "--probe" in sys.argv:
        return probe()
    if "--limits" in sys.argv:
        return limits("--json" in sys.argv)
    return CanvasDock().run()


if __name__ == "__main__":
    raise SystemExit(main())
