#!/usr/bin/env bash

set -Eeuo pipefail

# ============================================================
# SevenOS Waybar Action
# ============================================================
#
# Waybar
#   ↓
# seven-waybar-action
#   ↓
# core/context/action.sh
#
# Waybar ne contient aucune politique métier.
# ============================================================

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

CONTEXT_DIR="$ROOT/core/context"

ACTION_ENGINE="$CONTEXT_DIR/action.sh"
CONTEXT_BIN="$ROOT/bin/seven-waybar-context"

die() {
    echo "seven-waybar-action: $*" >&2
    exit 1
}

[[ -x "$ACTION_ENGINE" ]] ||
    die "Context action engine not found: $ACTION_ENGINE"

[[ -x "$CONTEXT_BIN" ]] ||
    die "seven-waybar-context not found: $CONTEXT_BIN"

usage() {
    cat <<'USAGE'
SevenOS Waybar Action

Usage:

  seven-waybar-action context
  seven-waybar-action refresh

  seven-waybar-action profile <profile>
  seven-waybar-action focus <focus>
  seven-waybar-action workspace <workspace>

  seven-waybar-action execute <action>

  seven-waybar-action request <json>
USAGE
}

refresh_context() {
    "$CONTEXT_BIN" once >/dev/null
}

context_status() {
    exec "$CONTEXT_BIN" status
}

build_request() {

    local category="$1"
    local value="${2:-}"

    jq -n \
        --arg category "$category" \
        --arg value "$value" \
        '{
            schema: "sevenos.waybar.action.v1",
            source: "seven-waybar",
            category: $category,
            value: (
                if $value == "" then null
                else $value
                end
            )
        }'
}

execute_action() {

    local category="$1"
    local value="${2:-}"

    local request

    request="$(build_request "$category" "$value")"

    if "$ACTION_ENGINE" --json <<< "$request"; then
        refresh_context
        return 0
    fi

    if "$ACTION_ENGINE" "$category" "$value"; then
        refresh_context
        return 0
    fi

    die "Action rejected or unsupported: $category ${value:-}"
}

case "${1:-help}" in

    context)
        context_bin="$ROOT/bin/seven-waybar-context"

        [[ -x "$context_bin" ]] ||
            die "seven-waybar-context not found"

        exec "$context_bin" status
        ;;

    refresh)
        refresh_context
        ;;

    profile)
        [[ $# -ge 2 ]] ||
            die "missing profile"

        execute_action profile "$2"
        ;;

    focus)
        [[ $# -ge 2 ]] ||
            die "missing focus"

        execute_action focus "$2"
        ;;

    workspace)
        [[ $# -ge 2 ]] ||
            die "missing workspace"

        execute_action workspace "$2"
        ;;

    execute)
        [[ $# -ge 2 ]] ||
            die "missing action"

        execute_action action "$2"
        ;;

    request)
        [[ $# -ge 2 ]] ||
            die "missing JSON request"

        request="$2"

        jq -e . >/dev/null 2>&1 <<< "$request" ||
            die "invalid JSON request"

        if "$ACTION_ENGINE" --json <<< "$request"; then
            refresh_context
        else
            die "action request rejected"
        fi
        ;;

    -h|--help|help)
        usage
        ;;

    *)
        usage
        exit 1
        ;;

esac
