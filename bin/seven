def handle_surfaces(args):
    if args.action in {"status", "json"}:
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "surfaces", "--json"],
            {"schema": "sevenos.core.surfaces.v1", "state": "unknown", "surfaces": []},
        )
        if args.json or args.action == "json":
            print(json.dumps(payload, indent=2))
        else:
            summary = payload.get("summary", {}) if isinstance(payload.get("summary"), dict) else {}
            print("SevenOS Surfaces")
            print("================")
            print(f"State: {payload.get('state', 'unknown')}")
            print(f"Score: {payload.get('score', 0)}%")
            print(f"Source: {payload.get('writer', 'unknown')}")
            print(f"Surfaces: {summary.get('ok', 0)}/{summary.get('total', 0)} OK")
            for item in (payload.get("surfaces") or [])[:12]:
                if isinstance(item, dict):
                    print(f"- {item.get('title', item.get('key', 'Surface'))}: {item.get('state', 'unknown')}")
        return
    extra = [args.action]
    if args.json:
        extra.append("--json")
    run_script(args, "scripts/surfaces.sh", *extra)


