def handle_session(args):
    if args.action == "status":
        extra = ["--json"] if args.json else []
        run_script(args, "bin/seven-session-status", *extra)
    elif args.action == "start":
        run_script(args, "bin/seven-session")
    elif args.action == "restart":
        run(["bash", "-lc", f"systemctl --user restart sevenos-session.target || {shlex.quote(str(ROOT_DIR / 'bin' / 'seven-session'))}"], args)
    else:
        print(f"seven: unknown session action: {args.action}", file=sys.stderr)
        sys.exit(1)


def handle_control(args):
    if args.action == "plan" and not args.apply:
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "control", "--json"],
            {"schema": "sevenos.control.v1", "overall": 0, "actions": [], "summary": {}},
        )
        actions = payload.get("actions", []) or []
        if args.safe_only:
            actions = [
                item for item in actions
                if isinstance(item, dict) and item.get("impact") == "safe"
            ]
        if args.limit is not None:
            actions = actions[:max(args.limit, 0)]
        payload["actions"] = actions
        if args.json:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
            return
        summary = payload.get("summary", {}) if isinstance(payload.get("summary"), dict) else {}
        print("SevenOS Control Plane")
        print("=====================")
        print(f"Overall: {payload.get('overall', 0)}%")
        print(f"Source: {payload.get('writer', 'unknown')}")
        print(f"Actions: {len(actions)} visible / {summary.get('total', len(actions))} total")
        for item in actions:
            if not isinstance(item, dict):
                continue
            print(f"- {item.get('severity', 'medium')}: {item.get('title', 'Action')}")
            print(f"  {item.get('command', 'seven control plan')}")
        if not actions:
            print("No priority control action in the current filter.")
        return
    extra = [args.action]
    if args.json:
        extra.append("--json")
    if args.apply:
        extra.append("--apply")
    if args.yes:
        extra.append("--yes")
    if args.safe_only:
        extra.append("--safe-only")
    if args.limit is not None:
        extra.extend(["--limit", str(args.limit)])
    run_script(args, "scripts/control-plane.sh", *extra)


def handle_events(args):
    if args.action in {"list", "summary-json"}:
        command = [str(ROOT_DIR / "bin" / "seven-daemon")]
        if args.action == "summary-json":
            command.append("summary")
        else:
            command.append("events")
        if args.limit is not None:
            command.extend(["--limit", str(args.limit)])
        command.append("--json")
        payload = capture_json(
            command,
            {"schema": "sevenos.events.v1", "events": [], "count": 0, "total": 0},
        )
        if args.json or args.action == "summary-json":
            print(json.dumps(payload, indent=2, ensure_ascii=False))
            return
        print("SevenOS Events")
        print("==============")
        print(f"Events: {payload.get('count', 0)} shown / {payload.get('total', 0)} total")
        print(f"Source: {payload.get('writer', 'unknown')}")
        for item in (payload.get("events") or [])[-10:]:
            if not isinstance(item, dict):
                continue
            source = item.get("source", item.get("event", "event"))
            message = item.get("message", item.get("action", ""))
            print(f"- {source}: {message}")
        return
    extra = [args.action]
    if args.json:
        extra.append("--json")
    if args.limit is not None:
        extra.extend(["--limit", str(args.limit)])
    run_script(args, "scripts/events.sh", *extra)


def handle_insights(args):
    command = [str(ROOT_DIR / "bin" / "seven-daemon"), "insights"]
    if args.limit is not None:
        command.extend(["--limit", str(args.limit)])
    command.append("--json")
    payload = capture_json(
        command,
        {"schema": "sevenos.insights.v1", "insights": [], "state": "unknown"},
    )
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    print("SevenOS Insights")
    print("================")
    print(f"State: {payload.get('state', 'ready')}")
    print(f"Source: {payload.get('writer', 'unknown')}")
    for item in (payload.get("insights") or payload.get("items") or [])[: args.limit or 8]:
        if not isinstance(item, dict):
            continue
        print(f"- {item.get('severity', item.get('state', 'info'))}: {item.get('title', item.get('key', 'Insight'))}")
        detail = item.get("detail") or item.get("reason") or item.get("message")
        if detail:
            print(f"  {detail}")


