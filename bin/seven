def handle_production(args):
    if getattr(args, "full", False):
        extra = [args.action]
        if args.json:
            extra.append("--json")
        run_script(args, "scripts/production-readiness.sh", *extra)
        return
    if args.action == "validate":
        extra = ["record"]
        if args.json:
            extra.append("--json")
        run_script(args, "scripts/release-validation.sh", *extra)
        return
    if args.action == "json":
        args.json = True
    payload = capture_json(
        [str(ROOT_DIR / "bin" / "seven-daemon"), "production", "--json"],
        {"schema": "sevenos.production-readiness.v2", "state": "unknown", "score": 0, "checks": [], "issues": []},
    )
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    print("SevenOS Production Readiness")
    print("============================")
    print(f"State: {payload.get('state', 'unknown')}")
    print(f"Score: {payload.get('score', 0)}%")
    print(f"Public beta: {str(payload.get('public_beta_ready', False)).lower()}")
    print(f"Large scale: {str(payload.get('large_scale_ready', False)).lower()}")
    for item in (payload.get("checks") or [])[:10]:
        if isinstance(item, dict):
            print(f"- {item.get('state', 'unknown')}: {item.get('title', item.get('key', 'Check'))}")
            if item.get("detail"):
                print(f"  {item.get('detail')}")
            if item.get("command"):
                print(f"  {item.get('command')}")
    return


def handle_production_full(args):
