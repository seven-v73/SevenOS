def handle_adaptive(args):
    if getattr(args, "full", False):
        extra = [args.action]
        if args.json:
            extra = ["json"]
        run_script(args, "scripts/adaptive-ui.sh", *extra)
        return
    if args.action == "json":
        args.json = True
    payload = capture_json(
        [str(ROOT_DIR / "bin" / "seven-daemon"), "adaptive", "--json"],
        {"schema": "sevenos.adaptive-ui.v2", "state": "unknown", "percent": 0, "checks": []},
    )
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    if args.action == "plan":
        print("SevenOS Adaptive UI Plan")
        print("========================")
        items = payload.get("next", []) if isinstance(payload.get("next"), list) else []
        if not items:
            print("No open adaptive UI actions.")
        for item in items:
            if isinstance(item, dict):
                print(f"- {item.get('title', item.get('key', 'Adaptive action'))}")
                print(f"  {item.get('reason', '')}")
                print(f"  command: {item.get('command', 'seven adaptive')}")
        return
    summary = payload.get("summary", {}) if isinstance(payload.get("summary"), dict) else {}
    profile = payload.get("active_profile", {}) if isinstance(payload.get("active_profile"), dict) else {}
    print("SevenOS Adaptive UI")
    print("===================")
    print(f"State:   {payload.get('state', 'unknown')}")
    print(f"Score:   {payload.get('percent', payload.get('score', 0))}%")
    print(f"Profile: {profile.get('title', 'unknown')} ({profile.get('key', 'unknown')})")
    print(f"Checks:  {summary.get('ok', 0)}/{summary.get('checks', len(payload.get('checks', [])))} OK")
    for item in (payload.get("checks") or [])[:10]:
        if isinstance(item, dict):
            print(f"- {item.get('state', 'unknown')}: {item.get('title', item.get('key', 'Check'))}")
            print(f"  {item.get('detail', '')}")
    return
    extra = [args.action]
    if args.json:
        extra = ["json"]
    run_script(args, "scripts/adaptive-ui.sh", *extra)


def handle_dynamic(args):
    if getattr(args, "full", False):
        extra = [args.action]
        if args.json:
            extra = ["json"]
        run_script(args, "scripts/adaptive-ui.sh", *extra)
        return
    handle_adaptive(args)
    return
    extra = [args.action]
    if args.json:
        extra = ["json"]
    run_script(args, "scripts/adaptive-ui.sh", *extra)


