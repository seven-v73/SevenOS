        extra.append("--apply")
    if args.yes:
        extra.append("--yes")
    run_script(args, "scripts/repair.sh", *extra)


def handle_release(args):
    if args.action in {"open", "ui"}:
        run_script(args, "bin/seven-release-review-native")
        return
    if args.action in {"status", "doctor", "json", "plan"}:
        env = os.environ.copy()
        current = Path.cwd()
        if Path(current, ".git").is_dir() and Path(current, "install.sh").is_file():
            env.setdefault("SEVENOS_SOURCE_ROOT", str(current))
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "release", "--json"],
            {"schema": "sevenos.release.v2", "state": "unknown", "score": 0, "issues": []},
            env=env,
        )
        if args.json or args.action == "json":
            print(json.dumps(payload, indent=2, ensure_ascii=False))
            return
        print("SevenOS Release")
        print("===============")
        print(f"State: {payload.get('state', 'unknown')}")
        print(f"Score: {payload.get('score', 0)}%")
        print(f"Daily driver: {str(payload.get('daily_driver_ready', False)).lower()}")
        print(f"Public release: {str(payload.get('public_release_ready', False)).lower()}")
        worktree = payload.get("worktree") if isinstance(payload.get("worktree"), dict) else {}
        print(f"Dirty paths: {worktree.get('dirty_count', 0)}")
        if args.action in {"doctor", "plan"}:
            for item in (payload.get("issues") or payload.get("next") or [])[:8]:
                if isinstance(item, dict):
                    print(f"- {item.get('state', 'unknown')}: {item.get('title', item.get('key', 'Check'))}")
                    print(f"  {item.get('detail', '')}")
                    print(f"  {item.get('command', '')}")
        return
    extra = [args.action]
    if args.json:
        extra.append("--json")
    run_script(args, "scripts/release.sh", *extra)


def print_public_readiness_human(payload):
    lang = (os.environ.get("SEVENOS_LANGUAGE") or os.environ.get("LANG") or "").lower()
    fr = lang.startswith("fr")
    print("SevenOS Public Readiness")
    print("========================")
    print(f"State: {payload.get('state', 'unknown')}")
    summary = payload.get("summary") if isinstance(payload.get("summary"), dict) else {}
    print(
        "Summary: "
        f"ready={summary.get('ready', 0)} "
        f"todo={summary.get('todo', 0)} "
        f"score={payload.get('score', 0)}%"
    )
    for item in payload.get("decisions", []) if isinstance(payload.get("decisions"), list) else []:
        title = item.get("title_fr" if fr else "title_en") or item.get("key", "decision")
        detail = item.get("detail_fr" if fr else "detail_en") or ""
        print(f"- {item.get('state', 'unknown')}: {title}")
        if detail:
            print(f"  {detail}")
        if item.get("command"):
            print(f"  {item.get('command')}")


def handle_public_readiness(args):
    if getattr(args, "full", False):
        extra = [args.action]
        if args.json:
            extra.append("--json")
        run_script(args, "scripts/readiness-decisions.sh", *extra)
        return
    if args.action == "json":
        args.json = True
    payload = capture_json(
        [str(ROOT_DIR / "bin" / "seven-daemon"), "public-readiness", "--json"],
        {"schema": "sevenos.public-readiness.v1", "state": "unknown", "summary": {}, "decisions": [], "next": []},
    )
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    print_public_readiness_human(payload)


def handle_public_readiness_full(args):
    extra = [args.action]
    if args.json:
        extra.append("--json")
    run_script(args, "scripts/readiness-decisions.sh", *extra)


def handle_actions(args):
    action = args.action
    extra = list(getattr(args, "extra", []) or [])
    json_requested = bool(getattr(args, "json", False) or "--json" in extra or "json" in extra)
    extra = [item for item in extra if item not in ("--json", "json")]
    if getattr(args, "native", False) or action in ("native", "system"):
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "actions", "--json"],
            {"schema": "sevenos.core.actions.v1", "state": "unknown", "count": 0, "actions": []},
        )
        if json_requested:
            print(json.dumps(payload, indent=2, ensure_ascii=False))
            return
        print("SevenOS native actions")
        print(f"State: {payload.get('state', 'unknown')} · {payload.get('count', 0)} actions · writer={payload.get('writer', 'unknown')}")
        for item in (payload.get("actions") or [])[:24]:
            print(f"- {item.get('id', 'action')}: {item.get('title', '')}")
            print(f"  {item.get('command', '')}")
        return
    if action == "status":
        native = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "actions", "--json"],
            {"schema": "sevenos.core.actions.v1", "state": "unknown", "count": 0, "actions": []},
        )
        broad = capture_json(
            [str(ROOT_DIR / "scripts" / "actions.sh"), "--json"],
            {"schema": "sevenos.actions.v1", "state": "unknown", "count": 0, "actions": []},
        )
        if json_requested:
            print(json.dumps({
                "schema": "sevenos.actions.status.v1",
                "state": "ready" if native.get("state") == "ready" and broad.get("schema") == "sevenos.actions.v1" else "attention",
                "native": {
                    "schema": native.get("schema"),
                    "state": native.get("state"),
                    "count": native.get("count", 0),
                    "writer": native.get("writer"),
                },
                "catalog": {
                    "schema": broad.get("schema"),
                    "count": broad.get("count", 0),
                    "writer": broad.get("writer", "scripts/actions.sh"),
                    "system_registry": broad.get("system_registry", {}),
                },
                "preferred_route": "seven actions native --json",
                "compat_route": "seven actions --json",
            }, indent=2, ensure_ascii=False))
            return
        registry = broad.get("system_registry", {}) or {}
        print("SevenOS actions")
        print(f"Native registry: {native.get('state', 'unknown')} · {native.get('count', 0)} actions · writer={native.get('writer', 'unknown')}")
        print(f"User catalog: {broad.get('count', 0)} actions · native link={registry.get('state', 'unknown')} · writer={broad.get('writer', 'scripts/actions.sh')}")
        print("Use: seven actions native --json for system surfaces, seven actions --json for the broad launcher catalog.")
        return
    extra = [action, *extra]
    if json_requested:
        extra = ["--json"]
    run_script(args, "scripts/actions.sh", *extra)


def handle_spotlight(args):
    extra = [args.action, *args.extra]
    if args.json and "--json" not in extra:
        extra.append("--json")
    run_script(args, "bin/seven-spotlight", *extra)


def handle_launchpad(args):
    action = args.action
    if action in ("open", "apps"):
        run_script(args, "bin/seven-apps", "open")
        return
    if action == "refresh":
        run_script(args, "bin/seven-launchpad-native", "--refresh")
        return
    if action == "doctor":
        extra = ["--doctor"]
        if args.json:
            extra.append("--json")
        run_script(args, "bin/seven-launchpad-native", *extra)
        return
    if action in ("json", "status"):
        run_script(args, "bin/seven-launchpad-native", "--json")
        return
    if action in ("catalog", "catalog-json"):
        run_script(args, "bin/seven-launchpad-native", "--catalog-json")
        return
    print("seven launchpad: supported actions are open, refresh, doctor, status and catalog", file=sys.stderr)
    sys.exit(2)


def handle_tools(args):
    extra_args = list(getattr(args, "extra", []) or [])
    if "--json" in extra_args:
        args.json = True
        extra_args = [item for item in extra_args if item != "--json"]
    if "--full" in extra_args:
        args.full = True
        extra_args = [item for item in extra_args if item != "--full"]
    if getattr(args, "full", False):
        extra = [args.action, *extra_args]
        if args.json and "--json" not in extra:
            extra.append("--json")
        run_script(args, "scripts/tools.sh", *extra)
        return
    if args.action in {"open", "gui"}:
        extra = [args.action, *extra_args]
        if args.json and "--json" not in extra:
            extra.append("--json")
        run_script(args, "scripts/tools.sh", *extra)
        return
    if args.action == "json":
        args.json = True
    command = [str(ROOT_DIR / "bin" / "seven-daemon"), "tools", "--json"]
    if args.action == "detail" and extra_args:
        command = [str(ROOT_DIR / "bin" / "seven-daemon"), "tools", "detail", extra_args[0], "--json"]
    payload = capture_json(
        command,
        {"schema": "sevenos.tools.v2", "state": "unknown", "score": 0, "tools": []},
    )
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    if args.action == "detail":
        tool = payload.get("tool", {}) if isinstance(payload.get("tool"), dict) else {}
        print("SevenOS Tool")
        print("============")
        print(f"Name: {tool.get('name', extra_args[0] if extra_args else 'unknown')}")
        print(f"State: {payload.get('state', tool.get('state', 'unknown'))}")
        print(f"Role: {tool.get('role', '-')}")
        print(f"Open: {' '.join(str(part) for part in tool.get('open', []))}")
        blockers = tool.get("blockers", []) or []
        if blockers:
            print("Blockers:")
            for blocker in blockers:
                print(f"- {blocker}")
        return
    summary = payload.get("summary", {}) if isinstance(payload.get("summary"), dict) else {}
    print("SevenOS Tools")
    print("=============")
    print(f"State: {payload.get('state', 'unknown')}")
    print(f"Score: {payload.get('score', 0)}%")
    print(f"Source: {payload.get('writer', 'unknown')}")
    print(f"Tools: {summary.get('ok', 0)}/{summary.get('tools', 0)} OK, {summary.get('partial', 0)} partial")
    for item in (payload.get("tools") or [])[:12]:
        if isinstance(item, dict):
            print(f"- {item.get('state', 'unknown')}: {item.get('name', item.get('key', 'Tool'))}")
            print(f"  {item.get('intent', '')}")
    return


def handle_tools_full(args):
    extra = [args.action, *args.extra]
    if args.json and "--json" not in extra:
        extra.append("--json")
    run_script(args, "scripts/tools.sh", *extra)


def handle_ux(args):
    if args.action == "full":
        extra = []
        if args.json:
            extra.append("--json")
        run_script(args, "scripts/ux-check.sh", *extra)
        return
    if args.action == "json":
        args.json = True
    payload = capture_json(
        [str(ROOT_DIR / "bin" / "seven-daemon"), "ux-check", "--json"],
        {"schema": "sevenos.ux-check.v1", "state": "unknown", "failures": 1, "summary": {}},
    )
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    summary = payload.get("summary", {}) if isinstance(payload.get("summary"), dict) else {}
    print("SevenOS UX Gate")
    print("===============")
    print(f"State: {payload.get('state', 'unknown')}")
    print(f"Mode: {payload.get('mode', 'fast')}")
    print(f"Source: {payload.get('writer', 'unknown')}")
    print(f"Files: {summary.get('files', 0) - summary.get('missing', 0)}/{summary.get('files', 0)} OK")
    print(f"Tools score: {summary.get('tools_score', 0)}%")
    failures = [
        item for item in (payload.get("checks") or [])
        if isinstance(item, dict) and item.get("state") != "OK"
    ]
    if failures:
        print("Attention:")
        for item in failures[:8]:
            print(f"- {item.get('key', 'check')}: {item.get('path', '')}")
    else:
        print("No missing UX contract file detected by the native fast gate.")
    return


def handle_ux_full(args):
    extra = []
    if args.action in {"fast", "status", "json"}:
        extra.append("--fast")
    if args.action == "json" or args.json:
        extra.append("--json")
    run_script(args, "scripts/ux-check.sh", *extra)


