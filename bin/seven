        handle_experience_center(args)
    elif args.command in {"rescue", "time-machine", "timeline", "permissions", "journeys", "memory", "briefing", "care", "trust", "personal-setup", "intent", "missions", "mission", "privacy-report", "learning", "device-continuity"}:
        shortcut_sections = {"personal-setup": "setup", "mission": "missions"}
        handle_experience_shortcut(args, shortcut_sections.get(args.command, args.command))
    elif args.command in ("quality", "public-experience"):
        handle_quality(args)
    elif args.command in ("interaction-gate", "accessibility-gate"):
        handle_interaction_gate(args, getattr(args, "contract_action", "status"))
    elif args.command == "workflow-gate":
        handle_workflow_gate(args)
    elif args.command == "layout-gate":
        handle_layout_gate(args)
    elif args.command == "performance-gate":
        handle_performance_gate(args)
    elif args.command == "native-fallback-gate":
        handle_native_fallback_gate(args)
    elif args.command == "public-studio":
        handle_public_studio(args)
    elif args.command == "first-run":
        args.action = "fresh-install" if args.action == "verify" else args.action
        handle_public_studio(args)
    elif args.command == "visual-gate":
        handle_public_studio(args)
    elif args.command == "control":
        handle_control(args)
    elif args.command == "events":
        handle_events(args)
    elif args.command == "insights":
        handle_insights(args)
