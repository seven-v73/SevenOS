    extra_args = [item for item in raw_extra if item not in {"--gui", "--json"}]
    if gui_requested:
        section = "status"
        if args.action == "mode":
            section = "status"
        elif args.action in {"doctor", "status", "plan", "json"}:
            section = "status"
        run_script(args, "bin/seven-public-studio", section, "--gui")
        return
    extra = [args.action, *extra_args]
    if json_requested:
        extra.append("--json")
    run_script(args, "scripts/public-experience.sh", *extra)


