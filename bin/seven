def handle_update(args):
    if args.action in {"status", "check", "doctor", "json"} and not args.yes:
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "update", "--json"],
            {"schema": "sevenos.update.v2", "state": "unknown", "checks": []},
        )
        if args.json or args.action == "json":
            print(json.dumps(payload, indent=2))
        else:
            print("SevenOS Update")
            print("==============")
            print(f"State: {payload.get('state', 'unknown')}")
            print(f"Source: {payload.get('writer', 'unknown')}")
            print(f"Score: {payload.get('score', 0)}%")
            checks = payload.get("checks", []) or []
            if checks:
                print()
                print("Checks:")
                for item in checks[:8]:
                    if not isinstance(item, dict):
                        continue
                    print(f"- {item.get('title', item.get('key', 'Check'))}: {item.get('state', 'unknown')}")
        if args.action == "doctor" and int(payload.get("score", 0) or 0) < 75:
            raise SystemExit(1)
        return
    if args.action == "plan" and not args.yes:
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "update-plan", "--json"],
            {"schema": "sevenos.update-plan.v1", "state": "unknown", "next": []},
        )
        if args.json:
            print(json.dumps(payload, indent=2))
        else:
            print("SevenOS Update Plan")
            print("===================")
            print(f"State: {payload.get('state', 'unknown')}")
            print(f"Source: {payload.get('writer', 'unknown')}")
            for item in (payload.get("next") or payload.get("actions") or [])[:8]:
                if isinstance(item, dict):
                    print(f"- {item.get('title', item.get('key', 'Action'))}: {item.get('command', 'seven update')}")
        return
    extra = [args.action]
    if args.json:
        extra.append("--json")
    if args.yes:
        extra.append("--yes")
    run_script(args, "scripts/update.sh", *extra)


