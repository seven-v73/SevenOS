def handle_installer(args):
    extra_args = [item for item in args.extra if item != "--json"]
    wants_json = args.json or "--json" in args.extra
    if args.action in {"status", "doctor"} and not extra_args:
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "installer", "--json"],
            {"schema": "sevenos.installer.v1", "state": "unknown", "checks": []},
        )
        if wants_json:
            print(json.dumps(payload, indent=2))
        else:
            print("SevenOS Installer")
            print("=================")
            print(f"Mode: {payload.get('mode', payload.get('state', 'unknown'))}")
            print(f"Source: {payload.get('writer', 'unknown')}")
            for item in (payload.get("checks") or [])[:8]:
                if isinstance(item, dict):
                    print(f"- {item.get('title', item.get('key', 'Check'))}: {item.get('state', 'unknown')}")
        return
    if args.action == "plan" and not extra_args:
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "installer-plan", "--json"],
            {"schema": "sevenos.installer-plan.v1", "state": "unknown", "next": []},
        )
        if wants_json:
            print(json.dumps(payload, indent=2))
        else:
            print("SevenOS Installer Plan")
            print("======================")
            print(f"Source: {payload.get('writer', 'unknown')}")
            for item in (payload.get("next") or payload.get("actions") or [])[:8]:
                if isinstance(item, dict):
                    print(f"- {item.get('title', item.get('key', 'Action'))}: {item.get('command', 'seven installer')}")
        return
    if args.action in {"flow", "live-flow"} and not extra_args:
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "installer-flow", "--json"],
            {"schema": "sevenos.installer-flow.v1", "state": "unknown"},
        )
        if wants_json:
            print(json.dumps(payload, indent=2))
        else:
            print("SevenOS Installer Flow")
            print("======================")
            print(f"State: {payload.get('state', 'unknown')}")
            print(f"Source: {payload.get('writer', 'unknown')}")
        return
    extra = [args.action, *extra_args]
    if wants_json:
        extra.append("--json")
    if args.action in {"iso-runtime", "calamares-iso"} and is_dry_run(args):
        if "--dry-run" not in extra:
            extra.append("--dry-run")
        run_script_with_dry_env("scripts/installer-stack.sh", *extra)
        return
    run_script(args, "scripts/installer-stack.sh", *extra)


