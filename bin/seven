        extra.append("--json")
    run_script(args, "scripts/production-readiness.sh", *extra)


def handle_about(args):
    if args.action in {"status", "doctor", "plan", "json"}:
        payload = capture_json(
            [str(ROOT_DIR / "bin" / "seven-daemon"), "about", "--json"],
            {"schema": "sevenos.about.v2", "state": "unknown", "about_ready": False},
        )
        if args.json or args.action == "json":
            print(json.dumps(payload, indent=2, ensure_ascii=False))
            return
        profile = payload.get("active_mini_os", {}) if isinstance(payload.get("active_mini_os"), dict) else {}
        release = payload.get("release", {}) if isinstance(payload.get("release"), dict) else {}
        print("About SevenOS")
        print("=============")
        print(f"Name: {payload.get('pretty_name', 'SevenOS')}")
        print(f"Edition: {payload.get('edition', 'SevenOS')}")
        print(f"State: {payload.get('state', 'unknown')}")
        print(f"Mini OS: {profile.get('title', 'Unknown')} ({profile.get('short_label', '')})")
        print(f"Channel: {release.get('channel', 'unknown')} / {release.get('state', 'unknown')}")
        print(f"Daily driver: {str(payload.get('daily_driver_ready', False)).lower()}")
        print(f"Public release: {str(payload.get('public_release_ready', False)).lower()}")
        for item in (payload.get("issues") or [])[:6]:
            if isinstance(item, dict):
                print(f"- {item.get('state', 'unknown')}: {item.get('title', item.get('key', 'Check'))}")
                print(f"  {item.get('detail', '')}")
        return
    extra = [args.action]
    if args.json:
        extra.append("--json")
