def handle_ai(args):
    extra_args = list(args.extra)
    trailing_json = "--json" in extra_args
    trailing_apply = "--apply" in extra_args
    trailing_yes = "--yes" in extra_args
    trailing_web = "--web" in extra_args
    extra_args = [item for item in extra_args if item not in {"--json", "--apply", "--yes", "--web"}]
    ai_actions = {
        "brief", "status", "plan", "focus", "doctor", "json", "ask", "run",
        "intent", "apps", "context", "machine", "brain", "state", "capabilities", "memory", "preferences", "missions", "knowledge", "shortcuts",
        "workflow", "llm", "models", "model-setup", "execution", "manager", "operate", "web", "research", "diagnose", "playbook",
        "provider", "runtime", "agents", "coverage", "contracts", "handoffs", "permissions", "ledger", "record",
        "learning", "learn", "habits",
        "proactive", "suggestions",
        "open", "native", "gui", "interface", "agent",
    }
    if args.action == "open" and extra_args:
        extra = ["ask", "open", *extra_args]
    elif args.action not in ai_actions:
        extra = ["ask", args.action, *extra_args]
    else:
        extra = [args.action, *extra_args]
    if (args.json or trailing_json) and args.action == "brief" and not extra_args:
        extra = ["json"]
    elif args.json or trailing_json:
        extra.append("--json")
    if args.apply or trailing_apply:
        extra.append("--apply")
    if args.yes or trailing_yes:
        extra.append("--yes")
    if args.web or trailing_web:
        extra.append("--web")
    run_script(args, "scripts/ai.sh", *extra)


