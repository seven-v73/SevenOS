        handle_repair(args)
    elif args.command == "release":
        handle_release(args)
    elif args.command == "public-readiness":
        handle_public_readiness(args)
    elif args.command == "channel":
        handle_channel(args)
    elif args.command == "autonomy":
        handle_autonomy(args)
