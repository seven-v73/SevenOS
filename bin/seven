#!/usr/bin/env python3
import argparse
import json
import os
import shlex
import subprocess
import sys
from pathlib import Path


def resolve_root():
    script_dir = Path(__file__).resolve().parent
    candidate = script_dir.parent
    if Path(candidate, "install.sh").is_file():
        return candidate

    env_root = os.environ.get("SEVENOS_ROOT")
    if env_root and Path(env_root, "install.sh").is_file():
        return Path(env_root).resolve()

    for path in (Path("/opt/SevenOS"), Path.home() / "Code/OS/SevenOS", Path.home() / "SevenOS"):
        if Path(path, "install.sh").is_file():
            return path

    print("seven: could not find SevenOS repository root", file=sys.stderr)
    sys.exit(1)


ROOT_DIR = resolve_root()


def is_dry_run(args):
    return args.dry_run or os.environ.get("SEVENOS_DRY_RUN") == "1"


def run(command, args):
    if is_dry_run(args):
        print(" ".join(shlex.quote(str(part)) for part in command))
        return
    try:
        subprocess.run(command, check=True)
    except subprocess.CalledProcessError as exc:
        if getattr(args, "json", False):
            sys.exit(exc.returncode)
        short = " ".join(shlex.quote(str(part)) for part in command[:4])
        print(f"seven: command failed with exit code {exc.returncode}: {short}", file=sys.stderr)
        if len(command) > 4:
            print("seven: see the message above for the exact cause.", file=sys.stderr)
        sys.exit(exc.returncode)


def install_target(target, args, extra=None):
    extra = extra or []
    run([str(ROOT_DIR / "install.sh"), target, *extra], args)


def sevenpkg(args, *extra):
    run([str(ROOT_DIR / "bin" / "sevenpkg"), *extra], args)


def run_script(args, relative_path, *extra):
    run([str(ROOT_DIR / relative_path), *extra], args)


def run_script_with_dry_env(relative_path, *extra):
    env = os.environ.copy()
    env["SEVENOS_DRY_RUN"] = "1"
    try:
        subprocess.run([str(ROOT_DIR / relative_path), *extra], check=True, env=env)
    except subprocess.CalledProcessError as exc:
        print(f"seven: command failed with exit code {exc.returncode}: {relative_path}", file=sys.stderr)
        sys.exit(exc.returncode)


def capture_json(command, fallback, env=None, cwd=None):
    result = subprocess.run(command, cwd=cwd or ROOT_DIR, text=True, capture_output=True, check=False, env=env)
    if result.returncode != 0:
        return fallback
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return fallback


def primary_payload():
    daily = capture_json(
        [str(ROOT_DIR / "bin" / "seven-daemon"), "daily", "--json"],
        {"decision": "unknown", "summary": {}, "blockers": [], "warnings": [], "actions": []},
    )
    shield = capture_json(
        [str(ROOT_DIR / "security" / "shield-status.sh"), "--json"],
        {"percent": 0, "posture": "unknown", "recommendations": []},
    )
    profiles = capture_json(
        [str(ROOT_DIR / "bin" / "seven-daemon"), "profile-plan", "--json"],
        {"summary": {}, "next": []},
    )
    atlas = capture_json(
        [str(ROOT_DIR / "bin" / "seven-profile-requirements"), "status", "atlas", "--json"],
        {"summary": {"ready": False, "required_missing": 0}},
    )
    core = capture_json(
        [str(ROOT_DIR / "scripts" / "core.sh"), "health", "--json"],
        {"state": "unknown", "checks": []},
    )
    flatpak = capture_json(
        [str(ROOT_DIR / "scripts" / "flatpak.sh"), "status", "--json"],
        {"ready": False, "installed": 0, "total": 0},
    )
    server = capture_json(
        [str(ROOT_DIR / "server" / "seven-server.sh"), "status", "--json"],
        {"state": "unknown", "runtime_ready": False},
    )

    daily_summary = daily.get("summary", {}) if isinstance(daily.get("summary"), dict) else {}
    blockers = daily.get("blockers", []) or []
    profile_next = profiles.get("next", []) or []
    critical_profiles = [
        item for item in profile_next
        if item.get("priority") in ("critical", "high")
    ]
    decision = daily.get("decision", "unknown")
    if decision == "ready":
        primary_state = "ready"
    elif len(blockers) <= 1 and int(daily_summary.get("readiness", 0) or 0) >= 85:
        primary_state = "usable-with-caution"
    else:
        primary_state = "not-ready"

    next_actions = []
    for item in blockers[:4]:
        next_actions.append({
            "title": item.get("title", item.get("key", "Gate")),
            "command": item.get("command", "seven daily plan"),
            "reason": item.get("reason", "Resolve daily-driver blocker"),
            "impact": "packages" if "install" in item.get("command", "") or "improve" in item.get("command", "") else "safe",
        })
    if critical_profiles:
        next_actions.append({
            "title": "Bootstrap profile workspaces",
            "command": "seven profile bootstrap all",
            "reason": "Profiles need visible workspaces, checklists and launchers after package installation.",
            "impact": "safe",
        })
    if not flatpak.get("ready"):
        next_actions.append({
            "title": "Prepare Flatpak app delivery",
            "command": "seven flatpak setup",
            "reason": "Mainstream desktop apps should not depend only on pacman or AUR.",
            "impact": "packages",
        })

    return {
        "schema": "sevenos.primary-pc.v1",
        "decision": primary_state,
        "daily_decision": decision,
        "summary": {
            "readiness": daily_summary.get("readiness", 0),
            "shield": shield.get("percent", daily_summary.get("shield", 0)),
            "profiles_open": profiles.get("summary", {}).get("total", len(profile_next)),
            "critical_profiles": len(critical_profiles),
            "atlas_ready": bool((atlas.get("summary") or {}).get("ready", False)),
            "atlas_missing": int((atlas.get("summary") or {}).get("required_missing", 0) or 0),
            "core_state": core.get("state", "unknown"),
            "server_state": "RUN" if server.get("runtime_ready") else server.get("state", "unknown"),
            "flatpak_ready": bool(flatpak.get("ready", False)),
            "flatpak_apps": f"{flatpak.get('installed', 0)}/{flatpak.get('total', 0)}",
        },
        "blockers": blockers,
        "warnings": daily.get("warnings", []) or [],
        "next_actions": next_actions[:8],
    }


def print_primary_human(payload):
    summary = payload.get("summary", {})
    print("SevenOS Primary PC Gate")
    print("=======================")
    print(f"Decision: {payload.get('decision', 'unknown')}")
    print(f"Daily gate: {payload.get('daily_decision', 'unknown')}")
    print(f"Readiness: {summary.get('readiness', 0)}%")
    print(f"Shield: {summary.get('shield', 0)}%")
    print(f"Profiles open: {summary.get('profiles_open', 0)} ({summary.get('critical_profiles', 0)} critical/high)")
    print(f"Atlas: {'ready' if summary.get('atlas_ready') else 'not ready'} ({summary.get('atlas_missing', 0)} missing)")
    print(f"Core: {summary.get('core_state', 'unknown')}")
    print(f"Server: {summary.get('server_state', 'unknown')}")
    print(f"Flatpak: {'ready' if summary.get('flatpak_ready') else 'not ready'} ({summary.get('flatpak_apps', '0/0')})")
    print()
    actions = payload.get("next_actions", [])
    if actions:
        print("Next actions:")
        for item in actions:
            print(f"- {item.get('title')}: {item.get('command')}")
            print(f"  {item.get('reason')}")
    else:
        print("Next actions: none")


def print_readiness_human(payload):
    print("SevenOS Readiness")
    print("=================")
    print(f"State: {payload.get('state', 'unknown')}")
    print(f"Score: {payload.get('percent', payload.get('score', 0))}%")
    print(f"Source: {payload.get('writer', 'unknown')}")
    print()
    categories = payload.get("categories", [])
    if isinstance(categories, dict):
        categories = list(categories.values())
    if categories:
        print("Categories:")
        for item in categories:
            if not isinstance(item, dict):
                continue
            title = item.get("title", item.get("key", "Gate"))
            actual = item.get("actual", item.get("score", 0))
            if "percent" in item:
                actual = item.get("percent", actual)
            target = item.get("target", "-")
            state = item.get("state", "unknown")
            metric = f"{actual}%" if target in (None, "-", "") else f"{actual}/{target}"
            print(f"- {title}: {metric} ({state})")
    recommendations = payload.get("recommendations", [])
    if recommendations:
        print()
        print("Next actions:")
        for item in recommendations[:6]:
            title = item.get("title") or str(item.get("category", "Improve")).replace("-", " ").title()
            print(f"- {title}: {item.get('command', 'seven core readiness')}")


def print_daily_human(payload):
    summary = payload.get("summary", {}) if isinstance(payload.get("summary"), dict) else {}
    print("SevenOS Daily Gate")
    print("==================")
    print(f"Decision: {payload.get('decision', 'unknown')}")
    print(f"Readiness: {summary.get('readiness', 0)}%")
    print(f"Source: {payload.get('writer', 'unknown')}")
    blockers = payload.get("blockers", []) or []
    warnings = payload.get("warnings", []) or []
    if blockers:
        print()
        print("Blockers:")
        for item in blockers[:6]:
            print(f"- {item.get('title', item.get('key', 'Gate'))}: {item.get('command', 'seven core daily')}")
    if warnings:
        print()
        print("Warnings:")
        for item in warnings[:6]:
            print(f"- {item.get('title', item.get('key', 'Gate'))}: {item.get('command', 'seven core daily')}")
    if not blockers and not warnings:
        print()
        print("No active blocker reported by the native gate.")


def handle_profile(args):
    if args.name == "activate" and args.extra:
        extra = [args.extra[0], *args.extra[1:]]
        if args.json:
            extra.append("--json")
        run_script(args, "scripts/profile-switch-workflow.sh", *extra)
        return
    extra = [args.name, *args.extra]
    if args.json:
        extra.append("--json")
    run_script(args, "profiles/profile-manager.sh", *extra)


def handle_profile_packs(args):
    extra = [args.action]
    if args.profile:
        extra.append(args.profile)
    if args.pack:
        extra.append(args.pack)
    if args.json:
        extra.append("--json")
    if args.yes:
        extra.append("--yes")
    if is_dry_run(args) or getattr(args, "pack_dry_run", False):
        extra.append("--dry-run")
        run_script_with_dry_env("bin/seven-profile-packs", *extra)
        return
    run_script(args, "bin/seven-profile-packs", *extra)


def handle_mini_os(args):
    extra = [args.action, *args.items]
    if args.json:
        extra.append("--json")
    if args.yes:
        extra.append("--yes")
    run_script(args, "scripts/mini-os-bridge.sh", *extra)


def handle_bridge(args):
    extra = [args.action, *args.items]
    if args.source:
        extra.extend(["--from", args.source])
    if args.target:
        extra.extend(["--to", args.target])
    if args.profile:
        extra.extend(["--profile", args.profile])
    if args.kind:
        extra.extend(["--kind", args.kind])
    if args.title:
        extra.extend(["--title", args.title])
    if args.rights:
        extra.extend(["--rights", args.rights])
    if args.limit is not None:
        extra.extend(["--limit", str(args.limit)])
    for flag_name, flag_value in (
        ("--app", getattr(args, "app", None)),
        ("--path", getattr(args, "path", None)),
        ("--task", getattr(args, "task", None)),
        ("--mood", getattr(args, "mood", None)),
        ("--pin", getattr(args, "pin", None)),
    ):
        if flag_value:
            extra.extend([flag_name, flag_value])
    if getattr(args, "apply", False):
        extra.append("--apply")
    if args.json:
        extra.append("--json")
    run_script(args, "scripts/mini-os-relay.sh", *extra)


def handle_baobab(args):
    raw_extra = list(getattr(args, "extra", []) or [])
    wants_json = bool(getattr(args, "json", False) or "--json" in raw_extra)
    if args.action == "guide":
        extra = ["--json"] if wants_json else []
        run_script(args, "bin/seven-baobab-guide", *extra)
        return
    extra = [args.action, *(item for item in raw_extra if item != "--json")]
    if wants_json:
        extra.append("--json")
    run_script(args, "scripts/baobab.sh", *extra)


def handle_autonomy(args):
    if getattr(args, "full", False):
        extra = [args.action]
        if args.json:
            extra.append("--json")
        run_script(args, "scripts/autonomy.sh", *extra)
        return
    if args.action == "json":
        args.json = True
    payload = capture_json(
        [str(ROOT_DIR / "bin" / "seven-daemon"), "autonomy", "--json"],
        {"schema": "sevenos.autonomy.v2", "level": "unknown", "score": 0, "checks": []},
    )
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    summary = payload.get("summary", {}) if isinstance(payload.get("summary"), dict) else {}
    print("SevenOS Distribution Autonomy")
    print("=============================")
    print(f"Level: {payload.get('level', 'unknown')}")
    print(f"Score: {payload.get('score', 0)}%")
    print(f"Checks: {summary.get('ok', 0)}/{summary.get('checks', 0)} OK, {summary.get('partial', 0)} partial")
    print(f"Arch visible: {str(summary.get('arch_visible', True)).lower()}")
    for item in (payload.get("issues") or payload.get("checks") or [])[:8]:
        if isinstance(item, dict):
            print(f"- {item.get('state', 'unknown')}: {item.get('title', item.get('key', 'Check'))}")
            print(f"  {item.get('detail', '')}")
    return


