    def metric_state(self, value: int, warn: int, danger: int) -> str:
        if value >= danger:
            return "danger"
        if value >= warn:
            return "warn"
        return "normal"

    def pressure_text(self, value: int, warn: int, danger: int) -> str:
        state = self.metric_state(value, warn, danger)
        if state == "danger":
            return tr("Critique", "Critical")
        if state == "warn":
            return tr("Chargé", "Busy")
        return tr("Calme", "Calm")

    def pressure_chip(self, label: str, value: int, warn: int, danger: int) -> Gtk.Label:
        chip = Gtk.Label(label=f"{label} · {self.pressure_text(value, warn, danger)}", xalign=0.5)
        chip.get_style_context().add_class("home-pressure-chip")
        state = self.metric_state(value, warn, danger)
        if state in {"warn", "danger"}:
            chip.get_style_context().add_class(state)
        chip.set_ellipsize(Pango.EllipsizeMode.END)
        return chip

    def pressure_row(self, items: list[tuple[str, int, int, int]]) -> Gtk.Box:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        row.get_style_context().add_class("home-pressure-row")
        for label, value, warn, danger in items:
            row.pack_start(self.pressure_chip(label, value, warn, danger), True, True, 0)
        return row

    def card_state(self, key: str, runtime: dict) -> str:
        if key == "system":
            return self.metric_state(max(int(runtime["cpu"]), int(runtime["memory"])), 80, 92)
        if key == "storage":
            return self.metric_state(int(runtime["disk"]), 85, 94)
        if key == "network":
            return "good" if str(runtime["network"]).lower() in {"connected", "online"} else "warn"
        if key == "doctor":
            issues = int(runtime.get("doctor", {}).get("issues") or 0)
            if issues >= 3:
                return "danger"
            if issues > 0:
                return "warn"
            return "good"
        return "normal"

