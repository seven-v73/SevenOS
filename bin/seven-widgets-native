def ai_proactive_state(timeout: float = 2.2) -> dict:
    text = run([str(ROOT / "bin/seven"), "ai", "proactive", "--json"], timeout=timeout)
    try:
        data = json.loads(text or "{}")
    except json.JSONDecodeError:
        data = {}
    cards = data.get("cards") or data.get("suggestions") or []
    if not isinstance(cards, list):
        cards = []
    return {
        "state": str(data.get("state") or "local"),
        "cards": [item for item in cards if isinstance(item, dict)][:4],
    }


def ai_recent_context() -> dict:
    text = run([str(ROOT / "bin/seven"), "ai", "learning", "history", "--json"], timeout=2.2)
    try:
        data = json.loads(text or "{}")
    except json.JSONDecodeError:
        data = {}
    recent = data.get("recent_documents") if isinstance(data.get("recent_documents"), list) else []
    timeline = data.get("timeline") if isinstance(data.get("timeline"), list) else []
    return {
        "recent_documents": [item for item in recent if isinstance(item, dict)][:4],
        "timeline": [item for item in timeline if isinstance(item, dict)][:2],
    }


def network_state() -> str:
    text = run(["nmcli", "-t", "-f", "STATE", "general"], timeout=1.0)
    return text or "unknown"


def network_identity() -> dict:
    text = run(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active"], timeout=1.0)
    active: list[dict] = []
    for raw in text.splitlines():
        parts = raw.split(":", 2)
        if len(parts) != 3:
            continue
        name, kind, device = (part.strip() for part in parts)
        if not name or kind in {"loopback", "bridge", "tun", "tap", "vpn"}:
            continue
        active.append({"name": name, "type": kind, "device": device})
    preferred = None
    for kind in ("802-11-wireless", "wifi", "ethernet", "802-3-ethernet"):
        preferred = next((item for item in active if item["type"] == kind), None)
        if preferred:
            break
    if not preferred and active:
        preferred = active[0]
    if not preferred:
        return {"name": "", "type": "", "device": "", "label": ""}
    kind_label = tr("Wi-Fi", "Wi-Fi") if preferred["type"] in {"802-11-wireless", "wifi"} else tr("Ethernet", "Ethernet")
    return {
        **preferred,
        "label": f"{kind_label} · {preferred['name']}",
    }


def seven_notes() -> list[dict]:
    if SEVEN_NOTES_FILE.exists():
        try:
            data = json.loads(SEVEN_NOTES_FILE.read_text(encoding="utf-8"))
            notes = data.get("notes") if isinstance(data, dict) else data
            if isinstance(notes, list):
                return [item for item in notes if isinstance(item, dict)]
        except Exception:
            pass
    if NOTE_FILE.exists():
        text = NOTE_FILE.read_text(encoding="utf-8", errors="ignore").strip()
        if text:
            return [{"id": "legacy", "title": tr("Mémo rapide", "Quick memo"), "body": text, "updated": int(NOTE_FILE.stat().st_mtime)}]
    return []


def add_widget_note(text: str) -> None:
    text = text.strip()
    if not text:
        return
    subprocess.run([str(ROOT / "bin/seven-notes"), "add", text], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def current_workspace() -> str:
    text = run(["hyprctl", "activeworkspace", "-j"], timeout=0.5)
    try:
        data = json.loads(text or "{}")
    except json.JSONDecodeError:
        return "unknown"
    return str(data.get("id") or data.get("name") or "unknown")


def hypr_json(args: list[str], fallback):
    if not shutil.which("hyprctl"):
        return fallback
    text = run(["hyprctl", *args], timeout=0.6)
    try:
        return json.loads(text or "")
    except (TypeError, json.JSONDecodeError):
        return fallback


def focused_monitor_geometry() -> tuple[int, int, int, int]:
    monitors = hypr_json(["monitors", "-j"], [])
    if isinstance(monitors, list):
        for monitor in monitors:
            if isinstance(monitor, dict) and monitor.get("focused"):
                return (
                    int(monitor.get("x") or 0),
                    int(monitor.get("y") or 0),
                    int(monitor.get("width") or 1920),
                    int(monitor.get("height") or 1080),
                )
        for monitor in monitors:
            if isinstance(monitor, dict):
                return (
                    int(monitor.get("x") or 0),
                    int(monitor.get("y") or 0),
                    int(monitor.get("width") or 1920),
                    int(monitor.get("height") or 1080),
                )
    return (0, 0, 1920, 1080)


def desktop_client() -> dict | None:
    clients = hypr_json(["clients", "-j"], [])
    if not isinstance(clients, list):
        return None
    for client in clients:
        if not isinstance(client, dict):
            continue
        if str(client.get("title") or "") == "Seven Widgets Desktop":
            return client
    return None


def center_desktop_home_window() -> None:
    client = desktop_client()
    if not client or not shutil.which("hyprctl"):
        return
    address = str(client.get("address") or "")
    size = client.get("size") if isinstance(client.get("size"), list) else []
    if not address or len(size) < 2:
        return
    mx, my, mw, mh = focused_monitor_geometry()
    width = int(size[0] or 0)
    height = int(size[1] or 0)
    x = mx + max(24, int((mw - width) / 2))
    y = my + max(36, int((mh - height) / 2))
    subprocess.run(
        ["hyprctl", "dispatch", "movewindowpixel", f"exact {x} {y},address:{address}"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def home_greeting() -> str:
    hour = time.localtime().tm_hour
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "Seven"
    if lang_is_fr():
        if 5 <= hour < 12:
            prefix = "Bonjour"
        elif 12 <= hour < 18:
            prefix = "Bon après-midi"
        else:
            prefix = "Bonsoir"
        return f"{prefix}, {user}"
    if 5 <= hour < 12:
        prefix = "Good morning"
    elif 12 <= hour < 18:
        prefix = "Good afternoon"
    else:
        prefix = "Good evening"
    return f"{prefix}, {user}"


def home_day_phase() -> str:
    hour = time.localtime().tm_hour
    if 5 <= hour < 12:
        return tr("Matin calme", "Calm morning")
    if 12 <= hour < 18:
        return tr("Après-midi actif", "Active afternoon")
    if 18 <= hour < 23:
        return tr("Soirée légère", "Light evening")
    return tr("Nuit focus", "Night focus")


def profile_mission(profile: str) -> str:
    return {
        "equinox": tr("Centre calme pour piloter SevenOS", "Calm center for steering SevenOS"),
        "forge": tr("Développement, code et automatisation", "Development, code and automation"),
        "studio": tr("Création, média et production", "Creation, media and production"),
        "shield": tr("Sécurité, audit et protection", "Security, audit and protection"),
        "atlas": tr("Lecture, recherche et connaissance", "Reading, research and knowledge"),
        "baobab": tr("Culture, mémoire et transmission", "Culture, memory and transmission"),
        "pulse": tr("Gaming, performance et divertissement", "Gaming, performance and entertainment"),
    }.get(str(profile).lower(), tr("Espace SevenOS actif", "Active SevenOS space"))


def display_network_state(value: str) -> str:
    text = str(value or "unknown").lower()
    if text in {"connected", "online"}:
        return tr("Connecté", "Connected")
    if text in {"disconnected", "offline", "none"}:
        return tr("Hors ligne", "Offline")
    return str(value or tr("Inconnu", "Unknown"))


def display_readiness_state(value: str) -> str:
    text = str(value or "unknown").lower()
    if text in {"healthy", "ready", "ok", "public-ready", "public-release-ready"}:
        return tr("Prêt", "Ready")
    if text in {"attention", "needs-attention", "partial", "fragmented"}:
        return tr("À surveiller", "Needs attention")
    if text in {"blocked", "failed", "error"}:
        return tr("Bloqué", "Blocked")
    if text in {"unknown", ""}:
        return tr("À vérifier", "Check")
    return str(value)


def home_brief(runtime: dict) -> str:
    if str(runtime.get("network", "")).lower() not in {"connected", "online"}:
        return tr("Connexion à vérifier avant les actions en ligne", "Check connection before online actions")
    if int(runtime.get("disk") or 0) >= 90:
        return tr("Espace disque presque plein", "Storage is nearly full")
    if int(runtime.get("memory") or 0) >= 85:
        return tr("Mémoire élevée, ferme les apps inutiles", "Memory is high, close unused apps")
    if int(runtime.get("cpu") or 0) >= 85:
        return tr("Charge CPU élevée", "CPU load is high")
    doctor = runtime.get("doctor", {})
    issues = int(doctor.get("issues") or 0)
    if issues > 0:
        return tr(f"{issues} point(s) à surveiller", f"{issues} point(s) need attention")
    return tr("Tout est calme, SevenOS est prêt", "Everything is calm, SevenOS is ready")


def home_recommendation(payload: dict) -> dict:
    runtime = payload.get("runtime", {})
    network = str(runtime.get("network") or "").lower()
    if network not in {"connected", "online"}:
        return {
            "title": tr("Connecter le Wi-Fi", "Connect Wi-Fi"),
            "detail": tr("Internet améliore mises à jour, Store et aide SevenAI.", "Internet improves updates, Store and SevenAI help."),
            "command": ["seven-wifi"],
            "state": "warn",
        }
    disk = int(runtime.get("disk") or 0)
    if disk >= 90:
        return {
            "title": tr("Libérer de l’espace", "Free storage"),
            "detail": tr("Ouvre Seven Files pour inspecter les gros dossiers.", "Open Seven Files to inspect large folders."),
            "command": ["seven-files"],
            "state": "danger",
        }
    doctor = runtime.get("doctor", {})
    issues = int(doctor.get("issues") or 0) if isinstance(doctor, dict) else 0
    if issues > 0:
        return {
            "title": tr("Vérifier Seven Doctor", "Check Seven Doctor"),
            "detail": tr(f"{issues} point(s) à surveiller avant de continuer.", f"{issues} point(s) need attention before continuing."),
            "command": ["seven", "doctor", "open"],
            "state": "warn",
        }
    notes = seven_notes()
    if notes:
        latest = sorted(notes, key=lambda item: int(item.get("updated") or 0), reverse=True)[0]
        title = str(latest.get("title") or latest.get("body") or tr("Reprendre les notes", "Resume notes")).strip()
        return {
            "title": tr("Reprendre les notes", "Resume notes"),
            "detail": title[:90],
            "command": ["seven-notes"],
            "state": "normal",
        }
    ai_cards = runtime.get("ai", {}).get("cards") if isinstance(runtime.get("ai"), dict) else []
    if isinstance(ai_cards, list) and ai_cards:
        title = str(ai_cards[0].get("title") or tr("Demander à SevenAI", "Ask SevenAI"))
        detail = str(ai_cards[0].get("detail") or "")
        return {
            "title": title[:60],
            "detail": detail[:100] or tr("Suggestion locale disponible.", "Local suggestion available."),
            "command": ["seven-spotlight", "ai"],
            "state": "normal",
        }
    return {
        "title": tr("Demander à SevenAI", "Ask SevenAI"),
        "detail": tr("Pose une question système ou lance une app depuis l’accueil.", "Ask a system question or launch an app from Home."),
        "command": ["seven-spotlight", "ai"],
        "state": "normal",
    }


def home_dimensions(layout: dict) -> tuple[int, int, float, float]:
    base_w = int(layout.get("width") or 1500)
    base_h = int(layout.get("height") or 760)
    display = Gdk.Display.get_default()
    monitor = display.get_primary_monitor() if display else None
    geometry = monitor.get_geometry() if monitor else None
    screen_w = geometry.width if geometry else base_w + 260
    screen_h = geometry.height if geometry else base_h + 260
    width = min(base_w, max(980, screen_w - 260))
    height = min(base_h, max(560, screen_h - 260))
    sx = width / max(base_w, 1)
    sy = height / max(base_h, 1)
    return width, height, sx, sy


def switch_home_workspace() -> None:
    target = str(config().get("home_workspace") or HOME_WORKSPACE)
    if shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "dispatch", "workspace", target], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def move_desktop_to_home() -> None:
    target = str(config().get("home_workspace") or HOME_WORKSPACE)
    if not shutil.which("hyprctl"):
        return
    selectors = (
        f"{target},title:^(Seven Widgets Desktop)$",
        f"{target},class:^(seven-widgets-native)$",
        f"{target},class:^(SevenWidgetsNative)$",
    )
    for selector in selectors:
        subprocess.run(
            ["hyprctl", "dispatch", "movetoworkspacesilent", selector],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    center_desktop_home_window()


def active_window_present() -> bool:
    text = run(["hyprctl", "activewindow", "-j"], timeout=0.5)
    try:
        data = json.loads(text or "{}")
    except json.JSONDecodeError:
        return False
    active_text = " ".join(str(data.get(key) or "") for key in ("class", "title", "initialClass", "initialTitle"))
    allowed_home_surfaces = (
        "Seven Widgets Desktop",
        "Seven Desktop Menu",
        "Seven Widgets",
        "Seven Dock",
        "SevenOS Spotlight",
        "SevenOS Launchpad",
        "SevenOS Quick Settings",
        "SevenOS Notifications",
    )
    if any(item in active_text for item in allowed_home_surfaces):
        return False
    return bool(data.get("class") or data.get("title") or data.get("address"))


def widget_payload(fast: bool = False) -> dict:
    data = config()
    doctor = health_state() if fast else doctor_state()
    update = {} if fast else update_state()
    ai = ai_proactive_state(timeout=1.2) if fast else ai_proactive_state()
    recent = {"recent_documents": [], "timeline": []} if fast else ai_recent_context()
    summary = doctor.get("summary") if isinstance(doctor.get("summary"), dict) else {}
    doctor_decision = doctor.get("decision") or doctor.get("state") or "unknown"
    doctor_score = doctor.get("score", "")
    issue_count = summary.get("issues", doctor.get("issues", 0))
    if not issue_count and str(doctor_decision).lower() in {"healthy", "ready", "ok"}:
        issue_count = 0
    disk = disk_summary()
    return {
        "schema": "sevenos.widgets.status.v1",
        "config": data,
        "catalog": CATALOG,
        "profile": current_profile(),
        "runtime": {
            "cpu": cpu_percent(),
            "memory": memory_percent(),
            "disk": disk["percent"],
            "disk_summary": disk,
            "battery": battery_summary(),
            "media": media_summary(),
            "calendar": month_summary(),
            "weather": weather_summary(data),
            "network": network_state(),
            "network_identity": network_identity(),
            "doctor": {"decision": doctor_decision, "score": doctor_score, "issues": issue_count},
            "updates": {
                "state": update.get("state", "unknown"),
                "score": update.get("score", ""),
                "summary": update.get("summary") or update.get("detail") or "",
            },
            "ai": ai,
            "recent": recent,
            "workspace": current_workspace(),
            "updated": int(time.time()),
        },
    }


