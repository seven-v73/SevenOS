        value.set_ellipsize(Pango.EllipsizeMode.END)
        mark = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        mark.get_style_context().add_class("home-prism-mark")
        spaces = ("equinox", "forge", "studio", "shield", "atlas", "baobab", "pulse")
        for item in spaces:
            node = Gtk.Label(label=item[:1].upper(), xalign=0.5)
