    def render_desktop(self):
        payload = widget_payload(fast=True)
        state = payload["config"]
        layout_name = layout_key(str(state.get("layout")))
        layout = LAYOUTS[layout_name]
        width, height, sx, sy = home_dimensions(layout)
        self.resize(width, height)
        raw_enabled = [key for key in state.get("enabled", []) if key in catalog_keys()]
        if layout_name == "compact-grid":
            calm_keys = ("clock", "notes", "system", "storage", "network", "doctor", "ai")
            enabled = [key for key in calm_keys if key in raw_enabled]
            enabled.extend(key for key in raw_enabled if key not in enabled and key not in {"apps", "recent", "quick", "updates"} and len(enabled) < 7)
        else:
            enabled = raw_enabled
        surface = Gtk.Fixed()
        surface.set_size_request(width, height)

        def place(widget: Gtk.Widget, x: int, y: int, w: int, h: int, min_w: int = 112, min_h: int = 58) -> None:
            widget.set_size_request(max(min_w, int(w * sx)), max(min_h, int(h * sy)))
            surface.put(widget, int(x * sx), int(y * sy))

        def zone_header(text_fr: str, text_en: str, meta: str, kind: str = "", index: str = "") -> Gtk.Box:
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            box.get_style_context().add_class("home-zone-header")
            if index:
                index_label = Gtk.Label(label=index, xalign=0.5)
                index_label.get_style_context().add_class("home-zone-index")
                if kind == "accent":
                    index_label.get_style_context().add_class("accent")
                box.pack_start(index_label, False, False, 0)
            label = Gtk.Label(label=tr(text_fr, text_en), xalign=0)
            label.get_style_context().add_class("home-zone-label")
            label.set_ellipsize(Pango.EllipsizeMode.END)
            chip = Gtk.Label(label=meta, xalign=0.5)
            chip.get_style_context().add_class("home-zone-meta")
            if kind:
                chip.get_style_context().add_class(kind)
            chip.set_ellipsize(Pango.EllipsizeMode.END)
            box.pack_start(label, True, True, 0)
            box.pack_start(chip, False, False, 0)
            return box

        def backdrop(kind: str = "") -> Gtk.Box:
            box = Gtk.Box()
            box.get_style_context().add_class("home-backdrop-zone")
            if kind:
                box.get_style_context().add_class(kind)
            return box

        def stage_band(kind: str = "") -> Gtk.Box:
            box = Gtk.Box()
            box.get_style_context().add_class("home-stage-band")
