        title_label.get_style_context().add_class("widget-kicker")
        free = Gtk.Label(label=str(disk.get("free") or "?"), xalign=0)
        free.get_style_context().add_class("home-storage-free")
        used = Gtk.Label(
            label=tr("{used} utilisé · dossier personnel", "{used} used · home folder").format(used=disk.get("used", "?")),
            xalign=0,
        )
        used.get_style_context().add_class("home-storage-used")
        card.pack_start(title_label, False, False, 0)
        card.pack_start(free, False, False, 0)
        card.pack_start(used, False, False, 0)
        card.pack_start(
            self.pressure_row([(tr("Disque", "Disk"), percent, 85, 94)]),
            False,
            False,
            0,
        )
        if self.mode == "desktop":
            state_class = self.card_state("storage", runtime)
            if state_class in {"good", "warn", "danger"}:
                card.get_style_context().add_class(f"home-state-{state_class}")
            card.get_style_context().add_class("home-widget-clickable")
            card.set_tooltip_text(tr("Cliquer pour ouvrir Seven Files.", "Click to open Seven Files."))
            card.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            card.connect("button-press-event", lambda _w, _e: (subprocess.Popen(["seven-files"]), True)[1])
        return card

    def calendar_widget_card(self, payload: dict):
        runtime = payload["runtime"]
        calendar_data = runtime["calendar"]
        today_index = time.localtime().tm_wday
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        card.get_style_context().add_class("widget")
        title_label = Gtk.Label(label=f"{widget_icon('calendar')}  {tr('Aujourd’hui', 'Today')}", xalign=0)
        title_label.get_style_context().add_class("widget-kicker")
        dateblock = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        dateblock.get_style_context().add_class("home-calendar-dateblock")
        day = Gtk.Label(label=str(calendar_data["day"]), xalign=0)
        day.get_style_context().add_class("home-calendar-day")
        date_labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        month = Gtk.Label(label=str(calendar_data["month"]).title(), xalign=0)
        month.get_style_context().add_class("home-calendar-month")
        week = Gtk.Label(
            label=tr("Semaine {week}", "Week {week}").format(week=calendar_data["week"]),
            xalign=0,
        )
        week.get_style_context().add_class("home-calendar-week")
        date_labels.pack_start(month, False, False, 0)
        date_labels.pack_start(week, False, False, 0)
        dateblock.pack_start(day, False, False, 0)
        dateblock.pack_start(date_labels, True, True, 0)
        week_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        week_row.get_style_context().add_class("home-week-row")
        labels = ("L", "M", "M", "J", "V", "S", "D") if lang_is_fr() else ("M", "T", "W", "T", "F", "S", "S")
        for index, label in enumerate(labels):
            dot = Gtk.Label(label=label, xalign=0.5)
            dot.get_style_context().add_class("home-week-dot")
            if index == today_index:
                dot.get_style_context().add_class("active")
            week_row.pack_start(dot, True, True, 0)
        progress = Gtk.ProgressBar()
        progress.set_fraction(max(0, min(1, float(calendar_data["fraction"]))))
        card.pack_start(title_label, False, False, 0)
        card.pack_start(dateblock, False, False, 0)
        card.pack_start(week_row, False, False, 0)
        card.pack_start(progress, False, False, 0)
        return card

    def network_widget_card(self, payload: dict):
        runtime = payload["runtime"]
        network = str(runtime.get("network") or "unknown")
        identity = runtime.get("network_identity", {}) if isinstance(runtime.get("network_identity"), dict) else {}
        network_name = str(identity.get("name") or "")
        network_label = str(identity.get("label") or network_name)
        connected = network.lower() in {"connected", "online"}
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("widget")
        title_label = Gtk.Label(label=f"{widget_icon('network')}  {tr('Réseau', 'Network')}", xalign=0)
        title_label.get_style_context().add_class("widget-kicker")
        value = Gtk.Label(label=network_name or display_network_state(network), xalign=0)
        value.get_style_context().add_class("home-value")
        value.get_style_context().add_class("home-network-online" if connected else "home-network-offline")
        note = network_label or tr("Connexion active", "Active connection") if connected else tr("Choisis un réseau pour continuer", "Choose a network to continue")
        card.pack_start(title_label, False, False, 0)
        card.pack_start(value, False, False, 0)
        card.pack_start(
            self.status_row(
                tr("Connexion", "Connection"),
                note,
                "good" if connected else "warn",
            ),
            False,
            False,
            0,
        )
        action = self.home_action_button(
            "◆",
            tr("Gérer", "Manage") if connected else tr("Connecter", "Connect"),
            tr("Changer de réseau", "Change network") if connected else tr("Choisir un réseau", "Choose a network"),
            ["seven-wifi"],
        )
        card.pack_start(action, False, False, 0)
        if self.mode == "desktop":
            card.get_style_context().add_class(f"home-state-{'good' if connected else 'warn'}")
        return card

    def doctor_widget_card(self, payload: dict):
        runtime = payload["runtime"]
        doctor = runtime.get("doctor", {})
        issues = int(doctor.get("issues") or 0) if isinstance(doctor, dict) else 0
        decision = display_readiness_state(str(doctor.get("decision") or "unknown")) if isinstance(doctor, dict) else tr("À vérifier", "Check")
        score = str(doctor.get("score") or "OK") if isinstance(doctor, dict) else "OK"
        state = "danger" if issues >= 3 else "warn" if issues > 0 else "normal"
        health_detail = (
            tr("Tout est prêt", "Everything is ready")
            if issues == 0
            else tr(f"{issues} point(s) à surveiller", f"{issues} point(s) need attention")
        )
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("widget")
        title_label = Gtk.Label(label=f"{widget_icon('doctor')}  Seven Doctor", xalign=0)
        title_label.get_style_context().add_class("widget-kicker")
        value = Gtk.Label(label=decision, xalign=0)
        value.get_style_context().add_class("home-value")
        card.pack_start(title_label, False, False, 0)
        card.pack_start(value, False, False, 0)
        card.pack_start(
            self.status_row(
                tr("Santé", "Health"),
                health_detail,
                state,
            ),
            False,
            False,
            0,
        )
        card.set_tooltip_text(
            tr("Seven Doctor · score {score} · {issues} alerte(s)", "Seven Doctor · score {score} · {issues} alert(s)").format(
                score=score,
                issues=issues,
            )
        )
        action = self.home_action_button("✦", tr("Ouvrir", "Open"), tr("Diagnostic SevenOS", "SevenOS diagnostics"), ["seven", "doctor", "open"])
        card.pack_start(action, False, False, 0)
        if self.mode == "desktop":
            state_class = self.card_state("doctor", runtime)
            if state_class in {"good", "warn", "danger"}:
                card.get_style_context().add_class(f"home-state-{state_class}")
        return card

    def prism_widget_card(self, payload: dict):
        profile = payload["profile"]
