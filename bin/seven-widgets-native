            card.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            card.connect("button-press-event", lambda _w, _e: (subprocess.Popen(["seven-settings", "prism"]), True)[1])
        return card

    def clock_widget_card(self, payload: dict):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("widget")
        runtime = payload["runtime"]
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        phase = Gtk.Label(label=home_day_phase(), xalign=0)
        phase.get_style_context().add_class("home-clock-phase")
        profile = Gtk.Label(label=tr(f"{payload['profile'].title()} actif", f"{payload['profile'].title()} active"), xalign=1)
        profile.get_style_context().add_class("home-clock-profile")
        profile.set_ellipsize(Pango.EllipsizeMode.END)
        top.pack_start(phase, False, False, 0)
        top.pack_start(profile, True, True, 0)
        clock = Gtk.Label(label=time.strftime("%H:%M"), xalign=0)
        clock.get_style_context().add_class("home-clock-time")
        date = Gtk.Label(label=time.strftime("%A %d %B"), xalign=0)
        date.get_style_context().add_class("home-clock-date")
        now = time.localtime()
        day_fraction = ((now.tm_hour * 60) + now.tm_min) / (24 * 60)
        rhythm = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        rhythm.get_style_context().add_class("home-day-rhythm")
        rhythm_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        rhythm_label = Gtk.Label(label=tr("Rythme du jour", "Day rhythm"), xalign=0)
        rhythm_label.get_style_context().add_class("home-day-rhythm-label")
        rhythm_value = Gtk.Label(label=f"{int(day_fraction * 100)}%", xalign=1)
        rhythm_value.get_style_context().add_class("home-day-rhythm-value")
        rhythm_header.pack_start(rhythm_label, True, True, 0)
        rhythm_header.pack_start(rhythm_value, False, False, 0)
        rhythm_rail = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        rhythm_rail.get_style_context().add_class("home-day-rail")
        for index in range(4):
            segment = Gtk.Box()
            segment.get_style_context().add_class("home-day-segment")
            if day_fraction >= (index + 1) / 4:
                segment.get_style_context().add_class("passed")
            elif day_fraction >= index / 4:
                segment.get_style_context().add_class("active")
            rhythm_rail.pack_start(segment, True, True, 0)
        rhythm.pack_start(rhythm_header, False, False, 0)
        rhythm.pack_start(rhythm_rail, False, False, 0)
        brief = Gtk.Label(label=home_brief(runtime), xalign=0.5)
        brief.get_style_context().add_class("home-clock-trust")
        brief.set_line_wrap(True)
        brief.set_ellipsize(Pango.EllipsizeMode.END)
        card.pack_start(top, False, False, 0)
        card.pack_start(clock, False, False, 0)
        card.pack_start(date, False, False, 0)
        card.pack_start(rhythm, False, False, 0)
        card.pack_start(brief, False, False, 0)
        return card

    def ai_widget_card(self, payload: dict):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        card.get_style_context().add_class("widget")
        ai = payload["runtime"].get("ai", {})
        cards = ai.get("cards") if isinstance(ai.get("cards"), list) else []
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title_label = Gtk.Label(label=f"{widget_icon('ai')}  SevenAI", xalign=0)
        title_label.get_style_context().add_class("widget-kicker")
        state = Gtk.Label(label=tr("local", "local"), xalign=1)
        state.get_style_context().add_class("home-ai-state")
        header.pack_start(title_label, True, True, 0)
        header.pack_start(state, False, False, 0)
        value_label = Gtk.Label(label=tr("Assistant local", "Local assistant"), xalign=0)
        value_label.get_style_context().add_class("home-value")
        value_label.set_line_wrap(True)
        card.pack_start(header, False, False, 0)
        card.pack_start(value_label, False, False, 0)
        suggestion_title = tr("Demande-moi l’état du système", "Ask me about system state")
        suggestion_detail = tr(
            "Réponses locales, actions sensibles prévisualisées.",
            "Local answers, sensitive actions previewed.",
        )
        if cards:
            item = cards[0]
            suggestion_title = str(item.get("title") or item.get("key") or suggestion_title)
            suggestion_detail = str(item.get("detail") or suggestion_detail)
        hint = Gtk.Label(label=suggestion_detail, xalign=0)
        hint.get_style_context().add_class("home-ai-hint")
        hint.set_line_wrap(True)
        hint.set_ellipsize(Pango.EllipsizeMode.END)
        if hasattr(hint, "set_lines"):
            hint.set_lines(2)
        card.pack_start(hint, False, False, 0)
        answer = Gtk.Label(
            label=suggestion_title,
            xalign=0,
        )
        answer.get_style_context().add_class("home-ai-answer")
        answer.set_line_wrap(True)
        answer.set_max_width_chars(42)
        answer.set_ellipsize(Pango.EllipsizeMode.END)
        if hasattr(answer, "set_lines"):
            answer.set_lines(2)
        capture = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        capture.get_style_context().add_class("home-ai-capture")
        prompt = Gtk.Entry()
        prompt.set_placeholder_text(tr("Demander à SevenAI...", "Ask SevenAI..."))
        prompt.set_tooltip_text(tr("SevenAI répond localement avec les garde-fous SevenOS.", "SevenAI answers locally with SevenOS safeguards."))
        send = Gtk.Button(label="↵")
        send.get_style_context().add_class("home-ai-send")
        send.set_tooltip_text(tr("Envoyer", "Send"))
        capture.pack_start(prompt, True, True, 0)
        capture.pack_start(send, False, False, 0)

        def ask_home_ai(*_args):
            text = prompt.get_text().strip()
            if not text:
                subprocess.Popen(["seven-spotlight", "ai"])
                return
            prompt.set_text("")
            answer.set_text(tr("SevenAI réfléchit localement...", "SevenAI is thinking locally..."))
            send.set_sensitive(False)

            def worker():
                try:
                    proc = subprocess.run(
                        ["seven", "ai", text],
                        text=True,
                        capture_output=True,
                        check=False,
                        timeout=12,
                    )
                    output = proc.stdout.strip() or proc.stderr.strip()
                    if proc.returncode != 0 and not output:
                        output = tr("Je n'ai pas pu répondre pour l'instant.", "I could not answer right now.")
                except subprocess.TimeoutExpired:
                    output = tr("SevenAI prend trop de temps. Ouvre Spotlight AI pour continuer.", "SevenAI is taking too long. Open Spotlight AI to continue.")
                except Exception:
                    output = tr("SevenAI n'est pas disponible pour l'instant.", "SevenAI is not available right now.")

                def done():
                    answer.set_text(compact_ai_answer(output))
                    send.set_sensitive(True)
                    return False

                GLib.idle_add(done)

            threading.Thread(target=worker, daemon=True).start()

        prompt.connect("activate", ask_home_ai)
        send.connect("clicked", ask_home_ai)
        card.pack_start(capture, False, False, 0)
        card.pack_start(answer, False, False, 0)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.get_style_context().add_class("home-action-row")
        ask = self.home_action_button("◉", tr("Ouvrir AI", "Open AI"), tr("Discussion complète", "Full chat"), ["seven-spotlight", "ai"])
        status = self.home_action_button("⌁", tr("État", "Status"), tr("Diagnostic SevenAI", "SevenAI diagnostic"), ["seven", "ai", "doctor"])
        row.pack_start(ask, True, True, 0)
        row.pack_start(status, True, True, 0)
        card.pack_start(row, False, False, 0)
        return card

