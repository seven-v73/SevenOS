            return box

        def breathing_zone() -> Gtk.Box:
            box = Gtk.Box()
            box.get_style_context().add_class("home-breathing-zone")
            return box

        def anchor_mark() -> Gtk.Label:
            mark = Gtk.Label(label=tr("Accueil SevenOS", "SevenOS Home"), xalign=0.5)
            mark.get_style_context().add_class("home-anchor-mark")
