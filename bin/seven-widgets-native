        def card_mood_line(zone: str, state_name: str = "") -> Gtk.Box:
            line = Gtk.Box()
            line.get_style_context().add_class("home-card-mood-line")
            if zone:
                line.get_style_context().add_class(zone)
            if state_name in {"warn", "danger"}:
                line.get_style_context().add_class(state_name)
            return line

        def context_chip(text: str, kind: str = "") -> Gtk.Label:
            chip = Gtk.Label(label=text, xalign=0.5)
            chip.get_style_context().add_class("home-context-chip")
            if kind:
                chip.get_style_context().add_class(kind)
            chip.set_ellipsize(Pango.EllipsizeMode.END)
            return chip

        def identity_item(text: str, kind: str = "") -> Gtk.Label:
            item = Gtk.Label(label=text, xalign=0.5)
            item.get_style_context().add_class("home-identity-item")
            if kind:
                item.get_style_context().add_class(kind)
            item.set_ellipsize(Pango.EllipsizeMode.END)
            return item

        if layout_name != "compact-grid":
            place(stage_band("accent"), 10, 78, 380, 660, 120, 80)
            place(stage_band(), 402, 78, 690, 660, 120, 80)
            place(stage_band(), 1094, 78, 398, 660, 120, 80)
            place(breathing_zone(), 392, 300, 700, 190, 120, 80)
            place(horizon(), 18, 746, int(layout["width"]) - 40, 2, 120, 2)
            place(horizon("soft"), 132, 758, int(layout["width"]) - 264, 2, 120, 2)
            place(anchor_mark(), 18, 738, 132, 22, 80, 18)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.get_style_context().add_class("home-header")
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        title = Gtk.Label(label=home_greeting(), xalign=0)
        title.get_style_context().add_class("home-title")
        badge = Gtk.Label(
            label=tr(
                f"Home · workspace {state.get('home_workspace', HOME_WORKSPACE)}",
                f"Home · workspace {state.get('home_workspace', HOME_WORKSPACE)}",
            ),
            xalign=0.5,
        )
        badge.get_style_context().add_class("home-header-badge")
        title_row.pack_start(title, False, False, 0)
        title_row.pack_start(badge, False, False, 0)
        updated = time.strftime("%H:%M", time.localtime(payload["runtime"].get("updated", time.time())))
        subtitle = Gtk.Label(
            label=tr(
                home_brief(payload["runtime"]),
                home_brief(payload["runtime"]),
            ),
            xalign=0,
        )
        subtitle.get_style_context().add_class("home-subtitle")
        labels.pack_start(title_row, False, False, 0)
        labels.pack_start(subtitle, False, False, 0)
        if layout_name != "compact-grid":
            identity = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            identity.get_style_context().add_class("home-identity-strip")
            identity.pack_start(identity_item(home_day_phase(), "accent"), False, False, 0)
            identity.pack_start(identity_item(payload["profile"].title()), False, False, 0)
            identity.pack_start(identity_item(tr(f"Mis à jour {updated}", f"Updated {updated}")), False, False, 0)
            labels.pack_start(identity, False, False, 0)
        runtime = payload["runtime"]
        pressure = max(int(runtime.get("cpu") or 0), int(runtime.get("memory") or 0), int(runtime.get("disk") or 0))
        pressure_kind = self.metric_state(pressure, 85, 94)
        pressure_meta = self.pressure_text(pressure, 85, 94)
        recent_context = runtime.get("recent", {})
        recent_docs = recent_context.get("recent_documents") if isinstance(recent_context, dict) else []
        recent_count = len(recent_docs) if isinstance(recent_docs, list) else 0
        continuity_meta = tr(f"{recent_count} récents", f"{recent_count} recent") if recent_count else tr("Local", "Local")
        if layout_name != "compact-grid":
            pill_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            pill_row.get_style_context().add_class("home-pill-row")
            pill_row.pack_start(self.home_pill("CPU", f"{runtime['cpu']}%", self.metric_state(int(runtime["cpu"]), 80, 92)), False, False, 0)
            pill_row.pack_start(self.home_pill("RAM", f"{runtime['memory']}%", self.metric_state(int(runtime["memory"]), 80, 92)), False, False, 0)
            pill_row.pack_start(self.home_pill("Disk", f"{runtime['disk']}%", self.metric_state(int(runtime["disk"]), 85, 94)), False, False, 0)
            pill_row.pack_start(self.home_pill("Net", display_network_state(str(runtime["network"])), "good" if str(runtime["network"]).lower() in {"connected", "online"} else "warn"), False, False, 0)
            labels.pack_start(pill_row, False, False, 0)
            context_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            context_row.get_style_context().add_class("home-context-row")
            context_row.pack_start(context_chip(profile_mission(payload["profile"]), "accent"), False, False, 0)
            context_row.pack_start(
                context_chip(tr(f"{len(enabled)} widgets actifs", f"{len(enabled)} active widgets")),
                False,
                False,
                0,
            )
            context_row.pack_start(context_chip(layout_title(layout_name)), False, False, 0)
            labels.pack_start(context_row, False, False, 0)
        header.pack_start(labels, True, True, 0)
        if layout_name != "compact-grid":
            presence = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            presence.get_style_context().add_class("home-presence")
            presence_kind = pressure_kind if pressure_kind in {"warn", "danger"} else "good"
            if presence_kind in {"good", "warn", "danger"}:
                presence.get_style_context().add_class(presence_kind)
            presence_orb = Gtk.Box()
            presence_orb.get_style_context().add_class("home-presence-orb")
            if pressure_kind in {"warn", "danger"}:
                presence_orb.get_style_context().add_class(pressure_kind)
            presence_copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            presence_copy.get_style_context().add_class("home-presence-copy")
            if pressure_kind in {"warn", "danger"}:
                presence_copy.get_style_context().add_class(pressure_kind)
            presence_title = Gtk.Label(label=pressure_meta, xalign=0)
            presence_title.get_style_context().add_class("home-presence-title")
            presence_detail = Gtk.Label(
                label=tr(
                    f"{display_network_state(str(runtime['network']))} · {updated}",
                    f"{display_network_state(str(runtime['network']))} · {updated}",
                ),
                xalign=0,
            )
            presence_detail.get_style_context().add_class("home-presence-detail")
            presence_copy.pack_start(presence_title, False, False, 0)
            presence_copy.pack_start(presence_detail, False, False, 0)
            presence.pack_start(presence_orb, False, False, 0)
            presence.pack_start(presence_copy, False, False, 0)
            header.pack_start(presence, False, False, 0)
        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        controls.get_style_context().add_class("home-controls")
        settings = Gtk.Button(label="⚙")
        settings.get_style_context().add_class("home-control-button")
        settings.set_tooltip_text(tr("Modifier les widgets", "Edit widgets"))
        settings.connect("clicked", lambda *_: launch_native("settings"))
        hide = Gtk.Button(label="×")
        hide.get_style_context().add_class("home-control-button")
        hide.set_tooltip_text(tr("Masquer les widgets", "Hide widgets"))
        hide.connect("clicked", lambda *_: hide_widgets())
        controls.pack_start(settings, False, False, 0)
        controls.pack_start(hide, False, False, 0)
        header.pack_start(controls, False, False, 0)
        place(header, 18, 10, int(layout["width"]) - 40, 70)
        if layout_name != "compact-grid":
            place(zone_header("AUJOURD'HUI", "TODAY", home_day_phase(), "accent", "01"), 18, 92, 360, 22, 80, 18)
            place(zone_header("ÉTAT DU SYSTÈME", "SYSTEM STATE", pressure_meta, pressure_kind, "02"), 410, 92, 660, 22, 80, 18)
            place(zone_header("CONTINUITÉ", "CONTINUITY", continuity_meta, "", "03"), 1102, 92, 380, 22, 80, 18)
            place(lane("accent"), 18, 108, 360, 2, 40, 2)
            place(lane(), 410, 108, 660, 2, 40, 2)
            place(lane("soft"), 1102, 108, 380, 2, 40, 2)
            place(shelf("accent"), 18, 690, 360, 1, 40, 1)
            place(shelf(), 410, 690, 660, 1, 40, 1)
            place(shelf("soft"), 1102, 690, 380, 1, 40, 1)
            place(vertical_lane("accent"), 392, 132, 2, 552, 2, 80)
            place(vertical_lane(), 1084, 132, 2, 552, 2, 80)
            place(ambient_dot("active"), 392, 106, 8, 8, 8, 8)
            place(ambient_dot("soft"), 1084, 106, 8, 8, 8, 8)
            place(ambient_dot(), 1480, 106, 8, 8, 8, 8)
            place(rhythm_dot("active"), 390, 132, 6, 6, 6, 6)
            place(rhythm_dot(), 390, 312, 6, 6, 6, 6)
            place(rhythm_dot(), 390, 482, 6, 6, 6, 6)
            place(rhythm_dot("active"), 1082, 132, 6, 6, 6, 6)
            place(rhythm_dot(), 1082, 372, 6, 6, 6, 6)
            place(rhythm_dot(), 1082, 570, 6, 6, 6, 6)
        if not enabled:
            empty = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            empty.get_style_context().add_class("empty-state")
            empty_title = Gtk.Label(label=tr("Aucun widget actif", "No active widgets"), xalign=0)
            empty_title.get_style_context().add_class("value")
            empty_note = Gtk.Label(
                label=tr("Ajoute un preset ou choisis tes widgets pour personnaliser l’accueil.", "Add a preset or choose widgets to personalize Home."),
                xalign=0,
            )
            empty_note.get_style_context().add_class("subtitle")
            preset = Gtk.Button(label=tr("Appliquer le preset actif", "Apply active preset"))
            preset.connect("clicked", lambda *_: (apply_preset("active"), self.render(), show_widgets()))
            empty.pack_start(empty_title, False, False, 0)
            empty.pack_start(empty_note, False, False, 0)
            empty.pack_start(preset, False, False, 0)
            place(empty, 18, 110, 420, 200)
            self.root.pack_start(surface, True, True, 0)
            return

        positions = {
            "clock": (18, 112, 360, 178, "home-hero"),
            "calendar": (18, 310, 174, 150, "home-widget"),
            "prism": (204, 310, 174, 150, "home-widget"),
            "notes": (18, 480, 360, 250, "home-widget"),
            "system": (410, 112, 320, 178, "home-widget"),
            "storage": (750, 112, 320, 178, "home-widget"),
            "network": (410, 310, 320, 150, "home-widget"),
            "doctor": (750, 310, 320, 150, "home-widget"),
            "updates": (410, 480, 320, 178, "home-widget"),
            "quick": (750, 480, 320, 178, "home-widget"),
            "ai": (1102, 112, 380, 190, "home-widget"),
            "apps": (1102, 370, 380, 178, "home-widget"),
            "recent": (1102, 568, 380, 162, "home-widget"),
            "tasks": (410, 480, 320, 178, "home-widget"),
            "media": (750, 480, 320, 178, "home-widget"),
            "battery": (750, 480, 320, 178, "home-widget"),
            "mini-os": (204, 310, 174, 150, "home-widget"),
            "weather": (18, 310, 174, 150, "home-widget"),
        }
        fallback_slots = [
            (410, 670, 320, 70, "home-widget"),
            (750, 670, 320, 70, "home-widget"),
            (1102, 670, 380, 70, "home-widget"),
        ]
        used: set[tuple[int, int]] = set()
        fallback_index = 0
        for key in enabled:
            if key in positions:
                x, y, width, height, style_class = positions[key]
                if (x, y) in used:
                    continue
            elif fallback_index < len(fallback_slots):
                x, y, width, height, style_class = fallback_slots[fallback_index]
                fallback_index += 1
            else:
                continue
            used.add((x, y))
            card = self.widget_card(key, payload)
            card.get_style_context().add_class(style_class)
            card.get_style_context().add_class(f"home-widget-{key}")
            zone_name = "continuity"
            if x < 392:
                card.get_style_context().add_class("home-zone-today-card")
                zone_name = "today"
            elif x < 1084:
                card.get_style_context().add_class("home-zone-system-card")
                zone_name = "system"
            else:
                card.get_style_context().add_class("home-zone-continuity-card")
                zone_name = "continuity"
            if layout_name == "compact-grid":
                card.get_style_context().add_class("compact")
            if layout_name == "focus-stack":
                card.get_style_context().add_class("focus")
            state_class = self.card_state(key, payload["runtime"])
            if hasattr(card, "pack_end"):
                card.pack_end(card_mood_line(zone_name, state_class), False, False, 0)
            place(card, x, y, width, height)
        if layout_name != "compact-grid":
            place(self.home_today_strip(payload), 18, 708, int(layout["width"]) - 40, 46, 120, 38)
        self.root.pack_start(surface, True, True, 0)

    def widget_card(self, key: str, payload: dict):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("widget")
        runtime = payload["runtime"]
        profile = payload["profile"]
        if key == "clock":
            return self.clock_widget_card(payload)
        if key == "notes":
            return self.notes_widget_card(payload)
        if key == "tasks":
            return self.tasks_widget_card(payload)
        if key == "mini-os":
            return self.mini_os_widget_card(payload)
        if key == "quick":
            return self.quick_widget_card(payload)
        if key == "ai":
            return self.ai_widget_card(payload)
        if key == "recent":
            return self.recent_widget_card(payload)
        if key == "apps":
            return self.apps_widget_card(payload)
        if key == "system":
            return self.system_widget_card(payload)
        if key == "storage":
            return self.storage_widget_card(payload)
        if key == "calendar":
            return self.calendar_widget_card(payload)
        if key == "network":
            return self.network_widget_card(payload)
        if key == "doctor":
            return self.doctor_widget_card(payload)
        if key == "prism":
            return self.prism_widget_card(payload)
        title, value, note, fraction, action = {
            "clock": (tr("Horloge", "Clock"), time.strftime("%H:%M"), time.strftime("%A %d %B"), None, None),
            "system": (tr("Système", "System"), f"CPU {runtime['cpu']}%", f"RAM {runtime['memory']}% · Disk {runtime['disk']}%", runtime["cpu"] / 100, ["seven", "doctor"]),
            "battery": (
                tr("Énergie", "Power"),
                f"{runtime['battery']['percent']}%" if runtime["battery"].get("percent") is not None else runtime["battery"].get("status", "AC"),
                f"{runtime['battery'].get('status', '')} · {runtime['battery'].get('profile', 'balanced')}",
                (runtime["battery"].get("percent") or 0) / 100 if runtime["battery"].get("percent") is not None else None,
                ["seven-settings", "power"],
            ),
            "storage": (
                tr("Stockage", "Storage"),
                runtime["disk_summary"].get("free", "?"),
                tr("disponible · {used} utilisé", "free · {used} used").format(used=runtime["disk_summary"].get("used", "?")),
                runtime["disk_summary"].get("percent", 0) / 100,
                ["seven-files"],
            ),
            "doctor": (
                "Seven Doctor",
                display_readiness_state(str(runtime["doctor"]["decision"])),
                tr("score {score} · {issues} alerte(s)", "score {score} · {issues} alert(s)").format(
                    score=runtime["doctor"].get("score") or "OK",
                    issues=runtime["doctor"]["issues"],
                ),
                None,
                ["seven", "doctor"],
            ),
            "updates": (
                tr("Mises à jour", "Updates"),
                str(runtime["updates"].get("state") or tr("Prêt", "Ready")),
                str(runtime["updates"].get("summary") or tr("Ouvre Paramètres pour vérifier.", "Open Settings to check.")),
                None,
                ["seven-settings", "system"],
            ),
            "prism": ("Prism", profile.title(), tr("Mini OS actif", "Active Mini OS"), None, ["seven-settings", "prism"]),
            "calendar": (
                tr("Calendrier", "Calendar"),
                f"{runtime['calendar']['day']}/{runtime['calendar']['days']}",
                tr("Semaine {week} · {month}", "Week {week} · {month}").format(week=runtime["calendar"]["week"], month=runtime["calendar"]["month"]),
                runtime["calendar"]["fraction"],
                ["seven-settings", "general"],
            ),
            "media": (
                tr("Média", "Media"),
                runtime["media"].get("title", ""),
                f"{runtime['media'].get('state', '')} · {runtime['media'].get('artist', '')}".strip(" ·"),
                None,
                ["playerctl", "play-pause"] if shutil.which("playerctl") else None,
            ),
            "network": (tr("Réseau", "Network"), display_network_state(runtime["network"]), tr("Wi-Fi et connexions", "Wi-Fi and connections"), None, ["seven-wifi"]),
            "weather": (
                tr("Météo", "Weather"),
                runtime["weather"].get("location", ""),
                runtime["weather"].get("summary", ""),
                None,
                ["seven", "widgets", "settings"],
            ),
        }.get(key, (key, "", "", None, None))
        title_label = Gtk.Label(label=f"{widget_icon(key)}  {title}", xalign=0)
        title_label.get_style_context().add_class("widget-kicker")
        value_label = Gtk.Label(label=str(value), xalign=0)
        value_label.get_style_context().add_class("home-value")
        value_label.set_line_wrap(True)
        value_label.set_max_width_chars(20)
        value_label.set_ellipsize(Pango.EllipsizeMode.END)
        note_label = Gtk.Label(label=str(note), xalign=0)
        note_label.get_style_context().add_class("home-note")
        note_label.set_line_wrap(True)
        note_label.set_max_width_chars(32)
        note_label.set_ellipsize(Pango.EllipsizeMode.END)
        card.pack_start(title_label, False, False, 0)
        card.pack_start(value_label, False, False, 0)
        if fraction is not None:
            progress = Gtk.ProgressBar()
            progress.set_fraction(max(0, min(1, float(fraction))))
            card.pack_start(progress, False, False, 0)
        card.pack_start(note_label, False, False, 0)
        if action and self.mode != "desktop":
            button = Gtk.Button(label=tr("Ouvrir", "Open"))
            button.get_style_context().add_class("compact")
            button.connect("clicked", lambda *_a, command=action: subprocess.Popen(command))
            card.pack_start(button, False, False, 0)
        if action and self.mode == "desktop":
            card.get_style_context().add_class("home-widget-clickable")
            card.set_tooltip_text(tr("Cliquer pour ouvrir.", "Click to open."))
            card.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            card.connect("button-press-event", lambda _w, _e, command=action: (subprocess.Popen(command), True)[1])
        if self.mode == "desktop":
            state_class = self.card_state(key, runtime)
            if state_class in {"good", "warn", "danger"}:
                card.get_style_context().add_class(f"home-state-{state_class}")
        return card

    def metric_row(self, label: str, value: int, warn: int, danger: int) -> Gtk.Box:
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        row.get_style_context().add_class("home-metric-row")
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        name = Gtk.Label(label=label, xalign=0)
        name.get_style_context().add_class("home-metric-label")
        number = Gtk.Label(label=f"{value}%", xalign=1)
        number.get_style_context().add_class("home-metric-value")
        header.pack_start(name, True, True, 0)
        header.pack_start(number, False, False, 0)
        progress = Gtk.ProgressBar()
        progress.set_fraction(max(0, min(1, value / 100)))
        state = self.metric_state(value, warn, danger)
        if state in {"warn", "danger"}:
            progress.get_style_context().add_class(state)
        row.pack_start(header, False, False, 0)
        row.pack_start(progress, False, False, 0)
        return row

    def status_row(self, title: str, detail: str, state: str = "normal") -> Gtk.Box:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        row.get_style_context().add_class("home-status-row")
        dot = Gtk.Label(label="")
        dot.get_style_context().add_class("home-status-dot")
        if state in {"warn", "danger"}:
            dot.get_style_context().add_class(state)
        badge_text = {
            "normal": tr("OK", "OK"),
            "good": tr("OK", "OK"),
            "warn": tr("À voir", "Check"),
            "danger": tr("Urgent", "Urgent"),
        }.get(state, tr("OK", "OK"))
        badge = Gtk.Label(label=badge_text, xalign=0.5)
        badge.get_style_context().add_class("home-status-badge")
        if state in {"warn", "danger"}:
            badge.get_style_context().add_class(state)
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        title_label = Gtk.Label(label=title, xalign=0)
        title_label.get_style_context().add_class("home-status-title")
        title_label.set_ellipsize(Pango.EllipsizeMode.END)
        detail_label = Gtk.Label(label=detail, xalign=0)
        detail_label.get_style_context().add_class("home-status-detail")
        detail_label.set_ellipsize(Pango.EllipsizeMode.END)
        labels.pack_start(title_label, False, False, 0)
        labels.pack_start(detail_label, False, False, 0)
        row.pack_start(dot, False, False, 0)
        row.pack_start(labels, True, True, 0)
        row.pack_start(badge, False, False, 0)
        return row

    def system_widget_card(self, payload: dict):
        runtime = payload["runtime"]
        cpu = int(runtime["cpu"])
        memory = int(runtime["memory"])
        pressure = max(cpu, memory)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("widget")
        title_label = Gtk.Label(label=f"{widget_icon('system')}  {tr('Système', 'System')}", xalign=0)
        title_label.get_style_context().add_class("widget-kicker")
        value = Gtk.Label(label=self.pressure_text(pressure, 80, 92), xalign=0)
        value.get_style_context().add_class("home-value")
        value.set_ellipsize(Pango.EllipsizeMode.END)
        detail = Gtk.Label(label=f"CPU {cpu}% · RAM {memory}%", xalign=0)
        detail.get_style_context().add_class("home-note")
        detail.set_ellipsize(Pango.EllipsizeMode.END)
        card.pack_start(title_label, False, False, 0)
        card.pack_start(value, False, False, 0)
        card.pack_start(detail, False, False, 0)
        card.pack_start(
            self.pressure_row(
                [
                    ("CPU", cpu, 80, 92),
                    ("RAM", memory, 80, 92),
                ]
            ),
            False,
            False,
            0,
        )
        if self.mode == "desktop":
            state_class = self.card_state("system", runtime)
            if state_class in {"good", "warn", "danger"}:
                card.get_style_context().add_class(f"home-state-{state_class}")
            card.get_style_context().add_class("home-widget-clickable")
            card.set_tooltip_text(tr("Cliquer pour ouvrir Seven Doctor.", "Click to open Seven Doctor."))
            card.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            card.connect("button-press-event", lambda _w, _e: (subprocess.Popen(["seven", "doctor"]), True)[1])
        return card

    def storage_widget_card(self, payload: dict):
        runtime = payload["runtime"]
        disk = runtime["disk_summary"]
        percent = int(disk.get("percent") or runtime.get("disk") or 0)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("widget")
