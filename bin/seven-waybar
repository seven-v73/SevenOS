#!/usr/bin/env bash

set -Eeuo pipefail

# ============================================================
# SevenOS Waybar Controller
# ============================================================
#
# Runtime owner:
#   systemd
#
# Responsibilities:
#   - lifecycle
#   - runtime validation
#   - diagnostics
#   - context projection
#   - Waybar launch
#
# NOT responsible for:
#   - context decisions
#   - policies
#   - application detection
#   - action execution
#
# ============================================================

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/config.jsonc"
STYLE="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/style.css"

CONTEXT_BIN="$ROOT/bin/seven-waybar-context"
ACTION_BIN="$ROOT/bin/seven-waybar-action"

SERVICE="sevenos-waybar.service"
CONTEXT_SERVICE="sevenos-waybar-context.service"

# ============================================================
# Helpers
# ============================================================

die() {
    echo "seven-waybar: $*" >&2
    exit 1
}

log() {
    printf '[seven-waybar] %s\n' "$*"
}

waybar_count() {
    pgrep -u "$USER" -x waybar 2>/dev/null | wc -l
}

context_count() {
    pgrep -u "$USER" -f 'seven-waybar-context daemon' 2>/dev/null | wc -l
}

service_state() {
    local service="$1"

    systemctl --user is-active "$service" 2>/dev/null ||
        true
}

service_enabled() {
    local service="$1"

    systemctl --user is-enabled "$service" 2>/dev/null ||
        true
}

# ============================================================
# Context
# ============================================================

context() {
    "$CONTEXT_BIN" status
}

context_json() {
    "$CONTEXT_BIN" status
}

# ============================================================
# Start
# ============================================================

start() {

    log "Starting SevenOS Waybar..."

    systemctl --user start "$CONTEXT_SERVICE"
    systemctl --user start "$SERVICE"

    sleep 0.5

    status
}

# ============================================================
# Restart
# ============================================================

restart() {

    log "Restarting SevenOS Waybar..."

    systemctl --user restart "$CONTEXT_SERVICE"
    systemctl --user restart "$SERVICE"

    sleep 0.5

    status
}

# ============================================================
# Stop
# ============================================================

stop() {

    log "Stopping SevenOS Waybar..."

    systemctl --user stop "$SERVICE"
    systemctl --user stop "$CONTEXT_SERVICE"

    echo "SevenOS Waybar stopped."
}

# ============================================================
# Run
# ============================================================
#
# systemd appelle cette commande.
#
# seven-waybar ne fork pas Waybar.
# systemd reste propriétaire du processus.
# ============================================================

run() {

    command -v waybar >/dev/null 2>&1 ||
        die "waybar executable not found"

    [[ -f "$CONFIG" ]] ||
        die "Waybar config not found: $CONFIG"

    [[ -f "$STYLE" ]] ||
        die "Waybar style not found: $STYLE"

    # Ensure context projection exists.
    "$CONTEXT_BIN" once >/dev/null 2>&1 || true

    log "Starting Waybar"
    log "Config : $CONFIG"
    log "Style  : $STYLE"

    exec waybar \
        -c "$CONFIG" \
        -s "$STYLE"
}

# ============================================================
# Status
# ============================================================

status() {

    local wc
    local cc
    local ws
    local cs

    wc="$(waybar_count)"
    cc="$(context_count)"

    ws="$(service_state "$SERVICE")"
    cs="$(service_state "$CONTEXT_SERVICE")"

    echo "SevenOS Waybar: ${wc} instance(s)"
    echo "SevenOS Waybar Context: ${cc} instance(s)"

    "$CONTEXT_BIN" doctor || true

    if (( wc > 0 )); then
        pgrep -u "$USER" -a -x waybar || true
    fi

    echo
    echo "Waybar service : ${ws:-unknown}"
    echo "Context service: ${cs:-unknown}"
}

# ============================================================
# JSON status
# ============================================================

status_json() {

    local wc
    local cc
    local ws
    local cs
    local we
    local ce
    local context

    wc="$(waybar_count)"
    cc="$(context_count)"

    ws="$(service_state "$SERVICE")"
    cs="$(service_state "$CONTEXT_SERVICE")"

    we="$(service_enabled "$SERVICE")"
    ce="$(service_enabled "$CONTEXT_SERVICE")"

    context="$("$CONTEXT_BIN" doctor 2>/dev/null || echo '{}')"

    jq -n \
        --arg root "$ROOT" \
        --arg profile "$(
            jq -r '.context.profile.key // "unknown"' \
                "$(
                    printf '%s\n' "$(
                        "$CONTEXT_BIN" status 2>/dev/null || echo '{}'
                    )"
                )" 2>/dev/null || echo "unknown"
        )" \
        --arg config "$CONFIG" \
        --arg style "$STYLE" \
        --arg ws "$ws" \
        --arg cs "$cs" \
        --arg we "$we" \
        --arg ce "$ce" \
        --argjson wc "$wc" \
        --argjson cc "$cc" \
        --argjson context "$context" \
        '{
            schema: "sevenos.waybar.status.v2",

            state: (
                if $wc == 1
                   and $cc == 1
                   and $ws == "active"
                   and $cs == "active"
                then "OK"
                else "WARN"
                end
            ),

            profile:
                (
                    $context.context.profile.key
                    // "unknown"
                ),

            root: $root,

            runtime: {
                waybar_instances: $wc,
                context_instances: $cc,

                runtime_owner: "systemd",
                controller: "seven-waybar",
                duplicate_process_management: false
            },

            waybar: {
                instances: $wc,
                service: $ws,
                enabled: $we,
                config: $config,
                style: $style
            },

            context: {
                instances: $cc,
                service: $cs,
                enabled: $ce,
                doctor: $context
            },

            contracts: {
                context: "sevenos.waybar.context.v3",
                status: "sevenos.waybar.status.v2"
            },

            repair: "seven-waybar repair"
        }'
}

# ============================================================
# Doctor
# ============================================================

doctor() {

    local wc
    local cc
    local ws
    local cs

    wc="$(waybar_count)"
    cc="$(context_count)"

    ws="$(service_state "$SERVICE")"
    cs="$(service_state "$CONTEXT_SERVICE")"

    local state="OK"

    (( wc == 1 )) || state="WARN"
    (( cc == 1 )) || state="WARN"

    [[ "$ws" == "active" ]] || state="WARN"
    [[ "$cs" == "active" ]] || state="WARN"

    echo "SevenOS Waybar Doctor"
    echo "─────────────────────"
    echo "State: $state"
    echo
    echo "Runtime:"
    echo "  waybar : $wc"
    echo "  context: $cc"
    echo
    echo "Services:"
    echo "  waybar : ${ws:-unknown}"
    echo "  context: ${cs:-unknown}"
    echo
    echo "Architecture:"
    echo "  runtime owner : systemd"
    echo "  context owner : core/context"
    echo "  UI projection : seven-waybar-context"
    echo "  action bridge : seven-waybar-action"
    echo
    echo "Contracts:"
    echo "  context: sevenos.waybar.context.v3"
    echo "  status : sevenos.waybar.status.v2"

    if (( wc != 1 )); then
        echo
        echo "[WARN] Expected exactly one Waybar process."
    fi

    if (( cc != 1 )); then
        echo
        echo "[WARN] Expected exactly one context projection daemon."
    fi

    if [[ "$ws" != "active" ]]; then
        echo
        echo "[WARN] Waybar service is not active."
    fi

    if [[ "$cs" != "active" ]]; then
        echo
        echo "[WARN] Context service is not active."
    fi

    if [[ "$state" == "OK" ]]; then
        echo
        echo "Architecture: HEALTHY"
    else
        echo
        echo "Repair: seven-waybar repair"
    fi
}

# ============================================================
# Repair
# ============================================================

repair() {

    log "Repairing SevenOS Waybar runtime..."

    systemctl --user daemon-reload

    systemctl --user restart "$CONTEXT_SERVICE"
    systemctl --user restart "$SERVICE"

    sleep 0.5

    status
}

# ============================================================
# Limits
# ============================================================

limits() {

    local modules=0

    if [[ -f "$CONFIG" ]]; then
        modules="$(
            jq -r '
                [
                    .["modules-left"][]?,
                    .["modules-center"][]?,
                    .["modules-right"][]?
                ]
                | length
            ' "$CONFIG" 2>/dev/null || echo 0
        )"
    fi

    echo "SevenOS Waybar Limits"
    echo "─────────────────────"
    echo "Modules: $modules"
    echo
    echo "Target architecture:"
    echo "  one context projection"
    echo "  one Waybar process"
    echo "  minimal custom modules"
    echo "  context-driven visibility"
}

# ============================================================
# Performance
# ============================================================

performance() {

    local pid
    pid="$(pgrep -u "$USER" -x waybar | head -n1 || true)"

    echo "SevenOS Waybar Performance"
    echo "──────────────────────────"

    if [[ -z "$pid" ]]; then
        echo "Waybar: not running"
        return 0
    fi

    ps -p "$pid" \
        -o pid=,pcpu=,pmem=,rss=,etime=,cmd=
}

# ============================================================
# Footprint
# ============================================================

footprint() {

    local wc
    local cc

    wc="$(waybar_count)"
    cc="$(context_count)"

    echo "SevenOS Waybar Footprint"
    echo "───────────────────────"
    echo "Waybar processes : $wc"
    echo "Context daemons  : $cc"

    if (( wc == 1 && cc == 1 )); then
        echo "Runtime footprint: HEALTHY"
    else
        echo "Runtime footprint: WARN"
    fi
}

# ============================================================
# Optimize
# ============================================================

optimize() {

    log "Optimizing runtime..."

    # No pkill.
    # No setsid.
    # No duplicate process management.
    #
    # systemd reste le propriétaire du runtime.

    systemctl --user daemon-reload

    "$CONTEXT_BIN" once >/dev/null 2>&1 || true

    systemctl --user restart "$CONTEXT_SERVICE"
    systemctl --user restart "$SERVICE"

    sleep 0.5

    doctor
}

# ============================================================
# Stable / Dynamic
# ============================================================

stable() {

    export SEVENOS_WAYBAR_MODE="stable"

    log "Waybar mode: stable"

    systemctl --user restart "$SERVICE"
}

dynamic() {

    export SEVENOS_WAYBAR_MODE="dynamic"

    log "Waybar mode: dynamic"

    systemctl --user restart "$SERVICE"
}

# ============================================================
# CLI
# ============================================================

case "${1:-status}" in

    run)
        run
        ;;

    status)
        if [[ "${2:-}" == "--json" ]]; then
            status_json
        else
            status
        fi
        ;;

    context)
        context
        ;;

    doctor)
        if [[ "${2:-}" == "--json" ]]; then
            "$CONTEXT_BIN" doctor
        else
            doctor
        fi
        ;;

    limits)
        limits
        ;;

    performance)
        performance
        ;;

    footprint)
        footprint
        ;;

    start)
        start
        ;;

    restart)
        restart
        ;;

    repair)
        repair
        ;;

    optimize)
        optimize
        ;;

    stable)
        stable
        ;;

    dynamic)
        dynamic
        ;;

    stop)
        stop
        ;;

    *)
        cat <<'USAGE'
SevenOS Waybar

Usage:
  seven-waybar run

  seven-waybar status
  seven-waybar status --json
  seven-waybar context
  seven-waybar doctor
  seven-waybar doctor --json

  seven-waybar limits
  seven-waybar performance
  seven-waybar footprint

  seven-waybar start
  seven-waybar restart
  seven-waybar repair
  seven-waybar optimize

  seven-waybar stable
  seven-waybar dynamic
  seven-waybar stop
USAGE
        exit 1
        ;;

esac
