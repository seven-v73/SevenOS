#!/usr/bin/env bash
set -Eeuo pipefail

WORKSPACE_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/sevenos/workspace"
WORKSPACE_STATE_FILE="$WORKSPACE_STATE_DIR/current.json"
SEVENOS_ROOT="${SEVENOS_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
WIDGET_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/sevenos/widgets.json"
HOME_POLICY="${XDG_CONFIG_HOME:-$HOME/.config}/sevenos/workspace-home.env"

workspace_title() {
  case "$1" in
    1) printf 'Accueil' ;;
    2) printf 'Travail' ;;
    3) printf 'Web' ;;
    4) printf 'Create' ;;
    5) printf 'System' ;;
    6) printf 'Comms' ;;
    7) printf 'Lab' ;;
    8) printf 'Deploy' ;;
    9) printf 'Vault' ;;
    special:seven) printf 'Seven Space' ;;
    *) printf 'Workspace %s' "$1" ;;
  esac
}

workspace_icon() {
  case "$1" in
    1) printf '󰈹' ;;
    2) printf '󰅩' ;;
    3) printf '󰖟' ;;
    4) printf '󰏘' ;;
    5) printf '󰒓' ;;
    6) printf '󰍡' ;;
    7) printf '󰙨' ;;
    8) printf '󰓦' ;;
    9) printf '󰌾' ;;
    special:seven) printf '󰐃' ;;
    *) printf '󰧟' ;;
  esac
}

workspace_hint() {
  case "$1" in
    1) printf 'bureau SevenOS, widgets, accueil sans apps' ;;
    2) printf 'applications, fichiers, terminal, travail courant' ;;
    3) printf 'web, recherche, documentation' ;;
    4) printf 'création, design, média, Studio' ;;
    5) printf 'réglages, fichiers, système' ;;
    6) printf 'messages, collaboration, appels' ;;
    7) printf 'lab, sécurité, Shield' ;;
    8) printf 'serveurs, déploiement, Forge DevOps' ;;
    9) printf 'privé, coffre, actions sensibles' ;;
    special:seven) printf 'surface spéciale SevenOS' ;;
    *) printf 'espace personnalisé' ;;
  esac
}

json_escape() {
  if [[ "$#" -gt 0 ]]; then
    python -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
  else
    python -c 'import json,sys; print(json.dumps(sys.stdin.read().rstrip("\n")))'
  fi
}

current_workspace_id() {
  if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl activeworkspace -j 2>/dev/null | python -c 'import json,sys; data=json.load(sys.stdin); print(data.get("name") or data.get("id") or "1")' 2>/dev/null || printf '1'
  else
    printf '1'
  fi
}

json_config_value() {
  local key="$1" fallback="$2"
  if [[ -r "$WIDGET_CONFIG" ]]; then
    python - "$WIDGET_CONFIG" "$key" "$fallback" <<'PY' 2>/dev/null || printf '%s' "$fallback"
import json
import sys
from pathlib import Path

path, key, fallback = sys.argv[1:]
try:
    data = json.loads(Path(path).read_text(encoding="utf-8"))
except Exception:
    data = {}
value = data.get(key, fallback) if isinstance(data, dict) else fallback
if isinstance(value, bool):
    print("1" if value else "0")
else:
    print(value if value not in (None, "") else fallback)
PY
  else
    printf '%s' "$fallback"
  fi
}

home_workspace_id() {
  if [[ -r "$HOME_POLICY" ]]; then
    # shellcheck disable=SC1090
    source "$HOME_POLICY"
  fi
  printf '%s' "${SEVENOS_HOME_WORKSPACE:-$(json_config_value home_workspace 1)}"
}

widgets_visible() {
  [[ "$(json_config_value visible 0)" == "1" ]]
}

close_home_widgets() {
  pkill -f "[s]even-widgets-native desktop" >/dev/null 2>&1 || true
  if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl dispatch closewindow "title:^(Seven Widgets Desktop)$" >/dev/null 2>&1 || true
  fi
}

sync_home_widgets_for_workspace() {
  local id="$1" home
  home="$(home_workspace_id)"
  if [[ "$id" == "$home" ]]; then
    widgets_visible || return 0
    pgrep -f "[s]even-widgets-native desktop" >/dev/null 2>&1 && return 0
    if [[ -x "$SEVENOS_ROOT/bin/seven-widgets-native" ]]; then
      nohup "$SEVENOS_ROOT/bin/seven-widgets-native" desktop >/dev/null 2>&1 &
    fi
  fi
}

write_state() {
  local id="$1"
  mkdir -p "$WORKSPACE_STATE_DIR"
  {
    printf '{'
    printf '"schema":"sevenos.workspace.v1",'
    printf '"id":%s,' "$(json_escape "$id")"
    printf '"title":%s,' "$(workspace_title "$id" | json_escape)"
    printf '"icon":%s,' "$(workspace_icon "$id" | json_escape)"
    printf '"hint":%s' "$(workspace_hint "$id" | json_escape)"
    printf '}\n'
  } > "$WORKSPACE_STATE_FILE"
}

notify_workspace() {
  local id="$1"
  local title icon hint
  title="$(workspace_title "$id")"
  icon="$(workspace_icon "$id")"
  hint="$(workspace_hint "$id")"

  if command -v notify-send >/dev/null 2>&1; then
    notify-send \
      -a "SevenOS Workspace" \
      -h string:x-canonical-private-synchronous:sevenos-workspace \
      -t 900 \
      "$icon  $title" \
      "$hint" >/dev/null 2>&1 || true
  fi
}

experience_workspace() {
  local id="$1"
  local root
  root="$SEVENOS_ROOT"
  if [[ -x "$root/scripts/shell-experience.sh" ]]; then
    "$root/scripts/shell-experience.sh" workspace "$id" >/dev/null 2>&1 || true
  fi
}

dispatch_workspace() {
  local target="$1"
  if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl dispatch workspace "$target" >/dev/null 2>&1 || true
    sleep 0.05
  fi
  local id
  id="$(current_workspace_id)"
  write_state "$id"
  sync_home_widgets_for_workspace "$id"
  notify_workspace "$id"
  experience_workspace "$id"
}

status_json() {
  local id
  id="$(current_workspace_id)"
  write_state "$id"
  cat "$WORKSPACE_STATE_FILE"
}

case "${1:-status}" in
  switch)
    [[ -n "${2:-}" ]] || { printf 'Usage: seven-workspace switch <id>\n' >&2; exit 2; }
    dispatch_workspace "$2"
    ;;
  next)
    dispatch_workspace "r+1"
    ;;
  prev)
    dispatch_workspace "r-1"
    ;;
  json|status-json)
    status_json
    ;;
  status)
    id="$(current_workspace_id)"
    printf '%s · %s\n' "$(workspace_title "$id")" "$(workspace_hint "$id")"
    ;;
  *)
    printf 'Usage: seven-workspace [status|json|switch <id>|next|prev]\n' >&2
    exit 2
    ;;
esac
