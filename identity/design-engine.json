{
  "schema": "sevenos.design-engine.v1",
  "engine": "Seven Design Engine",
  "base": "SevenOS Prism Mineral palettes, with optional third-party icon compatibility and stable Papirus fallback.",
  "principle": "One central design contract synchronizes icons, palettes, surfaces, Prism Flow and profile facets without making SevenOS depend on borrowed desktop identity.",
  "modes": {
    "seven-mocha": {
      "label": "Prism Dark",
      "system_mode": "dark",
      "description": "Mineral dark mode: precise surfaces, Prism Blue, Signal Gold, Atlas Teal and restrained depth.",
      "palette": {
        "base": "#070A10",
        "mantle": "#111722",
        "crust": "#05070B",
        "surface0": "#182131",
        "surface1": "#253145",
        "surface2": "#334258",
        "text": "#EDEDED",
        "subtext0": "#A9B7C7",
        "subtext1": "#B9C0CC",
        "prism_blue": "#4C8DFF",
        "signal_gold": "#D6A84F",
        "atlas_teal": "#33B6C4",
        "baobab_green": "#2FB87A",
        "forge_ember": "#FF7A4D",
        "shield_mint": "#4DE6A8",
        "studio_iris": "#8D6CFF",
        "pulse_coral": "#FF5C7A",
        "seven_blue": "#4C8DFF",
        "seven_violet": "#8D6CFF",
        "seven_cyan": "#33B6C4"
      },
      "icon_candidates": [
        "Catppuccin-Mocha",
        "Catppuccin-Mocha-Dark",
        "Catppuccin-Mocha-Blue",
        "Papirus-Dark",
        "Papirus",
        "Tela-circle-dark",
        "Tela-circle",
        "hicolor"
      ]
    },
    "seven-latte": {
      "label": "Prism Light",
      "system_mode": "light",
      "description": "Clear productivity mode: mineral white surfaces, precise borders, Prism Blue and restrained Signal Gold.",
      "palette": {
        "base": "#EFF1F5",
        "mantle": "#E6E9EF",
        "crust": "#DCE0E8",
        "surface0": "#CCD0DA",
        "surface1": "#BCC0CC",
        "surface2": "#ACB0BE",
        "text": "#4C4F69",
        "subtext0": "#6C6F85",
        "subtext1": "#5C5F77",
        "blue": "#1E66F5",
        "mauve": "#8839EF",
        "sky": "#04A5E5",
        "teal": "#179299",
        "green": "#40A02B",
        "red": "#D20F39",
        "peach": "#FE640B",
        "prism_blue": "#2F7BFF",
        "signal_gold": "#B8892E",
        "atlas_teal": "#178A96",
        "baobab_green": "#2A8C61",
        "seven_blue": "#2F7BFF",
        "seven_violet": "#6A5CFF",
        "seven_cyan": "#00B8D9"
      },
      "icon_candidates": [
        "Catppuccin-Latte",
        "Catppuccin-Latte-Light",
        "Catppuccin-Latte-Blue",
        "Papirus",
        "Tela-circle",
        "hicolor"
      ]
    }
  },
  "icon_strategy": {
    "style": "outline-friendly, faceted, prism-aware icons with SevenOS app marks layered on top",
    "rule": "Prefer SevenOS app marks and stable Papirus/Papirus-Dark fallback; use third-party themes only as optional compatibility.",
    "native_manifest": "identity/icons/manifest.json",
    "custom_apps": [
      "Seven Files",
      "Seven AI",
      "Seven Settings",
      "Seven Spotlight",
      "Seven Store",
      "Seven Studio",
      "Seven Security"
    ]
  },
  "folder_roles": {
    "ai": { "label": "AI", "accent": "#CBA6F7", "symbol": "spark" },
    "dev": { "label": "Dev", "accent": "#89B4FA", "symbol": "code" },
    "security": { "label": "Security", "accent": "#F38BA8", "symbol": "shield" },
    "media": { "label": "Media", "accent": "#FAB387", "symbol": "play" },
    "studio": { "label": "Studio", "accent": "#8B7CFF", "symbol": "diamond" },
    "cloud": { "label": "Cloud", "accent": "#89DCEB", "symbol": "cloud" }
  },
  "profile_themes": {
    "contract": "identity/profile-themes.json",
    "catalog": "profiles/catalog.json",
    "rule": "Equinox keeps the neutral SevenOS shell. Specialized profiles get distinct Prism Flow facet accents and context indicators without loading unrelated tools."
  },
  "motion": {
    "contract": "scripts/shell-experience.sh",
    "compositor": "scripts/motion.sh",
    "grammar": "seven-motion-system",
    "curves": ["sevenMotion", "sevenMotionOpen", "sevenMotionExit", "sevenMotionWorkspace", "sevenMotionLayer"],
    "durations_ms": {
      "press": 120,
      "hover": 160,
      "open": 260,
      "close": 180,
      "workspace": 320
    },
    "rule": "Native apps, dock, launchpad, Spotlight, notifications and workspace changes should use the same SevenOS motion and feedback contract."
  },
  "surfaces": [
    "Waybar",
    "Seven Spotlight",
    "Seven Hub",
    "Seven Dock",
    "Seven Files",
    "Seven Settings",
    "Notifications",
    "Hyprlock",
    "Terminal",
    "Seven AI"
  ]
}
