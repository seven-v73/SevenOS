#!/usr/bin/env bash
set -Eeuo pipefail

export SEVENOS_ROOT="${SEVENOS_ROOT:-/opt/SevenOS}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sevenos"
started_marker="$state_dir/live-first-screen-started"
ready_marker="$state_dir/live-installer-opened"
log_file="${XDG_CACHE_HOME:-$HOME/.cache}/sevenos/live-ready.log"
calamares_log_file="${XDG_CACHE_HOME:-$HOME/.cache}/sevenos/calamares-live.log"
status_file="$state_dir/live-status.json"
lock_dir="$state_dir/live-ready.lock"
session_started_at="$(date +%s)"
session_id="$(python - <<'PY' 2>/dev/null || printf 'live-session'
import uuid

print(uuid.uuid4().hex[:12])
PY
)"

mkdir -p "$state_dir" "$(dirname "$log_file")"

if [[ -e "$ready_marker" ]]; then
  exit 0
fi

if [[ -d "$lock_dir" ]]; then
  lock_age="$(python - "$lock_dir" <<'PY' 2>/dev/null || printf 0
import os
import sys
import time

try:
    print(int(time.time() - os.stat(sys.argv[1]).st_mtime))
except OSError:
    print(0)
PY
)"
  if [[ "$lock_age" =~ ^[0-9]+$ && "$lock_age" -gt 45 ]]; then
    rmdir "$lock_dir" 2>/dev/null || true
  fi
fi

if ! mkdir "$lock_dir" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

live_notify() {
  local title="$1"
  local body="${2:-}"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "SevenOS Live" -i seven-installer "$title" "$body" >/dev/null 2>&1 || true
  fi
}

write_state() {
  local state="$1"
  local step="$2"
  local detail="${3:-}"
  local pid="${4:-}"
  local progress="${5:-0}"
  local hint="${6:-}"
  STATE="$state" STEP="$step" DETAIL="$detail" LOG_FILE="$log_file" PID="$pid" PROGRESS="$progress" HINT="$hint" SESSION_STARTED_AT="$session_started_at" SESSION_ID="$session_id" python - <<'PY' >"$status_file.tmp"
import json
import os
import time

now = int(time.time())
try:
    started_at = int(os.environ.get("SESSION_STARTED_AT", "") or now)
except ValueError:
    started_at = now

payload = {
    "schema": "sevenos.live-ready.v1",
    "session_id": os.environ.get("SESSION_ID", ""),
    "state": os.environ.get("STATE", "unknown"),
    "step": os.environ.get("STEP", ""),
    "detail": os.environ.get("DETAIL", ""),
    "hint": os.environ.get("HINT", ""),
    "progress": max(0, min(100, int(os.environ.get("PROGRESS", "0") or 0))),
    "log_file": os.environ.get("LOG_FILE", ""),
    "started_at": started_at,
    "updated_at": now,
    "elapsed_seconds": max(0, now - started_at),
}
pid = os.environ.get("PID", "")
if pid:
    payload["pid"] = int(pid) if pid.isdigit() else pid
print(json.dumps(payload, ensure_ascii=False, indent=2))
PY
  mv "$status_file.tmp" "$status_file"
}

live_lang() {
  case "${LANGUAGE:-${LC_MESSAGES:-${LANG:-}}}" in
    fr*|*:fr*) printf fr ;;
    *) printf en ;;
  esac
}

live_text() {
  local fr="$1"
  local en="$2"
  if [[ "$(live_lang)" == "fr" ]]; then
    printf '%s' "$fr"
  else
    printf '%s' "$en"
  fi
}

wait_for_hyprland() {
  local _i
  for _i in $(seq 1 30); do
    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v hyprctl >/dev/null 2>&1 && hyprctl monitors >/dev/null 2>&1; then
      return 0
    fi
    if (( _i % 5 == 0 )); then
      write_state "starting" "graphical-session" "Waiting for Hyprland and Wayland." "" "$((10 + (_i / 5) * 2))" "SevenOS is still preparing the graphical session."
    fi
    sleep 0.4
  done
  return 1
}

open_sevenos_portal() {
  if command -v seven-installer >/dev/null 2>&1; then
    printf '[sevenos-live-ready] opening SevenOS installer portal\n' >&2
    seven-installer gui >>"$log_file" 2>&1 &
    printf '%s' "$!"
    return 0
  fi
  return 1
}

open_calamares_direct() {
  if command -v seven-installer >/dev/null 2>&1; then
    printf '[sevenos-live-ready] opening Calamares fallback directly\n' >&2
    SEVENOS_LIVE_SESSION=1 seven-installer open >>"$calamares_log_file" 2>&1 &
    printf '%s' "$!"
    return 0
  fi
  if command -v calamares >/dev/null 2>&1; then
    printf '[sevenos-live-ready] opening raw Calamares fallback\n' >&2
    calamares -d >>"$calamares_log_file" 2>&1 &
    printf '%s' "$!"
    return 0
  fi
  return 1
}

open_network_choice() {
  if command -v seven-installer >/dev/null 2>&1; then
    printf '[sevenos-live-ready] opening network choice\n' >&2
    seven-installer network >>"$log_file" 2>&1 &
    printf '%s' "$!"
    return 0
  fi
  return 1
}

process_alive() {
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1
}

installer_window_visible() {
  if ! command -v hyprctl >/dev/null 2>&1; then
    return 1
  fi
  hyprctl clients -j 2>/dev/null | python -c '
import json
import re
import sys

try:
    clients = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)

class_re = re.compile(r"^(SevenOSInstallerNative|Calamares|calamares)$")
title_re = re.compile(r"^(SevenOS Installer|Install SevenOS|Installer SevenOS).*$")
for client in clients:
    klass = str(client.get("class") or "")
    title = str(client.get("title") or "")
    if class_re.search(klass) or title_re.search(title):
        raise SystemExit(0)
raise SystemExit(1)
' 2>/dev/null
}

network_connected() {
  command -v nmcli >/dev/null 2>&1 || return 1
  local state connectivity
  state="$(nmcli -t -f STATE general 2>/dev/null | head -n 1 || true)"
  connectivity="$(nmcli -t -f CONNECTIVITY general 2>/dev/null | head -n 1 || true)"
  [[ "$state" == "connected" || "$connectivity" == "full" ]]
}

arrange_installer_window() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  local selector
  for selector in \
    'class:^(SevenOSInstallerNative)$' \
    'class:^(Calamares)$' \
    'class:^(calamares)$' \
    'title:^(SevenOS Installer|Install SevenOS|Installer SevenOS)(.*)$'
  do
    if hyprctl dispatch focuswindow "$selector" >/dev/null 2>&1; then
      hyprctl dispatch resizeactive exact 980 660 >/dev/null 2>&1 || true
      hyprctl dispatch centerwindow >/dev/null 2>&1 || true
      return 0
    fi
  done
  return 0
}

confirm_installer_window() {
  local pid="$1"
  local label="${2:-installer}"
  local _i
  for _i in $(seq 1 90); do
    if installer_window_visible; then
      arrange_installer_window
      touch "$ready_marker"
      write_state "ready" "installer" "$label is interactive." "$pid" 100
      return 0
    fi
    if [[ "$_i" -gt 12 ]] && ! process_alive "$pid"; then
      write_state "closed" "installer" "$label closed before it became interactive. See $calamares_log_file." "$pid" 100
      return 1
    fi
    progress=$((82 + (_i / 6)))
    [[ "$progress" -gt 98 ]] && progress=98
    write_state "opening" "installer" "Waiting for the graphical installer to become interactive." "$pid" "$progress" "SevenOS is letting the installer stabilize on this machine."
    sleep 0.5
  done
  write_state "closed" "installer" "$label did not expose a window in time. See $calamares_log_file." "$pid" 100
  return 1
}

{
  touch "$started_marker"
  write_state "starting" "graphical-session" "Waiting for Hyprland and Wayland." "" 10
  printf '[sevenos-live-ready] waiting for graphical session\n'
  live_notify \
    "$(live_text "Préparation de SevenOS" "Preparing SevenOS")" \
    "$(live_text "La session graphique se stabilise avant l’installation." "The graphical session is settling before installation.")"
  if wait_for_hyprland; then
    write_state "starting" "environment" "Graphical session is ready." "" 24
  else
    write_state "degraded" "environment" "Hyprland readiness timed out." "" 24
    printf '[sevenos-live-ready] warning: Hyprland readiness timed out\n'
  fi

  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    write_state "starting" "dbus" "Importing SevenOS live environment." "" 36
    dbus-update-activation-environment --systemd \
      SEVENOS_ROOT SEVENOS_LIVE_SESSION WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
      LANG LANGUAGE LC_MESSAGES >/dev/null 2>&1 || true
  fi

  if command -v systemctl >/dev/null 2>&1; then
    write_state "starting" "services" "Starting SevenOS user services." "" 48
    systemctl --user import-environment \
      SEVENOS_ROOT SEVENOS_LIVE_SESSION WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
      LANG LANGUAGE LC_MESSAGES >/dev/null 2>&1 || true
    systemctl --user start sevenos-session.target >/dev/null 2>&1 || true
  fi

  if command -v xdg-user-dirs-update >/dev/null 2>&1; then
    write_state "starting" "user-folders" "Preparing user folders." "" 58
    xdg-user-dirs-update >/dev/null 2>&1 || true
  fi

  if command -v nmcli >/dev/null 2>&1; then
    write_state "starting" "network" "Enabling networking and Wi-Fi." "" 68
    live_notify \
      "$(live_text "Réseau SevenOS" "SevenOS Network")" \
      "$(live_text "Activation du Wi-Fi et des connexions disponibles." "Enabling Wi-Fi and available connections.")"
    nmcli networking on >/dev/null 2>&1 || true
    nmcli radio wifi on >/dev/null 2>&1 || true
  fi

  if ! network_connected; then
    write_state "attention" "network" "Network is not connected; opening SevenOS network choice before installation." "" 72 "Connect Wi-Fi now, or continue offline from the SevenOS installer portal."
    live_notify \
      "$(live_text "Connexion recommandée" "Connection recommended")" \
      "$(live_text "Choisis un réseau Wi‑Fi avant l’installation, ou continue hors ligne depuis le portail." "Choose Wi-Fi before installing, or continue offline from the portal.")"
    open_network_choice >/dev/null 2>&1 || true
    for _ in $(seq 1 30); do
      network_connected && break
      sleep 0.5
    done
    if ! network_connected; then
      write_state "attention" "installer" "Opening SevenOS installer portal so Wi-Fi, offline install, disks and logs stay available." "" 86 "Use Wi-Fi first, or choose Install offline from the SevenOS portal."
      live_notify \
        "$(live_text "Portail SevenOS" "SevenOS Portal")" \
        "$(live_text "Le portail reste ouvert pour choisir le Wi‑Fi ou continuer hors ligne." "The portal stays open to choose Wi-Fi or continue offline.")"
      portal_pid=""
      if portal_pid="$(open_sevenos_portal)"; then
        confirm_installer_window "$portal_pid" "SevenOS installer portal" && exit 0
      fi
      write_state "closed" "installer" "SevenOS installer portal closed before it became interactive." "$portal_pid" 100
      exit 1
    fi
  fi

  if [[ -x "$SEVENOS_ROOT/scripts/theme-session.sh" ]]; then
    write_state "starting" "theme" "Synchronizing SevenOS theme session." "" 78
    SEVENOS_ROOT="$SEVENOS_ROOT" "$SEVENOS_ROOT/scripts/theme-session.sh" sync >/dev/null 2>&1 || true
  fi

  if command -v seven-welcome >/dev/null 2>&1; then
    write_state "starting" "welcome" "Showing SevenOS welcome notification." "" 86
    seven-welcome --notify >/dev/null 2>&1 || true
  fi

  write_state "opening" "installer" "Opening Calamares directly for a stable graphical installation." "" 94
  live_notify \
    "$(live_text "Installation SevenOS" "SevenOS Installation")" \
    "$(live_text "Ouverture de l’installateur graphique SevenOS." "Opening the SevenOS graphical installer.")"
  installer_pid=""
  if installer_pid="$(open_calamares_direct)"; then
    if confirm_installer_window "$installer_pid" "Calamares installer"; then
      exit 0
    fi
    write_state "opening" "installer" "Calamares did not stabilize; trying the SevenOS portal fallback." "" 96 "SevenOS is opening its installer portal because the direct installer did not stay visible."
    live_notify \
      "$(live_text "Relance installateur" "Installer fallback")" \
      "$(live_text "L’installateur direct n’est pas resté visible. SevenOS ouvre le portail de secours." "The direct installer did not stay visible. SevenOS is opening the rescue portal.")"
    fallback_pid=""
    if fallback_pid="$(open_sevenos_portal)"; then
      if confirm_installer_window "$fallback_pid" "SevenOS installer portal"; then
        exit 0
      fi
    fi
    live_notify \
      "$(live_text "Installateur fermé" "Installer closed")" \
      "$(live_text "L’installateur s’est fermé trop vite. Ouvre le terminal secours avec Super+Shift+Entrée et lance seven-installer live-status." "The installer closed too quickly. Open rescue terminal with Super+Shift+Return and run seven-installer live-status.")"
    exit 1
  else
    printf '[sevenos-live-ready] no graphical installer command found\n'
    write_state "error" "installer" "No graphical installer command found." "" 0
    live_notify \
      "$(live_text "Installateur indisponible" "Installer unavailable")" \
      "$(live_text "Ouvre SevenOS Terminal et lance seven installer release pour le diagnostic." "Open SevenOS Terminal and run seven installer release for diagnostics.")"
    rm -f "$started_marker"
    exit 1
  fi
} >>"$log_file" 2>&1
