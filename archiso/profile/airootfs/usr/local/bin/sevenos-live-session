#!/usr/bin/env bash
set -Eeuo pipefail

export SEVENOS_ROOT="${SEVENOS_ROOT:-/opt/SevenOS}"
export SEVENOS_LIVE_SESSION=1
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-SevenOS}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-SevenOS-Installer}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export TERMINAL="${TERMINAL:-seven-terminal}"
export SEVENOS_TERMINAL="${SEVENOS_TERMINAL:-seven-terminal}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"

read_language_value() {
  local key="$1"
  local file="${XDG_CONFIG_HOME:-$HOME/.config}/sevenos/language.env"
  [[ -r "$file" ]] || return 0
  awk -F= -v wanted="$key" '
    $1 == wanted {
      value = $2
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      gsub(/^["'"'"']|["'"'"']$/, "", value)
      print value
      exit
    }
  ' "$file" 2>/dev/null || true
}

locale_available() {
  local wanted="$1"
  local normalized
  [[ -n "$wanted" ]] || return 1
  normalized="$(printf '%s' "$wanted" | tr '[:upper:]' '[:lower:]' | sed 's/utf-8/utf8/g')"
  locale -a 2>/dev/null | tr '[:upper:]' '[:lower:]' | sed 's/utf-8/utf8/g' | grep -Fxq "$normalized"
}

if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/sevenos/language.env" ]]; then
  requested_language="$(read_language_value SEVENOS_LANGUAGE)"
  requested_lang="$(read_language_value LANG)"
  requested_lc_messages="$(read_language_value LC_MESSAGES)"
  requested_language_name="$(read_language_value LANGUAGE)"
  preferred_locale="${requested_language:-${requested_lang:-en_US.UTF-8}}"
  if locale_available "$preferred_locale"; then
    export SEVENOS_LANGUAGE="$preferred_locale"
    export LANG="$preferred_locale"
    export LC_MESSAGES="${requested_lc_messages:-$preferred_locale}"
    export LANGUAGE="${requested_language_name:-${preferred_locale%%_*}}"
  else
    export SEVENOS_LANGUAGE=C.UTF-8
    export LANG=C.UTF-8
    export LC_MESSAGES=C.UTF-8
    export LANGUAGE=en
  fi
fi

if [[ "${SEVENOS_LIVE_SESSION_LOCALE_PROBE:-0}" == "1" ]]; then
  printf 'SEVENOS_LANGUAGE=%s\nLANG=%s\nLC_MESSAGES=%s\nLANGUAGE=%s\n' \
    "${SEVENOS_LANGUAGE:-}" "${LANG:-}" "${LC_MESSAGES:-}" "${LANGUAGE:-}"
  exit 0
fi

log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/sevenos"
log_file="$log_dir/live-session.log"
mkdir -p "$log_dir"

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd \
    SEVENOS_ROOT SEVENOS_LIVE_SESSION XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
    LANG LANGUAGE LC_MESSAGES TERMINAL SEVENOS_TERMINAL >/dev/null 2>&1 || true
fi

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=SevenOS

printf '[sevenos-live-session] starting SevenOS graphical live desktop\n' >>"$log_file"
if command -v Hyprland >/dev/null 2>&1; then
  if [[ -r /etc/sevenos/live-hyprland.conf ]]; then
    Hyprland -c /etc/sevenos/live-hyprland.conf >>"$log_file" 2>&1 && exit 0
  fi
  Hyprland >>"$log_file" 2>&1 && exit 0
  status=$?
  printf '[sevenos-live-session] Hyprland exited with status %s\n' "$status" >>"$log_file"
else
  printf '[sevenos-live-session] Hyprland command not found\n' >>"$log_file"
fi

printf '[sevenos-live-session] starting safe graphical installer fallback\n' >>"$log_file"
export XDG_CURRENT_DESKTOP=SevenOS
export XDG_SESSION_DESKTOP=SevenOS-Safe
if command -v cage >/dev/null 2>&1 && command -v seven-installer >/dev/null 2>&1; then
  exec cage -s -- seven-installer gui
fi

printf '\nSevenOS Live could not start the graphical session.\n' >&2
printf 'Open another TTY and inspect: journalctl -b -u sevenos-live-session.service\n' >&2
printf 'Live log: %s\n' "$log_file" >&2
sleep infinity
