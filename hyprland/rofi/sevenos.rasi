@import "sevenos-palette.rasi";

window {
  width: 58%;
  border: 1px;
  border-color: @glass-border-2;
  border-radius: 24px;
  background-color: @surface-1;
}

mainbox {
  padding: 20px;
  spacing: 14px;
  background-color: transparent;
  children: [ message, listview ];
}

message {
  padding: 12px 14px;
  border: 1px;
  border-color: @glass-border;
  border-radius: 18px;
  background-color: @glass;
}

textbox {
  text-color: @indigo-bright;
  font: "SF Pro Text Medium 12";
}

prompt {
  text-color: @indigo-bright;
  font: "SF Pro Text Medium 13";
}

textbox-prompt-colon {
  text-color: @text-3;
}

listview {
  lines: 10;
  fixed-height: true;
  margin: 3px 0 0 0;
  spacing: 7px;
  background-color: transparent;
}

element {
  padding: 12px 13px;
  border: 1px;
  border-color: @glass-border;
  border-radius: 14px;
  background-color: @glass;
  text-color: @text-1;
}

element selected {
  background-color: @glass-3;
  text-color: @text-1;
  border-color: @indigo-bright;
}

element alternate {
  background-color: @surface-2;
  text-color: @text-1;
}

element-text,
element-icon {
  text-color: inherit;
  background-color: transparent;
}

element-text {
  font: "SF Pro Text 13";
}

element-icon {
  size: 22px;
  margin: 0 12px 0 0;
}
