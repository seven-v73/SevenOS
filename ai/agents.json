{
  "schema": "sevenos.ai-agent-registry.v1",
  "policy": {
    "local_first": true,
    "cloud_default": "disabled",
    "execution_default": "preview",
    "ledger": "required",
    "confirmation_required_for": [
      "system.write",
      "packages.install",
      "packages.remove",
      "services.restart",
      "network.change",
      "profile.switch",
      "files.delete",
      "security.change",
      "external.web",
      "llm.cloud",
      "personal.index",
      "personal.snippet"
    ]
  },
  "interaction_contracts": {
    "schema": "sevenos.ai-interaction-contracts.v1",
    "default_surface": "spotlight-chat",
    "response_card": {
      "schema": "sevenos.ai.response-card.v1",
      "purpose": "Stable UI contract for conversational answers, action previews and quick actions.",
      "required_fields": [
        "title",
        "answer",
        "state",
        "safety",
        "controls"
      ],
      "optional_fields": [
        "bullets",
        "quick_actions",
        "render"
      ]
    },
    "decision_stack": {
      "schema": "sevenos.ai.decision-stack.v1",
      "purpose": "Ranked next-action contract for Spotlight, widgets and Settings.",
      "ranking_order": [
        "active mission continuation",
        "real system risks: services, storage, network, memory",
        "local memory and context",
        "optional local model setup",
        "user preferences and personalization"
      ],
      "ui_expectation": "Show one primary action, two alternatives and the reason for each action.",
      "explain_command": "seven ai \"pourquoi cette action\" --json",
      "safety": "Medium and high risk actions must remain preview/confirmation first."
    },
    "local_context": {
      "default_scope": "metadata",
      "content_scope": "opt-in",
      "ranking": "name-title-snippet-recency",
      "answer_mode": "compact conversational summary with quick actions",
      "allowed": [
        "system.state",
        "apps.registry",
        "window.context",
        "local.index.metadata",
        "habits.summary",
        "mission.state"
      ],
      "requires_confirmation": [
        "local.index.content",
        "document.snippet",
        "personal.fulltext.search",
        "web.search",
        "cloud.llm"
      ],
      "denied_by_default": [
        "credentials.read",
        "private.keys.read",
        "browser.passwords.read",
        "unapproved.fulltext.export"
      ]
    },
    "local_memory": {
      "schema": "sevenos.ai-local-memory-contract.v1",
      "index_default": "metadata-only",
      "content_index": "short-snippets-only-after-user-confirmation",
      "profile_command": "seven ai \"ce que tu sais de moi\" --json",
      "search_contract": "seven ai learning search <query> --json",
      "scan_contract": "seven ai learning scan --json",
      "snippet_contract": "seven ai learning scan --content --json",
      "control_commands": [
        "seven ai preferences --json",
        "seven ai \"audit mémoire SevenAI\" --json",
        "seven ai \"plan mémoire SevenAI\" --json",
        "seven ai \"historique mémoire SevenAI\" --json",
        "seven ai \"analyse ta mémoire\" --json",
        "seven ai \"briefing mémoire\" --json",
        "seven ai learning audit --json",
        "seven ai learning history --json",
        "seven ai learning insights --json",
        "seven ai learning briefing --json",
        "seven ai learning sources --json",
        "seven ai \"montre tes sources\" --json",
        "seven ai \"ajoute documents à ta mémoire\" --apply --json",
        "seven ai \"retire downloads de ta mémoire\" --apply --json",
        "seven ai \"état apprentissage local\" --json",
        "seven ai \"active ton apprentissage\" --apply --json",
        "seven ai \"scanne mes documents\" --apply --json",
        "seven ai \"scanne avec extraits\" --apply --json",
        "seven ai \"efface les extraits locaux\" --apply --json",
        "seven ai \"efface ton index local\" --apply --json",
        "seven ai learning disable --json",
        "seven ai \"désactive ton apprentissage\" --apply --json",
        "seven ai preferences clear --json"
      ],
      "ranking": [
        "exact filename and title matches",
        "snippet matches when content mode is enabled",
        "document-friendly extensions",
        "recently modified files"
      ],
      "ui_expectation": "Spotlight must show a short answer, top matches and safe open/scan actions instead of raw JSON.",
      "privacy": [
        "no cloud calls",
        "no browser passwords",
        "no private keys",
        "no full-text export by default"
      ]
    },
    "execution": {
      "safe_read": "automatic",
      "app_open": "automatic",
      "system_write": "preview_then_confirm",
      "destructive": "blocked_by_default",
      "audit": "ledger_required"
    },
    "ui_controls": {
      "submit": "Enter",
      "newline": "Shift+Enter",
      "close": "Esc",
      "clear": "Ctrl+Backspace",
      "confirm_action": "Ctrl+Enter"
    },
    "surfaces": [
      "Spotlight",
      "Settings",
      "Doctor",
      "Seven Files",
      "Seven Store",
      "Experience Center",
      "Workspace Widgets"
    ]
  },
  "agents": [
    {
      "id": "equinox.system",
      "name": "Equinox System Steward",
      "profile": "equinox",
      "mission": "Coordinate SevenOS state, settings, updates, repair and recovery without opaque automation.",
      "state": "ready",
      "risk": "medium",
      "permissions": [
        "system.read",
        "settings.preview",
        "doctor.read",
        "personal.habits.read",
        "personal.index.preview",
        "updates.preview",
        "ledger.write"
      ],
      "requires_confirmation": [
        "system.write",
        "packages.install",
        "services.restart",
        "profile.switch",
        "personal.index",
        "personal.snippet",
        "theme.apply"
      ],
      "denied_by_default": [
        "files.delete",
        "credentials.read",
        "personal.fulltext.export",
        "external.web",
        "llm.cloud"
      ],
      "capabilities": [
        "system-health",
        "settings",
        "updates",
        "repair",
        "profile-routing",
        "first-run",
        "local-memory"
      ],
      "handoff_triggers": [
        "settings",
        "réglages",
        "paramètres",
        "system status",
        "état système",
        "update",
        "mise à jour",
        "repair",
        "réparer",
        "machine slow",
        "sevenos"
      ],
      "context_signals": [
        "active_profile:equinox",
        "app:seven-settings",
        "app:seven-doctor",
        "app:seven-spotlight",
        "issue:health",
        "issue:update"
      ],
      "surfaces": [
        "Spotlight",
        "Settings",
        "Doctor",
        "Experience Center"
      ],
      "status_command": "seven ai brain --json",
      "tools": [
        "seven health --json",
        "seven doctor --json",
        "seven update check",
        "seven first-run verify --json"
      ]
    },
